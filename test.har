            "mimeType": "text/html",
            "text": "<div id=\"orderBasket\">\r\n\t<div dojoType=\"dijit.form.Form\" id=\"orderBasketForm\"\r\n\t\tjsId=\"orderBasketForm\" name=\"orderBasketForm\" action=\"order\"\r\n\t\tencType=\"multipart/form-data\" method=\"post\" onSubmit=\"return false;\">\r\n\t\t<input type=\"hidden\" id=\"orderBasketaction\" name=\"action\" value=\"submitBasket\" />\r\n\t\t<input type=\"hidden\" id=\"orderBasketformat\" name=\"format\" value=\"json\" />\r\n\t\t<input type=\"hidden\" id=\"submitingBasketList\" name=\"submitingBasketList\" value=\"\" />\r\n\t\t<div class=\"functionBar\">\r\n\t\t\t<table width=\"800\" border=\"0\">\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td width=\"40\"><span atLangID=\"javascriptOrderBasket\">Basket</span></td>\r\n\t\t\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t\t\t<td width=\"90\">\r\n\t\t\t\t\t\t\t\t<select id=\"orderBasketddl\" name=\"orderBasketddl\" dojoType=\"dijit.form.Select\" style=\"width:90px;\" ></select>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td colspan=\"16\">\r\n\t\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" name =\"newBaskt\" id=\"btnNewBaskt\"  atLangID=\"javascriptNewBasktBtn\">\r\n\t\t\t\t\t\t\t\tNew</button>\r\n\t\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" name =\"dltBaskt\" id=\"btnDltBaskt\"  atLangID=\"javascriptDltBasktBtn\">\r\n\t\t\t\t\t\t\t\tDelete</button>\r\n\t\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" name =\"RenameBaskt\" id=\"btnRenameBaskt\"  atLangID=\"javascriptRenameBasktBtn\">\r\n\t\t\t\t\t\t\t\tRename</button>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td colspan=\"19\"></td>\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td width=\"40\"><span atLangID=\"javascriptOrdrBasketCdsAccnt\">CDS Account</span></td>\r\n\t\t\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t\t\t<td width=\"90\" colspan=\"5\">\r\n\t\t\t\t\t\t\t\t<select id=\"cdsAccntddl\" name=\"cdsAccntddl\" dojoType=\"dijit.form.ComboBox\" trim=\"true\" autoComplete=\"false\" style=\"width:250px;\" >\r\n\t\t\t\t\t\t\t\t\t<option value=\"ALL\">ALL</option>\r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td width=\"15\"></td>\r\n\t\t\t\t\t\t\t<td width=\"45\"><span atLangID=\"javascriptOrdrBasketSecurity\">Security</span></td>\r\n\t\t\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t\t\t<td width=\"90\" colspan=\"5\">\r\n\t\t\t\t\t\t\t\t<select id=\"securityddl\" name=\"securityddl\" dojoType=\"dijit.form.ComboBox\" trim=\"true\" autoComplete=\"false\" style=\"width:230px;\" >\r\n\t\t\t\t\t\t\t\t\t<option value=\"ALL\">ALL</option>\r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td width=\"15\"></td>\r\n\t\t\t\t\t\t\t<td width=\"45\"><span atLangID=\"javascriptBuyOrderBoard\">Board</span></td>\r\n\t\t\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t\t\t<td width=\"90\" >\t\t \t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t<select id=\"boardddl\" name=\"boardddl\" dojoType=\"dijit.form.Select\" trim=\"true\" autoComplete=\"false\" style=\"width:90px !important;\" >\r\n\t\t\t\t\t\t\t\t\t<option value=\"ALL\">ALL</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"REGULER\">REGULAR</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"CROSSING\">CROSSING</option>\r\n\t\t\t\t\t\t\t\t</select>  \r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td width=\"40\"><span atLangID=\"javascriptOrdrBasketTif\">TIF</span></td>\r\n\t\t\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t\t\t<td width=\"90\">\r\n\t\t\t\t\t\t\t\t<select id=\"tifddl\" name=\"tifddl\" dojoType=\"dijit.form.Select\" style=\"width:70px;\" >\r\n\t\t\t\t\t\t\t\t\t<option value=\"ALL\">ALL</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"DAY\">DAY</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"GTD\">GTD</option> \r\n\t\t\t\t\t\t\t\t\t<option value=\"GTC\">GTC</option> \r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td width=\"8\"></td>\r\n\t\t\t\t\t\t\t<td width=\"15\"><span atLangID=\"javascriptOrdrBasketSide\">Side</span></td>\r\n\t\t\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t\t\t<td width=\"70\">\r\n\t\t\t\t\t\t\t\t<select id=\"sideddl\" name=\"sideddl\" dojoType=\"dijit.form.Select\" style=\"width:70px;\" >\r\n\t\t\t\t\t\t\t\t\t<option value=\"1\">BUY</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"2\">SELL</option>        \r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td width=\"30\"></td>\r\n\t\t\t\t\t\t\t<td width=\"35\"><span atLangID=\"javascriptOrdrBasketQty\">Quantity</span></td>\r\n\t\t\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t\t\t<td width=\"90\">\r\n\t\t\t\t\t\t\t\t<input id =\"ordQty\" name=\"ordQty\" dojoType=\"dijit.form.NumberSpinner\" style=\"width:70px\" smallDelta=\"1\" constraints=\"{min:0,places:0}\" />\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td width=\"28\"></td>\r\n\t\t\t\t\t\t\t<td width=\"25\"><span atLangID=\"javascriptOrdrBasketPrice\">Price</span></td>\r\n\t\t\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t\t\t<td width=\"90\">\r\n\t\t\t\t\t\t\t\t<input id =\"ordBasketPrice\" name=\"ordBasketPrice\" dojoType=\"dijit.form.NumberSpinner\" style=\"width:70px\"  smallDelta=\"0.10\" constraints=\"{min:0.00,}\" />\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td width=\"15\"></td>\r\n\t\t\t\t\t\t\t<td colspan=\"4\" align=\"right\">\r\n\t\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" name =\"ordBasktClear\" id=\"ordBasktClear\"  atLangID=\"javascriptBasktClearBtn\">\r\n\t\t\t\t\t\t\t\tClear</button>\r\n\t\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" name =\"ordBasktSearch\" id=\"ordBasktSearch\"  atLangID=\"javascriptBasktSearchBtn\">\r\n\t\t\t\t\t\t\t\tSearch</button>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<!-- <td width=\"40\"></td>  -->\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t</table>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"popupBody\">\r\n\t\t\t\t\t<div class=\"gridBg\">\r\n\t\t\t\t\t\t<div id=\"orderBasketDataGrid\" style=\"width:790px;height:290px\" dojoType=\"dijit.layout.ContentPane\">      \r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"popFooter\">\r\n\t\t\t\t<table style=\"width: 99%;\" >\r\n\t\t\t\t\t<tr align=\"right\">\r\n\t\t\t\t\t<td  >&nbsp;</td>\r\n\t\t\t\t\t\t\t\t\t\t<td align=\"right\"><input id=\"uploadFile\" placeholder=\"Choose File\" disabled=\"disabled\" /></td>\r\n\t\t\t\t\t\t\t\t\t\t<td align=\"right\"><div class=\"fileUpload btn btn-primary\">\r\n    \t\t\t\t\t\t\t\t\t<span>Select an Excel File</span>\r\n    \t\t\t\t\t\t\t\t\t\t<input type=\"file\" class=\"dojoxFileInput\" name=\"file\" id=\"ordBasktfile\" />\r\n\t\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t<td   align=\"right\">\r\n\t\t\t\t\t\t<button type=\"button\" name=\"upload\" dojoType=\"dijit.form.Button\" id=\"ordBasktbtnUpload\" >Upload</button>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td   align=\"right\">\r\n\t\t\t\t\t\t<button id=\"ordBasktbtnSaveToExcel\" name=\"submit\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t\t>Export</button>\r\n\t\t\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td   align=\"right\">\r\n\t\t\t\t\t\t<button id=\"ordBasktbtnTemplate\" name=\"btnRemove\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderSubmit\">Template</button>\r\n\t\t\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td   align=\"right\">\r\n\t\t\t\t\t\t\t<button  dojoType=\"dijit.form.Button\" name =\"close\" id=\"btnorderBasketSubmit\"  atLangID=\"javascriptOrderBasketSubmitBtn\">\r\n\t\t\t\t\t\t\tSubmit</button>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td   align=\"right\">\r\n\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" name =\"amend\" id=\"btnorderBasketAmend\"  atLangID=\"javascriptOrderBasketAmendBtn\">\r\n\t\t\t\t\t\t\tAmend</button>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td   align=\"right\">\r\n\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" name =\"remove\" id=\"btnorderBasketRemove\"  atLangID=\"javascriptOrderBasketRemoveBtn\">\r\n\t\t\t\t\t\t\tRemove</butto