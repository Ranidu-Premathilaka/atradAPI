            "size": 4142,
            "mimeType": "text/html",
            "text": "<div id=\"addSec\">\r\n\t<div class=\"functionBar\">\r\n\t<div class=\"filter\">\r\n\t\t<div class=\"addsectext inline\" style=\"width: 63px;\">Type</div>\r\n\t\t<div class=\"blueText inline\" width=\"10px\">:</div>\r\n\t\t<div  id=\"radioGroup\">\r\n\t\t<div id=\"_atrad_equityDiv\" >\r\n\t\t\t<div class=\"inline\">\r\n\t\t\t\t<input data-dojo-type=\"dijit.form.RadioButton\" id=\"rdoAll\" name=\"secGroup\"\r\n\t\t\t\t\t value=\"All\" type=\"radio\" /> <label id=\"lblAll\"\r\n\t\t\t\t\tclass=\"blueText\">All</label>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"inline\">\r\n\t\t\t\t<input data-dojo-type=\"dijit.form.RadioButton\" id=\"rdoN\" name=\"secGroup\"\r\n\t\t\t\t\tchecked=\"checked\" value=\"N\" type=\"radio\" /> <label id=\"lblN\" class=\"blueText\">N</label>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"inline\">\r\n\t\t\t\t<input data-dojo-type=\"dijit.form.RadioButton\" id=\"rdoX\" name=\"secGroup\"\r\n\t\t\t\t\tvalue=\"X\" type=\"radio\" /> <label id=\"lblX\" class=\"blueText\">X</label>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"inline\">\r\n\t\t\t\t<input data-dojo-type=\"dijit.form.RadioButton\" id=\"rdoP\" name=\"secGroup\"\r\n\t\t\t\t\tvalue=\"P\" type=\"radio\" /> <label id=\"lblP\" class=\"blueText\">P</label>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"inline\">\r\n\t\t\t\t<input data-dojo-type=\"dijit.form.RadioButton\" id=\"rdoU\" name=\"secGroup\"\r\n\t\t\t\t\tvalue=\"U\" type=\"radio\" /> <label id=\"lblU\" class=\"blueText\">U</label>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"inline\">\r\n\t\t\t\t<input data-dojo-type=\"dijit.form.RadioButton\" id=\"rdoR\" name=\"secGroup\"\r\n\t\t\t\t\tvalue=\"R\" type=\"radio\" /> <label id=\"lblR\" class=\"blueText\">R</label>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"inline\">\r\n\t\t\t\t<input data-dojo-type=\"dijit.form.RadioButton\" id=\"rdoW\" name=\"secGroup\"\r\n\t\t\t\t\tvalue=\"W\" type=\"radio\" /> <label id=\"lblW\" class=\"blueText\">W</label>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"inline\">\r\n\t\t\t\t<inpu