            "size": 2793,
            "mimeType": "text/html",
            "text": "<div id=\"tradeSummary\">\r\n <div class=\"functionBar\">\r\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" >\r\n<!--    <tr>\r\n      <td colspan=\"3\" align=\"left\"><table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n        <tr>\r\n          <td width=\"250\" align=\"left\" id=\"_atrad_lblcompName\" ><strong> </strong></td>\r\n          <td align=\"left\" width=\"20\">&nbsp;</td>\r\n          <td width=\"50\" align=\"left\"  >Board :</td>\r\n          <td width=\"55\" align=\"left\" id=\"_atrad_lblbordId\" >\r\n          \t<select id=\"_atrad_cmbBordId\" name=\"cmbBordId\" dojoType=\"dijit.form.Select\" autoComplete=\"false\" type=\"text\" style=\"width:80px; \">\r\n          \t\t<option value=\"1\">REGULAR</option>\r\n          \t\t<option value=\"4\">CROSSING</option>\r\n          \t\t<option value=\"5\">AON</option> \r\n          \t\t<option value=\"6\">TOM</option>\r\n          \t</select>\r\n          </td>\r\n        </tr>\r\n      </table></td>\r\n      </tr>  --> \r\n    <tr>\r\n      <td height=\"5\" colspan=\"3\" align=\"left\"></td>\r\n      </tr>\r\n    <tr>\r\n      <td height=\"2\" colspan=\"3\" align=\"left\" class=\"tradeBookImg\" repeat-x\"></td>\r\n      </tr>\r\n    <tr >\r\n    <td  colspan=\"3\" align=\"left\" id=\"_atrad_searchtrdbk\" ></td>\r\n    </tr>\r\n    </table>\r\n  </div> \r\n  <div class=\"clear\"></div>\r\n  <div class=\"popupBody\">\r\n<div style=\"float:left; height:auto;  padding-left:2px\">\r\n  <table  border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"390\">\r\n  <tr>\r\n<!--   <td  width=\"68\" align=\"left\" id=\"_atrad_lblLstTradePrice\" atLangID=\"javascriptTradePrice\" class=\"fontBold\">Last Trade Price</td>-->\r\n<!--          <td  align=\"left\" >:</td>-->\r\n          <td  align=\"left\" id=\"_atrad_lblLstTrd\" ><strong></strong></td>\r\n        \r\n    <td width=\"5\">&nbsp;</td>\r\n      <td  align=\"left\">\r\n       <td  width=\"90\" align=\"left\" id=\"_atrad_lblTotTrades\" atLangID=\"javascriptTotTrades\" class=\"fontBold\">Total Trades</td>\r\n          <td  align=\"left\" >:</td>\r\n          <td align=\"left\" id=\"_atrad_txtTotTrds\"></td>\r\n          <td width=\"5\"></td>\r\n          <td  width=\"60\" align=\"left\" id=\"_atrad_lblTotVol\" atLangID=\"javascriptTradeBookTotVol\" class=\"fontBold\">Total Vol</td>\r\n          <td  align=\"right\" >:</td>\r\n          <td align=\"right\" id=\"_atrad_lblTotVolume\" ></td>\r\n          \r\n          <td align=\"right\" id=\"_atrad_trdbookRefreshCursor\" class=\"tradeBookRefreshCursor\">&nbsp;</td>\r\n         <td align=\"right\"><button data-dojo-type=\"dijit.form.Button\"  id=\"_atrad_butRefreshBut\">Refresh</button></td>\r\n      \r\n    </tr>\r\n    \r\n   </table>\r\n    \r\n</div>\r\n<div class=\"clear\"></div>\r\n<div class=\"gridBg\" >\r\n  <div id=\"_atrad_grdDataGrid\" dojoType=\"dijit.layout.ContentPane\"></div>\r\n</div>\r\n<div class=\"popFooter\"><button data-dojo-type=\"dijit.form.Button\" id=\"_atrad_btntrbClose\" >Close</button></div>\r\n</div>\r\n<div class=\"clear\"></div>\r\n</div>\t\r\n\r\n\r\n"
