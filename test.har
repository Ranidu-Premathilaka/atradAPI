            "text": "<!------------------------------------------------------------------------------->\r\n<div id=\"stat\">\r\n  <div class=\"functionBar\">\r\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n    <tr>\r\n      <td width=\"70\" height=\"20\" align=\"left\" valign=\"middle\" id=\"_atrad_searchStat\"></td>\r\n      </tr>\r\n  </table>\r\n</div>\r\n<div class=\"popupBody\">\r\n\r\n<div style=\"float:left; width:810px; height:25px; padding-bottom:3px\" >\r\n  <table border=\"0\" align=\"left\" cellpadding=\"0\" cellspacing=\"0\" width=\"200px\">\r\n    <tr>\r\n      <td width=\"100px\" height=\"25\" align=\"left\" valign=\"middle\" id=\"_atrad_lbl_sec\" atLangID=\"javascriptStatisticSecurity\" >Security </td>\r\n      <td width=\"10px\" align=\"left\" valign=\"middle\">:</td>\r\n      <td width=\"250px\" align=\"left\" valign=\"middle\" id=\"_atrad_lbl_secName\" ></td>\r\n      <td width=\"20px\" align=\"left\" valign=\"middle\" >&nbsp;</td>\r\n    </tr>\r\n  </table>\r\n  <table border=\"0\" align=\"left\" cellpadding=\"0\" cellspacing=\"0\" width=\"600px\">\r\n    <tr>\r\n      <td width=\"100px\" height=\"25\" align=\"left\" valign=\"middle\" id=\"_atrad_lbl_comp\" atLangID=\"javascriptStatisticCompany\" >Company </td>\r\n      <td width=\"10px\" align=\"left\" valign=\"middle\">:</td>\r\n      <td width=\"270px\" align=\"left\" valign=\"middle\" id=\"_atrad_lbl_compName\"></td>\r\n      <td align=\"right\"> <button data-dojo-type=\"dijit.form.Button\" id=\"_atrad_btnRefresh\">Refresh</button></td>\r\n    </tr>\r\n  </table>\r\n</div>\r\n<div class=\"clear\"></div>\r\n<div dojoType=\"dijit.layout.TabContainer\" style=\"width:100%;height:350px;\">\r\n\t<div dojoType=\"dijit.layout.ContentPane\" title=\"Statistics\" selected=\"true\" style=\"width:100%;\" class=\"statTab\">\r\n\t\t<table width=\"795\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n\t\t  <tr >\r\n\t\t\t<td width=\"250\" valign=\"top\">\r\n\t\t\t    <div id=\"_atrad_statDataGridToday\" style=\"height: 280px;>\r\n\t\t\t    </div>\r\n\t\t\t</td>\r\n\t\t\t<td width=\"10\" rowspan=\"3\"></td>\r\n\t\t\t<td width=\"540\" valign=\"top\"><div class=\"gridBg\" id=\"_atrad_gridstat\" style=\"height: 310px; min-width: 500px\">\r\n\t\t\t\t\t\r\n\t\t\t</div></td>\r\n\t\t    <!--<td width=\"10\" rowspan=\"3\"></td>\r\n\t\t    <td width=\"260\" valign=\"top\"><div id=\"_atrad_statDataGridAllTime\">\t\r\n\t\t    </div></td>-->\r\n\t\t  </tr>\r\n\t\t <!-- <tr>\r\n\t\t    <td height=\"10\"></td>\r\n\t\t    <td height=\"10\"></td>\r\n\t\t    <td height=\"10\"></td>\r\n\t\t  </tr>\r\n\t\t  <tr>\r\n\t\t    <td valign=\"top\"><div id=\"_atrad_statDataGridWeek\" >\t\t\r\n\t\t    </div></td>\r\n\t\t    <td valign=\"top\"><div id=\"_atrad_statDataGridMonth\" >\r\n\t\t   </div></td>\r\n\t\t    <td valign=\"top\"><div id=\"_atrad_statDataGridYear\" >\r\n\t\t    </div></td>\r\n\t\t  </tr>-->\r\n\t\t</table>\r\n\t</div>\r\n\t<div dojoType=\"dijit.layout.ContentPane\" title=\"More\" class=\"statTab\">\r\n\t\t<table width=\"795\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"240px\"> <div id=\"_atrad_statDataGridWeek\" style=\"height: 140px;\">\r\n\t\t\t    </div></td>\r\n\t\t\t\t<td width=\"240px\"><div id=\"_atrad_statDataGridMonth\" style=\"height: 140px;\">\r\n\t\t\t    </div></td>\r\n\t\t\t\t<td width=\"240px\"> <div id=\"_atrad_statDataGridYear\" style=\"height: 140px;\">\r\n\t\t\t    </div> </td>\r\n\t\t\t\t<td id=\"_atrad_wtdhigh\"> </td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"4\" height=\"10px\"> </td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"240px\">\r\n\t\t\t\t\t<div id=\"_atrad_statDataGrid52week\" style=\"height: 140px;\">\r\n\t\t\t    \t</div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"240px\"><div id=\"_atrad_statDataGridAllTime\" style=\"height: 140px;\">\r\n\t\t\t    </div></td>\r\n\t\t\t\t<td width=\"240px\"> <div id=\"_atrad_statDataGridOther\" style=\"heigh