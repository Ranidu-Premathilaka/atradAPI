            "mimeType": "text/html",
            "text": "<div id=\"bulkStatus\" class=\"bulkStatusOrderEntryWindow\">\t\r\n\t\t<div dojoType=\"dijit.form.Form\" id=\"_atrad_orderForm\" name=\"orderForm\"\r\n\t\t\taction=\"order\" jsId=\"_atrad_orderForm\" encType=\"multipart/form-data\">\r\n\t\t\t<input type=\"hidden\" id=\"removingBulkList\" name=\"removingBulkList\" value=\"\" />\r\n\t\t\t\t <input type=\"hidden\" id=\"savingBulkList\" name=\"savingBulkList\" value=\"\" />\r\n\t\t\t\t \r\n\t\t\t\t<input\r\n\t\t\t\ttype=\"hidden\" id=\"_atrad_odrplacedate\" name=\"orderplacedate\"\r\n\t\t\t\tvalue=\"\" />\r\n\t\t\t\r\n\t\t\t<div class=\"functionBar\">\r\n\t\t\t\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblExchange\"\r\n\t\t\t\t\t\t\t>Exchange</td>\r\n\t\t\t\t\t\t<td align=\"left\" width=\"5\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\"><select id=\"_atrad_cmbExchangeSelect\"\r\n\t\t\t\t\t\t\tname=\"exchangeSelect\" dojoType=\"dijit.form.Select\" type=\"text\"\r\n\t\t\t\t\t\t class=\"BS_ISO\" style=\"width: 40px !important\" >\r\n\t\t\t\t\t\t\t\t<option value=\"1\">CSE</option>\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<td align=\"left\">\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblExchange\"\r\n\t\t\t\t\t\t\t>Status</td>\r\n\t\t\t\t\t\t<td align=\"left\" width=\"10\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\" colspan=\"5\"><select id=\"_atrad_cmbStatusSelect\"\r\n\t\t\t\t\t\t\tname=\"statusSelect\" dojoType=\"dijit.form.Select\" type=\"text\"\r\n\t\t\t\t\t\t class=\"BS_ISO\" style=\"width: 170px;\" >\r\n\t\t\t\t\t\t <option value=\"ALL\">ALL</option>\r\n\t\t\t\t\t\t\t\t<option value=\"PENDING\">PENDING</option>\r\n\t\t\t\t\t\t\t\t<option value=\"APROVAL PENDING\">SEND TO ADVISOR</option>\r\n\t\t\t\t\t\t\t\t<option value=\"APPROVED\">SEND TO CSE</option>\r\n\t\t\t\t\t\t\t\t<option value=\"REJECTED\">REJECT</option>\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<td align=\"left\">\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblSecurity\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderSecurityId\"></td>\r\n\t\t\t\t\t\t<td width=\"10\" align=\"left\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\"><input id=\"_atrad_txtSecurity\"\r\n\t\t\t\t\t\t\tname=\"txtSecurity\" dojoType=\"dijit.form.ComboBox\" trim=\"true\"\r\n\t\t\t\t\t\t\trequired=\"true\" invalidMessage=\"Invalid security code.\"\r\n\t\t\t\t\t\t\tclass=\"BS_ISO\" uppercase=\"true\" autoComplete=\"false\" style=\"width: 70px !important\" ></input> <!-- <input type=\"text\" id =\"_atrad_txtSecurity\" name=\"txtSecurity\" uppercase=\"true\"  \r\n      \tdojoType=\"dijit.form.ValidationTextBox\" trim=\"true\" regExp=\"\\b[A-Z]{3,4}\\.[NXPURWBD][0-9A-Z]{4}\" \r\n       \trequired=\"true\" invalidMessage=\"Invalid security code. Format xxx.xxxxx or xxxx.xxxxx\"  style=\"width:180px;\"></td> -->\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblClientAcc\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderClientAccoutnt\"></td>\r\n\t\t\t\t\t\t<td align=\"left\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\" colspan=\"4\"><select id=\"_atrad_cmbClientAcc\"\r\n\t\t\t\t\t\t\tname=\"clientAcc\" dojoType=\"dijit.form.ComboBox\"\r\n\t\t\t\t\t\t\tautoComplete=\"false\" style=\"width: 170px\">\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"center\" ></td>\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t<td><button id=\"_atrad_btnGo\" name=\"go\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderClose\">Refresh</button>\r\n\t\t\t\t\t\t\t\t\t\t</td>\t\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t<td><div dojoType=\"dijit.form.Button\" id=\"savebulkOrder\"></div></td>\t\t\t\t\t\t\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</table>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"popupBody\">\r\n\t\t\t<div id=\"bulkStatusDatagrid\" dojoType=\"dijit.layout.ContentPane\"\tclass=\"bulkApproveGridContainer\">\r\n\t\t\t</div>\r\n\t</div>\r\n\t<div class=\"popFooter\">\r\n\t\t\t\t\t\t\t<div style=\"float:right\"><button id=\"_atrad_btnClose\" name=\"close\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderClose\">Close</button></div>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t</div>\r\n\t\t</div>\t\t\t\r\n\t<div style=\"clear:both\"></div>\r\n\r\n</div>\r\n"
