            "size": 4082,
            "mimeType": "text/html",
            "text": "\r\n  <div id = \"_atrad_securitySearch\" class=\"secSearch\">\r\n  <div id=\"_atrad_securitySearchRadiobuttonName\" class=\"securitySearchRadiobuttonName inline \" >Board : </div> \r\n    <div id=\"_atrad_securitySearchRadiobuttonName\" class=\"securitySearchRadiobutton\" > \r\n\r\n  \t\t<select id=\"_atrad_cmbBoard\" name=\"cmbBoard\" dojoType=\"dijit.form.Select\" autoComplete=\"false\" type=\"text\" style=\"width:60px; \">\r\n\t       \t<option value=\"1\">REGULAR</option>\r\n\t       \t<option value=\"4\">CROSSING</option>\r\n    \t<option value=\"5\">AON</option> \r\n\t     \t<option value=\"6\" disabled=\"disabled\">TOM</option>\r\n\t     \t<option value=\"7\" >AUCTION</option>\r\n\t     </select>    \r\n<!--  <div  class=\"boardSearchSelectName\">Board :</div>\r\n  <div id=\"_atrad_securityBoard\"  class=\"boardSearchSelectbox\">\r\n\t<select id=\"_atrad_cmbBoard\" name=\"cmbBoard\" dojoType=\"dijit.form.Select\" autoComplete=\"false\" type=\"text\" style=\"width:60px; \">\r\n       \t<option value=\"1\">REGULAR</option>\r\n       \t<option value=\"4\">CROSSING</option>\r\n        <option value=\"6\">TOM</option>\r\n     </select> \r\n  </div>  --> \r\n \r\n  <div  class=\"securitySearchSelectName\" >Asset : </div>\r\n  <div id=\"_atrad_securityAssert\"  class=\"securitySearchSelectbox\">\r\n \t<select id=\"_atrad_cmbAssert\" name=\"cmbAssert\" dojoType=\"dijit.form.Select\" autoComplete=\"false\" type=\"text\" style=\"width:60px; \">\r\n        <option value=\"EQUITY\">EQUITY</option>\r\n        <option value=\"DEBT\">DEBT</option>\r\n     </select> \r\n  </div> \r\n</div>\r\n  \r\n  <div id=\"_atrad_securitySearchType\" class=\"securitySearchType inline\" >Type </div>    \r\n  <div id=\"_atrad_securitySearchCheckbox\" class=\"securitySearchCheckbox\" >\r\n\t  <div id=\"_atrad_equityDiv\" >\r\n\t\t  <input id=\"_atrad_AllSecuritiesId\" dojotype=\"dijit.form.CheckBox\" name=\"all\" checked=\"checked\"   value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\"> ALL </label>   \r\n\t\t  \r\n\t\t  <input id=\"_atrad_NormalSecuritiesId\" dojotype=\"dijit.form.CheckBox\" name=\"n\" value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\">N </label>\r\n\t\t  \r\n\t\t  <input id=\"_atrad_nonVotingId\" dojotype=\"dijit.form.CheckBox\" name=\"x\"   value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\"> X  </label>\r\n\t\t  \t\r\n\t\t  <input id=\"_atrad_preferenceId\" dojotype=\"dijit.form.CheckBox\" name=\"P\"   value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\"> P  </label>\t\r\n\t\t  \r\n\t\t  <input id=\"_atrad_unitTrust\" dojotype=\"dijit.form.CheckBox\" name=\"u\"   value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\"> U  </label>\t\r\n\t\t  \r\n\t\t   <input id=\"_atrad_rights\" dojotype=\"dijit.form.CheckBox\" name=\"R\"   value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\"> R  </label>\t  \t\t\r\n\t\t  \r\n\t\t  <input id=\"_atrad_warrant\" dojotype=\"dijit.form.CheckBox\" name=\"w\"   value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\"> W  </label>\t\r\n\t\t  \r\n\t\t  <input id=\"_atrad_bonus\" dojotype=\"dijit.form.CheckBox\" name=\"B\"   value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\"> B  </label>\t\r\n\t\t  \r\n\t\t   <input id=\"_atrad_debentures\" dojotype=\"dijit.form.CheckBox\" name=\"d\"   value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\"> D  </label>\r\n\t \r\n\t  </div>\r\n\t  <div id=\"_atrad_debtDiv\" style=\"display: none;\">  \r\n\t\t  <input id=\"_atrad_AllSecuritiesDebtId\" dojotype=\"dijit.form.CheckBox\" name=\"all\" checked=\"checked\"  value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\"> ALL </label>   \r\n\t\t  \r\n\t\t  <input id=\"_atrad_BillSecuritiesId\" dojotype=\"dijit.form.CheckBox\" name=\"bill\"  value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\">Bill </label>\r\n\t\t  \r\n\t\t  <input id=\"_atrad_BondSecuritiesId\" dojotype=\"dijit.form.CheckBox\" name=\"bond\"   value=\"on\" type=\"checkbox\" />\r\n\t\t  <label for=\"cb\">Bond  </label> \r\n\t  </div>\r\n  </div> \r\n  \r\n   \r\n  \r\n <div id=\"_atrad_securitySearchComboboxName\" class=\"securitySearchComboboxName inline\" >\r\n   Search  \r\n </div>  \r\n <div id=\"_atrad_securitySearchCombobox\" class=\"securitySearchCombobox\" >\r\n \t<input id=\"_atrad_Combobox_state\"> \r\n \r\n </div>\r\n\r\n <!-- <div id=\"_atrad_securitySearchButton\"  class=\"securitySearchButton\" >     \r\n<button dojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t     class=\"\" name =\"close\" id=\"_atrad_searchBtn\">&nbsp;OK&nbsp;</button>\r\n </div> -->\r\n </div> \r\n  "
