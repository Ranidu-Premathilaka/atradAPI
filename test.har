            "mimeType": "text/html",
            "text": "<div id=\"manageAlerts\" class =\"manageAlerts\">\r\n\t<div class =\"functionBar\">\r\n\t\t<table>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width='50%'>\r\n\t\t\t\t\t<button type=\"button\" dojoType=\"dijit.form.Button\" id=\"btnAddAlertPrice\">Set Price Alert</button>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width='50%'>\r\n\t\t\t\t\t<button type=\"button\" dojoType=\"dijit.form.Button\" id=\"btnAddAlertNews\">Set News Alert</button>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t\r\n\t</div>\r\n\t<div class=\"popupBody\">\r\n\t\t<div dojoType=\"dijit.layout.TabContainer\" style=\"width:100%;height:320px;\">\r\n\t\t\t<div dojoType=\"dijit.layout.ContentPane\" title=\"PRICE\" selected=\"true\" style=\"width:100%;\" class=\"statTab\" id=\"manAlertPriceTab\" >\r\n\t\t\t\t<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" class=\"bluetext\" width=\"100%\" style=\"padding: 2px;\">\r\n\t\t\t\t \t<tr>\r\n\t\t\t\t \t\t<td colspan=\"7\" height=\"7px\"></td>\r\n\t\t\t\t \t</tr>\r\n\t\t\t\t \t<tr>\r\n\t\t\t\t \t\t<td width=\"65px\" height=\"22\" align=\"left\" valign=\"middle\">Alert Name</td>\r\n\t\t\t\t \t\t<td width=\"5px\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t \t\t<td width=\"120\"><input id=\"manAlertNamePrice\" name=\"manAlertNamePrice\" dojoType=\"dijit.form.ValidationTextBox\" ></td>\r\n\t\t\t\t \t\t<td width=\"15px\"></td>\r\n\t\t\t\t \t\t<td align=\"left\" valign=\"middle\" class=\"boldText\">Security</td>\r\n\t\t\t      \t\t<td width=\"5px\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t      \t\t<td valign=\"middle\"><input type=\"text\" name=\"manAlertsecurityListPrice\" value=\"\"  trim=\"true\" id=\"manAlertsecurityListPrice\" propercase=\"true\" style=\"width:300px\"></td>\r\n\t\t\t\t \t\t<td width=\"250px\"></td>\r\n\t\t\t\t \t\t<td>\r\n\t\t\t\t \t\t\t<button type =\"button\" dojoType=\"dijit.form.Button\" id=\"manAlertSearchPrice\">Search</button>\r\n\t\t\t\t \t\t\t<button type =\"button\" dojoType=\"dijit.form.Button\" id=\"manAlertClearPrice\">Clear</button>\r\n\t\t\t\t \t\t</td>\r\n\t\t\t\t \t</tr>\r\n\t\t\t\t \t<tr>\r\n\t\t\t\t \t\t<td colspan=\"7\" height=\"7px\"></td>\r\n\t\t\t\t \t</tr>\r\n\t\t\t\t</table>\r\n\t\t\t\t<div id = \"manAlertPriceGrid\" dojoType = \"dijit.layout.ContentPane\" class = \"alertGridContainer\"></div>\r\n\t\t\t</div>\r\n\t\t\t<div dojoType=\"dijit.layout.ContentPane\" title=\"NEWS\" selected=\"true\" style=\"width:100%;\" class=\"statTab\"  id=\"manAlertNewsTab\">\r\n\t\t\t\t<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" class=\"bluetext\" width=\"100%\" style=\"padding: 2px;\">\r\n\t\t\t\t \t<tr>\r\n\t\t\t\t \t\t<td colspan=\"7\" height=\"7px\"></td>\r\n\t\t\t\t \t</tr>\r\n\t\t\t\t \t<tr>\r\n\t\t\t\t \t\t<td width=\"65px\" height=\"22\" align=\"left\" valign=\"middle\">Alert Name</td>\r\n\t\t\t\t \t\t<td width=\"5px\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t \t\t<td width=\"120\"><input id=\"manAlertNameNews\" name=\"manAlertNameNews\" dojoType=\"dijit.form.ValidationTextBox\" ></td>\r\n\t\t\t\t \t\t<td width=\"15px\"></td>\r\n\t\t\t\t \t\t<td align=\"left\" valign=\"middle\" class=\"boldText\">Security</td>\r\n\t\t\t      \t\t<td width=\"5px\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t      \t\t<td valign=\"middle\"><input type=\"text\" name=\"manAlertsecurityListNews\" value=\"\"  trim=\"true\" id=\"manAlertsecurityListNews\" propercase=\"true\" style=\"width:300px\"></td>\r\n\t\t\t\t \t<td align=\"center\">\r\n\t\t\t\t \t\t\t<button type =\"button\" dojoType=\"dijit.form.Button\" id=\"manAlertSearchNews\">Search</button>\r\n\t\t\t\t \t\t\t<button type =\"button\" dojoType=\"dijit.form.Button\" id=\"manAlertClearNews\">Clear</button>\r\n\t\t\t\t \t\t</td>\r\n\t\t\t\t \t</tr>\r\n\t\t\t\t \t<tr>\r\n\t\t\t\t \t\t<td colspan=\"7\" height=\"7px\"></td>\r\n\t\t\t\t \t</tr>\r\n\t\t\t\t </table>\r\n\t\t\t\t <div >\r\n\t\t\t\t\t<div id = \"manAlertNewsGrid\" dojoType = \"dijit.layout.ContentPane\" class = \"alertGridContainer\"></div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n\t<div class = \"popFooter\">\r\n\t\t\r\n\t\t\t\t\t<button type =\"button\" data-dojo-type=\"dijit.form.Button\" id=\"butCloseManAlert\" >Close</button>\r\n\t\t\t\t\r\n\t</div>\r\n</div>"
