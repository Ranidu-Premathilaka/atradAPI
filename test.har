            "mimeType": "text/html",
            "text": "<div id=\"quickview\" >\r\n\t<div class=\"functionBar\">\r\n\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\r\n\t<tr>\r\n\t <td width=\"45\" align=\"left\" valign=\"middle\"><div id=\"lbstockHoldingSecurity\" atLangID=\"javascriptStatisticSecurity\">Security</div></td>\r\n\t    \t\t  <td width=\"5\" align=\"left\" valign=\"middle\">:</td>\r\n\t     \t\t  <td width=\"200\" align=\"left\" valign=\"middle\">\r\n\t\t     \t\t  <select id=\"_atrad_quickviewSecurity\" name=\"quickviewSecurity\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" style=\"width:230px; \" >           \t\t\r\n\t\t       \t\t  </select>\r\n\t<td style=\"width: 51%;\" ><button data-dojo-type=\"dijit.form.Button\" id=\"_atrad_butRefreshBut\" >Refresh</button></td>\r\n\t<td style=\"width: 10%;\" ><span id=\"lbCashmap\" >Buy Sentiment</span></td>\r\n\t<td style=\"width: 9%;\" ><div id=\"cashMapId\" ></div>\r\n\t  <!--  <div style='background: linear-gradient(to right, green 10%, red 0%);height:12px;width:90%;text-align: center'>10</div>-->\r\n\t</td>\r\n\t<td style=\"width: 5%;\"><span id=\"quickViewRefreshCursor\"></span></td>\r\n\t\r\n\t</tr>\r\n\t</table>\r\n      </div>\r\n\t<div class=\"popupBody\">\r\n\t<div id=\"_atrad_quickViewDatagrid\" dojoType=\"dijit.layout.ContentPane\"\t>\r\n\t<table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n\t\t\t<tr><td colspan=\"3\">Trade Watch</td></tr>\r\n\t\t\t<tr>\r\n\t\t\t<td colspan=\"3\">\r\n\t\t\t<div class=\"quickWatchgridBg\" id=\"_atrad_quickWatch\">\r\n\t\t\t</div>\r\n\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td > \r\n\t\t\t\t\r\n\t\t\t\t<div style=\"float:left; height:15px; padding-top:5px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n  <tr>\r\n   <td width=\"100%\" align=\"left\" id= _atrad_lblTotBid>Trade Book</td>\r\n  </tr>\r\n</table>\r\n</div>\r\n\t\t\t\t<div id=\"_atrad_quickTradeBook\" style=\"height: auto;\">\r\n\t\t\t    </div></td>\r\n\t\t\t\t<td >\r\n\t\t\t\t\r\n\t\t\t\t<div style=\"float:left; height:auto; margin-right:5px; \">\r\n<div style=\"float:left; height:15px; padding-top:5px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n  <tr>\r\n   <td width=\"50\" align=\"left\" id= _atrad_lblTotBid>Total Bids</td>\r\n    <td width=\"10\" align=\"left\">:</td>\r\n    <td width=\"90\" align=\"left\" id=_atrad_lblTotBidval></td>\r\n  </tr>\r\n</table>\r\n</div>\r\n<div class=\"clear\"></div>\r\n<div class=\"quickgridBg\" id=\"_atrad_quickbid\">\r\n</div>\r\n</div>\r\n<div style=\"float:left; height:auto\" class=\"redWindow\">\r\n<div style=\"float:left;  height:20px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n  <tr class=\"pinkText\">\r\n    <td width=\"55\" align=\"left\" id= _atrad_lblTotAsk  style=\"padding-top: 5px;\">Total Asks</td>\r\n    <td width=\"10\" align=\"left\" style=\"padding-top: 5px;\" >:</td>\r\n    <td width=\"90\" align=\"left\" id=_atrad_lblTotAskval style=\"padding-top: 5px;\"></td>\r\n  </tr>\r\n</table>\r\n</div>\r\n<div class=\"clear\"></div>\r\n<div class=\"gridBg2\" id=\"_atrad_quickask\">\r\n</div>\r\n</div>\t\r\n\t\t\t\t</td>\r\n\t\t\t\t<td>\r\n\t\t\t\t<div style=\"float:left; height:15px; padding-top:5px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n  <tr>\r\n   <td width=\"100%\" align=\"left\" id= _atrad_lblTotBid>Trade Summary</td>\r\n  </tr>\r\n</table>\r\n</div>\r\n\t\t\t\t <div id=\"_atrad_quickTradeSummary\" style=\"height: auto;\">\r\n\t\t\t    </div> </td>\r\n\t\t\t\t\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"3\" height=\"5px\"> </td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td td colspan=\"3\" >\r\n\t\t\t\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\" width=\"100%\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t<td style=\"float: left;\">\r\n\t\t\t\t<table>\r\n\t\t\t\t<tr><td ><div id=\"_atrad_statDataGridWeek\" style=\"height:auto;\">\r\n\t\t\t    </div></td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr><td><div class=\"clear\"></div></td></tr>\r\n\t\t\t\t<tr><td><div id=\"_atrad_statDataGridMonth\" style=\"height:auto;\">\r\n\t\t\t    </div></td></tr>\r\n\t\t\t    \r\n\t\t\t\t</table>\r\n\t\t\t\t</td>\r\n\t\t\t\t\r\n\t\t\t\t<td ><div class=\"gridBg\" id=\"_atrad_gridstat\" style=\"height: 175px; min-width: 455px\">\r\n\t\t\t\t\t\r\n\t\t\t</div></td>\r\n\t\t\t<td><table>\r\n\t\t\t<tr>\r\n\t\t\t\t<td><div id=\"_atrad_statDataGridYear\" style=\"height: auto;\">\r\n\t\t\t    </div></td>\r\n\t\t\t    </tr>\r\n\t\t\t    <tr>\r\n\t\t\t    <td></td>\r\n\t\t\t    </tr>\r\n\t\t\t    <tr>\r\n\t\t\t    <td><div id=\"_atrad_statDataGrid52week\" style=\"height: auto;\">\r\n\t\t\t    \t</div></td>\r\n\t\t\t\t</tr>\r\n\t\t\t</table>\r\n\t\t\t\r\n\t\t\t</td>\r\n\t\t\t   </tr>\r\n\t\t\t\t</table>\r\n\t\t\t    </td>\r\n\t\t\t\t\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</div>\r\n\t<div class=\"popFooter\">\r\n\t\t<div style=\"float: right\">\r\n\t\t\t<table border=\"0\" align=\"left\" cellpadding=\"0\" cellspacing=\"0\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t<td><div class =\"statRefreshCursor\" id=\"_atrad_statRefreshCursor\"></div></td>\r\n<td><button data-dojo-type=\"dijit.form.Button\" id=\"_atrad_btnStatBuy\">Buy</button></td>\r\n<td><button data-dojo-type=\"dijit.form.Button\" id=\"_atrad_btnStatSell\">Sell</button></td>\r\n\t\t\t\t\t<td>&nbsp;</td>\r\n\r\n\t\t\t\t\t<td>&nbsp;</td>\r\n\t\t\t\t\t<td><button id=\"_atrad_btnClose\" name=\"close\"\r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderClose\">Close</button></td>\r\n\t\t\t\t</tr>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\t</div>\r\n\t</div>\r\n\t\r\n\t<div style=\"clear: both\"></div>\r\n</div>\r\n"
