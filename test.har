            "mimeType": "text/html",
            "text": "<div id=\"myTrades\" >\r\n\t<div class=\"functionBar\">\r\n\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\r\n\t<tr>\r\n\t<td id=\"myTradelblTotalBuy\" style=\"width: 15%;font-weight: bold;\" atLangID=\"javascriptmyTradelblTotalBuy\">Total Buy</td>\r\n\t<td align=\"left\" width=\"10\">:</td>\r\n\t<td align=\"left\" ><div id=\"totalBuy\"  style=\"float:left\"></div></td>\r\n\t<td>&nbsp;</td>\r\n\t<td id=\"myTradelblTotalSell\" style=\"width: 15%;font-weight: bold;\" atLangID=\"javascriptmyTradelblTotalSell\">Total Sell</td>\r\n\t<td align=\"left\" width=\"10\">:</td>\r\n\t<td align=\"left\" ><div id=\"totalSell\"  style=\"float:left\"></td>\r\n\t<td>&nbsp;</td>\r\n\t<td style=\"width: 10%;\" ><button data-dojo-type=\"dijit.form.Button\" id=\"_atrad_bRefreshBut\" >Refresh</button></td>\r\n\t\r\n\t<td style=\"width: 5%;\" ><div><button data-dojo-type=\"dijit.form.Button\" id=\"saveMytradesData\" title=\"Save\" class=\"saveBlotter\"></button></div></td>\r\n\t<td style=\"width: 5%;\"><span id=\"mytradesRefreshCursor\"></span></td>\r\n\t\r\n\t</tr>\r\n\t</table>\r\n      </div>\r\n\t<div class=\"popupBody\">\r\n\t<div><strong><span atLangID=\"javascriptSecurityWiseTrades\" >Security Wise Trades</span></strong></div>\r\n\t<div style=\"clear:both;height: 5px;\" ></div>\r\n\t<div id=\"mytradeDatagrid\" dojoType=\"dijit.layout.ContentPane\"\tclass=\"mytradeGridContainer\">\r\n\t</div>\r\n\t</div>\r\n\t<div class=\"popupBody\">\r\n\t<div><strong><span atLangID=\"javascriptClientWiseTrades\" >Client Wise Trades</span></strong></div>\r\n\t<div style=\"clear:both;height: 5px;\"></div>\r\n\t<div id=\"mytradeDatagridClient\" dojoType=\"dijit.layout.ContentPane\"\tclass=\"mytradeGridContainer\">\r\n\t</div>\r\n\t</div>\r\n\t<div class=\"popFooter\">\r\n\t\t<div style=\"float: right\">\r\n\t\t\t<table border=\"0\" align=\"left\" cellpadding=\"0\" cellspacing=\"0\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td>&nbsp;</td>\r\n\r\n\t\t\t\t\t<td>&nbsp;<