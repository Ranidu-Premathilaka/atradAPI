            "mimeType": "text/html",
            "text": "<style>\r\n\t/*#grad1 {\t\t\r\n\t\tbackground-image: linear-gradient(to right, green , white,  red);\r\n\t}*/\r\n\r\n</style>\r\n\r\n\r\n<div id=\"heatMaps\">\r\n\t<div class=\"functionBar\">\r\n\t   <div dojoType=\"dijit.form.Form\" id=\"heatMapForm\" name=\"\"heatMapForm\"\" action=\"client\" jsId=\"\"heatMapForm\"\" encType=\"multipart/form-data\" onSubmit=\"return false;\">\r\n\t  \t\t<input type=\"hidden\" id=\"_atrad_action\" name=\"action\" value =\"getShortSellReport\"/>\r\n\t    \t<input type=\"hidden\" id=\"heatMap_exchange\" name=\"exchange\" value =\"\"/>\r\n\t    \t<input type=\"hidden\" id =\"heatMap_exchange_broker\" name=\"broker\" value =\"\"/>\r\n\t    \t<input type=\"hidden\" id =\"heatMap_exchange_format\" name=\"format\" value =\"\"/>  \t\r\n\t  \t\t<table width=\"99%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n\t  \t\t  <tr>\r\n\t              <td align=\"right\" width=\"70%\">              \r\n\t\t              <button data-dojo-type=\"dijit.form.Button\" id=\"heatMapRefreshbtn\" >Refresh</button>\r\n\t\t              <hr size=\"1px\"></hr>\t             \t              \r\n\t              </td>\r\n\t          </tr>\r\n\t   \t \t</table>  \r\n\t\t</div>\r\n\t</div>\r\n\t\r\n\t<div class=\"popupBody\">\t\t\r\n\t\t<div class=\"gridBg\">\r\n\t\t    <div id=\"heatMapsDataGrid\" style=\"width:690px;height:490px\" dojoType=\"dijit.layout.ContentPane\">\t\t    \t\r\n\t\t    \t<ul id=\"heatMap\">\t\t\t\t   \r\n\t\t\t\t</ul>\r\n\t\t    </div>\r\n\t\t</div>\r\n\t\t<div class=\"popGradient\">\r\n\t\t\t<div id=\"grad1\"></div>\r\n\t\t\t<div>\r\n\t\t\t\t<table width=\"97%\">\r\n\t            \t<tr>\r\n\t\t                <td width=\"97%\" align=\"left\">\r\n\t\t                    <div style=\"font-size: 7px;\" id=\"heatMapMaxColorVal\"></div>\r\n\t\t                </td>\r\n\t\t                <td width=\"3%\" align=\"right\">\r\n\t\t                    <div style=\"font-size: 7px;\" id=\"heatMapMinColorV