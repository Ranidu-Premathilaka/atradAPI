            "mimeType": "text/html",
            "text": "<div id=\"deleteBasket\">\r\n\t<div dojoType=\"dijit.form.Form\" id=\"deleteBasketForm\"\r\n\t\tjsId=\"deleteBasketForm\" name=\"deleteBasketForm\" action=\"client\"\r\n\t\tencType=\"multipart/form-data\" method=\"post\" onSubmit=\"return false;\">\r\n\t\t<input type=\"hidden\" id=\"action\" name=\"action\" value=\"deleteBasket\" />\r\n\t\t<input type=\"hidden\" id=\"format\" name=\"format\" value=\"json\" />\r\n\t\t<div class=\"functionBar\">\r\n\t\t\t<table width=\"250\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td width=\"55\"><span atLangID=\"javascriptDeleteBasket\">Basket</span></td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td>\r\n\t\t\t\t\t\t<select id=\"dltBasketddl\" name=\"dltBasketddl\" dojoType=\"dijit.form.Select\" style=\"width:90px;\" ></select>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t</tr>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\t\t\r\n\t\t<div class=\"popFooter\">\r\n\t\t\t<table>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td width=\"205\" align=\"right\">\r\n\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" name =\"close\" id=\"btnDltBasketSubmit\"  atLangID=\"javascriptDltBasketSubmitBtn\">\r\n\t\t\t\t\t\tSubmit</button>\r\n\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" name =\"close\" id=\"btnDltBasketClose\"  atLangID=\"javascriptDltBasketCloseBtn\">\r\n\t\t\t\t\t\tClose</button>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t</tr>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\t</div>\r\n</div>"
