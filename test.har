            "text": "<div id=\"blotter\">\r\n  <div class=\"functionBar\">\r\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n    <tr>\r\n      <td width=\"40\" align=\"left\" valign=\"middle\" id=\"bOrdTypeLbl\" atLangID=\"javascriptBlotterOrdType\">Order Type</td>\r\n      <td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n      <td width=\"70\" align=\"left\" valign=\"middle\">\r\n        <select id=\"bOrdTypeSelect\" \r\n\t\t\t\t\t\tdojoType=\"dijit.form.Select\" style=\"width:70px\"  type=\"text\">\r\n\t\t\t<option value=\"ALL\">ALL</option>\r\n\t\t\t<option value=\"BUY\">BUY</option>\r\n\t\t\t<option value=\"SELL\">SELL</option>\r\n\t\t\t<option value=\"SELL SHORT\">SELL SHORT</option>\r\n\t\t</select>\r\n      </td>\r\n      <td width=\"20\" align=\"left\" valign=\"middle\"></td>\r\n      <td width=\"50\" align=\"left\" valign=\"middle\" id=\"bOrdStatusLbl\" atLangID=\"javascriptBlotterOrdStatus\">Order Status</td>\r\n      <td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n      <td width=\"68\" height=\"22\" align=\"left\" valign=\"middle\"><select id=\"bOrdStatusSelect\" style=\"width:100px\"\r\n\t\t\t\t\t\tdojoType=\"dijit.form.Select\">\r\n\t\t\t<option value=\"ALL\">ALL</option>\r\n\t\t</select></td>\r\n     \r\n              <td width=\"10\" align=\"left\" valign=\"middle\"></td>\r\n            <td width=\"55\" height=\"22\" align=\"left\" valign=\"middle\" class=\"boldText\">Security</td>\r\n      <td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n      <td align=\"left\" valign=\"middle\"><input type=\"text\" name=\"bstate\" value=\"\"  trim=\"true\" id=\"bOrdSecSelect\" propercase=\"true\" style=\"width:134px\"></td>\r\n\t\t <td width=\"10\" align=\"left\" valign=\"middle\"></td>\r\n            <td width=\"55\" height=\"22\" align=\"left\" valign=\"middle\" class=\"boldText\">Order Source</td>\r\n      <td width=\"5\" align=\"left\" valign=\"middle\">:</td>\r\n      <td align=\"left\" valign=\"middle\"><select id=\"bOrdOrdrSucSelect\" style=\"width:100px\"\r\n\t\t\t\t\t\tdojoType=\"dijit.form.Select\">\r\n\t\t\t<option value=\"ALL\">ALL</option>\r\n\t\t\t<option value=\"ATRAD\">ATRAD</option>\r\n\t\t\t<option value=\"ATS\">ATS</option>\r\n\t\t\t<option value=\"BLOOMBERG\">BLOOMBERG</option>\r\n\t\t\t<option value=\"OTHER\">OTHER</option>\r\n\t\t\t<option value=\"AUCTION\">AUCTION</option>\r\n\t\t</select></td>\r\n           <td width=\"10\" align=\"left\" valign=\"middle\"></td>\r\n      \r\n            <td><input dojoType=\"dijit.form.RadioButton\" id=\"chkBlotterAll\" name=\"a\" checked=\"checked\" value=\"intraday\" type=\"radio\" />\r\n            <td><label for=\"val1\" class=\"boldText\">Mapped</label></td>  \r\n            <td width=\"10\" align=\"left\" valign=\"middle\"></td>\r\n             <td><input dojoType=\"dijit.form.RadioButton\" id=\"chkBlotterAcnt\" name=\"a\"  value=\"intraday\" type=\"radio\" />\r\n      <td width=\"100\" align=\"left\" valign=\"middle\" id=\"bClientAccLbl\" >Account</td>\r\n      <td width=\"20\" align=\"left\" valign=\"middle\">:</td>\r\n      <td width=\"140\" align=\"left\" valign=\"middle\">\r\n      <select id=\"bClientAccSelect\" name=\"portfolioClientAccount\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" style=\"width:140px; \" >           \t\t\r\n       \t\t  </select>\r\n     <!--  <select id=\"bClientAccSelect\" style=\"width:150px\" dojoType=\"dijit.form.Select\">\r\n\t\t<option value=\"ALL\">ALL</option>\r\n\t\t</select>   --></td>\r\n      <td width=\"0\" align=\"left\" valign=\"middle\"></td>\r\n      \r\n      <td width=\"50px\" align=\"left\"  valign=\"middle\"><button data-dojo-type=\"dijit.form.Button\" id=\"bRefreshBut\" >Refresh</button></td>\r\n      <td width=\"50px\" height=\"40px\" align=\"left\"  valign=\"middle\"><div><button data-dojo-type=\"dijit.form.Button\" id=\"saveBlotterData\" title=\"Save\" class=\"saveBlotter\"></button></div></td>\r\n      <td width=\"10\" align=\"left\" valign=\"middle\"><span id=\"blotterRefreshCursor\"></span></td> <!-- <td width=\"50px\" align=\"left\"><button data-dojo-type=\"dijit.form.Button\" id=\"btnSave\" >Save</button><span id=\"blotterSaveCursor\"></span></td> -->\r\n      \r\n      </tr>\r\n      <tr>\r\n      \t  <td width=\"40\" align=\"left\" valign=\"middle\" id=\"assetLbl\" atLangID=\"javascriptBlotterAsset\">Asset</td>\r\n\t      <td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t      <td width=\"70\" align=\"left\" valign=\"middle\">\r\n\t        <select id=\"assetSelect\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\" style=\"width:70px\"  type=\"text\">\r\n\t\t\t\t<option value=\"EQUITY\">EQUITY</option>\r\n\t\t\t\t<option value=\"DEBT\">DEBT</option>\r\n\t\t\t</select>\r\n\t      </td>\r\n\t      <td width=\"20\" align=\"left\" valign=\"middle\"></td>\r\n\t      \r\n      \t  <td colspan=\"12\"></td>\r\n          <td ><input dojoType=\"dijit.form.RadioButton\" id=\"chkBlotterNonMap\" name=\"a\" checked=\"checked\" value=\"intraday\" type=\"radio\" />\r\n          <td colspan=\"5\"><label for=\"val1\" class=\"boldText\">Unmapped Accounts:</label></td>           \r\n          <td ><input dojoType=\"dijit.form.TextBox\" id=\"bNClientAccSelect\" name=\"NClientAccount\" type=\"text\" />\r\n          <td colspan=\"2\"></td>    \r\n      </tr>\r\n  </table>\r\n</div>\r\n<div class=\"popupBody\" style=\"height:240px\">\r\n\t<div id=\"bOrdDataGrid\" dojoType=\"dijit.layout.ContentPane\"\tclass=\"blotterGridContainer\"></div>\r\n\t<div data-dojo-type=\"dijit.layout.ContentPane\"  id=\"bOrdDataGridSummary\" class=\"blotterSummaryGridContainer\"></div>\r\n</div>\r\n\r\n<div class=\"popFooter\">\r\n<div class=\"blueText\" style=\"float:left\" id=\"bLstRefTimeLbl\" atLangID=\"javascriptBlotterLstRefreshTime\" >Last Refresh Time: </div><div id=\"bLstRefreshTime\" class=\"blueText\" style=\"float:left\"></div>\r\n<div style=\"float:right\"><button data-dojo-type=\"dijit.form.Button\" id=\"bCloseBut\" >Close</button>\r\n</div>\r\n<div style=\"clear:both\"></div>\r\n</div>\r\n</div>\r\n</div>\t"
