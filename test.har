            "mimeType": "text/html",
            "text": "<div id=\"bulkOrder\" class=\"bulkOrderEntryWindow\">\r\n\t\t<input type=\"hidden\" id=\"removingBulkList\" name=\"removingBulkList\" value=\"\" />\r\n\t\t\t\t <input type=\"hidden\" id=\"savingBulkList\" name=\"savingBulkList\" value=\"\" />\r\n\t\t\t\t<input\ttype=\"hidden\" id=\"_atrad_brokerClient\" name=\"brokerClient\" value=\"\" />\r\n\t\t\t\t<input\ttype=\"hidden\" id=\"_atrad_brokerClientVal\" name=\"brokerClientVal\" value=\"\" />\r\n\t\t\t\t<input\ttype=\"hidden\" id=\"_atrad_orderVal\" name=\"orderVal\"\tvalue=\"\" />\r\n\t\t\t\t<input\r\n\t\t\t\ttype=\"hidden\" id=\"_atrad_odrplacedate\" name=\"orderplacedate\"\r\n\t\t\t\tvalue=\"\" />\r\n\t\t\t<div class=\"functionBar\">\r\n\t\t\t\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblExchange\"\r\n\t\t\t\t\t\t\t>Exchange</td>\r\n\t\t\t\t\t\t<td align=\"left\" width=\"10\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\"><select id=\"_atrad_cmbExchangeSelect\"\r\n\t\t\t\t\t\t\tname=\"exchangeSelect\" dojoType=\"dijit.form.Select\" type=\"text\"\r\n\t\t\t\t\t\t class=\"BS_ISO\" style=\"width: 50px !important\" >\r\n\t\t\t\t\t\t\t\t<option value=\"1\">CSE</option>\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblAction\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderAction\"></td>\r\n\t\t\t\t\t\t<td width=\"10\" align=\"left\">:</td>\r\n\t\t\t\t\t\t<td  align=\"left\"><select\r\n\t\t\t\t\t\t\tid=\"_atrad_cmbActionSelect\" name=\"actionSelect\"\r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.Select\" type=\"text\" class=\"BS_ISO\" style=\"width: 50px !important\" >\r\n\t\t\t\t\t\t\t\t<option value=\"1\">BUY</option>\r\n\t\t\t\t\t\t\t\t<option value=\"2\">SELL</option>\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblOrderType\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderOrderType\"></td>\r\n\t\t\t\t\t\t<td width=\"10\" align=\"left\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\"><select id=\"_atrad_cmbOrderType\"\r\n\t\t\t\t\t\t\tname=\"cmbOrderType\" dojoType=\"dijit.form.Select\" type=\"text\"\r\n\t\t\t\t\t\t\tclass=\"BS_ISO\" style=\"width: 70px !important\">\r\n\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblTif\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderTIF\"></td>\r\n\t\t\t\t\t\t<td width=\"10\" align=\"left\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\"><select id=\"_atrad_cmbTif\" name=\"cmbTif\"\r\n\t\t\t\t\t\t\tclass=\"BS_ISO\" dojoType=\"dijit.form.Select\" style=\"width: 50px !important\" >\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblTifDays\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderTIFDays\"></td>\r\n\t\t\t\t\t\t<td width=\"10\" align=\"left\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\"><select id=\"_atrad_cmbTifDays\"\r\n\t\t\t\t\t\t\tname=\"cmbTifDays\" class=\"BS_ISO\" dojoType=\"dijit.form.Select\" style=\"width: 50px !important\" ></select>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"left\" width=\"100px\"><button id=\"_atrad_btnAdd\" name=\"submit\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderSubmit\">ADD</button></td>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblQuantity\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderQuantity\"></td>\r\n\t\t\t\t\t\t<td width=\"10\" align=\"left\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\"><input id=\"_atrad_spnQuantity\"\r\n\t\t\t\t\t\t\trequired=\"true\" name=\"spnQuantity\"\r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.NumberSpinner\" class=\"BS_ISO\" value='0'\r\n\t\t\t\t\t\t\t, constraints=\"{min:0,places:0}\" style=\"width: 50px !important\"  />\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblPrice\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderPrice\"></td>\r\n\t\t\t\t\t\t<td width=\"10\" align=\"left\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\"><input id=\"_atrad_spnPrice\" name=\"spnPrice\"\r\n\t\t\t\t\t\t\trequired=\"true\" dojoType=\"dijit.form.NumberSpinner\"\r\n\t\t\t\t\t\t\tclass=\"BS_ISO\" value='0' , constraints=\"{min:0.00}\"  style=\"width: 50px !important\" /></td>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblSecurity\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderSecurityId\"></td>\r\n\t\t\t\t\t\t<td width=\"10\" align=\"left\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\"><input id=\"_atrad_txtSecurity\"\r\n\t\t\t\t\t\t\tname=\"txtSecurity\" dojoType=\"dijit.form.ComboBox\" trim=\"true\"\r\n\t\t\t\t\t\t\trequired=\"true\" invalidMessage=\"Invalid security code.\"\r\n\t\t\t\t\t\t\tclass=\"BS_ISO\" uppercase=\"true\" autoComplete=\"false\" style=\"width: 70px !important\" ></input> <!-- <input type=\"text\" id =\"_atrad_txtSecurity\" name=\"txtSecurity\" uppercase=\"true\"  \r\n      \tdojoType=\"dijit.form.ValidationTextBox\" trim=\"true\" regExp=\"\\b[A-Z]{3,4}\\.[NXPURWBD][0-9A-Z]{4}\" \r\n       \trequired=\"true\" invalidMessage=\"Invalid security code. Format xxx.xxxxx or xxxx.xxxxx\"  style=\"width:180px;\"></td> -->\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"left\" id=\"_atrad_lblClientAcc\"\r\n\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderClientAccoutnt\"></td>\r\n\t\t\t\t\t\t<td align=\"left\">:</td>\r\n\t\t\t\t\t\t<td align=\"left\" colspan=\"4\"><select id=\"_atrad_cmbClientAcc\"\r\n\t\t\t\t\t\t\tname=\"clientAcc\" dojoType=\"dijit.form.ComboBox\"\r\n\t\t\t\t\t\t\tautoComplete=\"false\" style=\"width: 170px\">\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td align=\"center\" >\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t\t\r\n\t\t\t\t</table>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"popupBody\">\r\n\t\t\t<div id=\"bulkDatagrid\" dojoType=\"dijit.layout.ContentPane\"\tclass=\"bulkGridContainer\">\r\n\t\t\t</div>\r\n\t</div>\r\n\t<div class=\"popFooter\">\r\n\t<div style=\"float:right\">\r\n\t\t\t\t\t\t\t\t<table border=\"0\"\r\n\t\t\t\t\t\t\t\t\talign=\"left\" cellpadding=\"0\" cellspacing=\"0\">\r\n\t\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t\t<td>&nbsp;</td>\r\n\t\t\t\t\t\t\t\t\t\t<td><input id=\"uploadFile\" placeholder=\"Choose File\" disabled=\"disabled\" /></td>\r\n\t\t\t\t\t\t\t\t\t\t<td><div class=\"fileUpload btn btn-primary\">\r\n    \t\t\t\t\t\t\t\t\t<span>Selcect an Excel File</span>\r\n    \t\t\t\t\t\t\t\t\t\t<input type=\"file\" class=\"dojoxFileInput\" name=\"file\" id=\"_atrad_file\" />\r\n\t\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<!--<input multiple=\"true\" type=\"file\"  name=\"file\" id=\"_atrad_file\"  class=\"dojoxFileInput\" />--> </td>\r\n\t\t\t\t\t\t\t\t\t\t<td><button type=\"button\" name=\"upload\" dojoType=\"dijit.form.Button\" id=\"_atrad_btnUpload\" >Upload</button>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td>&nbsp;</td>\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t<td><button id=\"_atrad_btnRemove\" name=\"btnRemove\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderSubmit\">Remove</button>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td>&nbsp;</td>\r\n\t\t\t\t\t\t\t\t\t\t<td><button id=\"_atrad_btnSaveToExcel\" name=\"submit\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t\t>Export</button>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td>&nbsp;</td>\r\n\t\t\t\t\t\t\t\t\t\t<td><button id=\"_atrad_btnSubmit\" name=\"submit\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"submit\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tatLangID=\"javascriptBuyOrderSubmit\">Submit</button>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td>&nbsp;</td>\r\n\t\t\t\t\t\t\t\t\t\t<td><button id=\"_atrad_btnClose\" name=\"close\"\r\n\t\t\t\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\"