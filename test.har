            "text": "<div dojoType=\"dijit.form.Form\" id=\"changePasswordForm\" jsId=\"changePasswordForm\"\r\n\t\t\t\tname=\"changePasswordForm\" action=\"client\" encType=\"multipart/form-data\"\r\n\t\t\t\tmethod=\"post\">\r\n\t\t<input type=\"hidden\" id=\"action\" name=\"action\" value=\"changePassword\" />\r\n\t\t<input type=\"hidden\" id=\"format\" name=\"format\" value=\"json\" />\r\n\t<div class=\"functionBar\">\r\n\t\t<div id=\"changePassword\" class=\"info\">\r\n            <span class=\"info-icon\">\r\n                <img src=\"theme/html/blue/atrad/images/icon-info.svg\" width=\"20\" height=\"20\" />                             \r\n            </span>\r\n            <span class=\"info-message\"><strong>Following special characters are not allowed <span class=\"info-chars\">(# % & +)</span></strong></span>           \r\n       </div>\r\n\t\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"190\" height=\"22\" align=\"left\" valign=\"middle\">User name<span\r\n\t\t\t\t\tclass=\"redText\"></span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"22\" colspan=\"2\"><input\r\n\t\t\t\t\ttype=\"text\" name=\"txtUsername\" id=\"txtChangePasswordUsername\"  dojoType=\"dijit.form.TextBox\"\r\n\t\t\t\t\ttrim=\"true\" value=\"\"/>\r\n\t\t\t\t\t\t\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td height=\"5\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t\t<td width=\"145\" height=\"5\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t\t<td width=\"20\" height=\"5\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td align=\"left\" valign=\"middle\">Enter current password<span\r\n\t\t\t\t\tclass=\"redText\">*</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"22\" colspan=\"2\"><input\r\n\t\t\t\t\ttype=\"password\" name=\"txtOldPassword\" id=\"txtOldPassword\"  dojoType=\"dijit.form.TextBox\"\r\n\t\t\t\t\ttrim=\"true\">\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr align=\"left\">\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td align=\"left\" valign=\"middle\">Enter new password<span\r\n\t\t\t\t\tclass=\"redText\">*</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"22\" colspan=\"2\" ><input\r\n\t\t\t\t\ttype=\"password\" name=\"txtNewPassword\"  dojoType=\"dijit.form.TextBox\"\r\n\t\t\t\t\ttrim=\"true\" id=\"txtNewPassword\">\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr align=\"left\">\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td align=\"left\" valign=\"middle\">Confirm password<span\r\n\t\t\t\t\tclass=\"redText\">*</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"22\" colspan=\"2\" ><input\r\n\t\t\t\t\ttype=\"password\" name=\"txtConfirmPassword\"  dojoType=\"dijit.form.TextBox\"\r\n\t\t\t\t\ttrim=\"true\" id=\"txtConfirmPassword\">\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t\r\n\t\t\t<tr align=\"left\">\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t\t<td height=\"5\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t\r\n\t\t</table>\r\n\t\r\n\r\n\t<div class=\"popupBody\">\r\n\t\t<div class=\"changePasswordPopFooter\"  style=\"float: left;width: 250px;text-align: left\">\r\n\t\t\t\t\t<span id=\"messageBox\"></span>&nbsp;\r\n