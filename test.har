          "content": {
            "size": 5042,
            "mimeType": "text/html",
            "text": "\r\n<div id=\"portfolio\">\r\n <div class=\"functionBar\">\r\n   <div dojoType=\"dijit.form.Form\" id=\"portfolioForm\" name=\"portfolioForm\" action=\"client\" jsId=\"portfolioForm\" encType=\"multipart/form-data\" onSubmit=\"return false;\">\r\n  \t\t<input type=\"hidden\" id=\"_atrad_action\" name=\"action\" value =\"getPortfolio\"/>\r\n    \t<input type=\"hidden\" id=\"portfolio_exchange\" name=\"exchange\" value =\"\"/>\r\n    \t<input type=\"hidden\" id =\"portfolio_broker\" name=\"broker\" value =\"\"/>\r\n    \t<input type=\"hidden\" id =\"portfolio_format\" name=\"format\" value =\"\"/>  \t\r\n  \t\t<table width=\"98%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n  \t\t  <tr>\r\n  \t\t  \t<td width=\"20\" align=\"left\" valign=\"middle\"><div id=\"lbportfolioAsset\" >Asset</div></td>\r\n    \t\t<td width=\"5\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n     \t\t<td width=\"190\" align=\"left\" valign=\"middle\">\r\n     \t\t\t<select id=\"portfolioAsset\" name=\"portfolioAsset\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" style=\"width:100px; \" >\r\n     \t\t  \t\t<option value=\"EQUITY\">EQUITY</option> \r\n     \t\t  \t\t<option value=\"DEBT\">DEBT</option>    \t\t\r\n       \t\t  \t</select>\r\n       \t\t</td>\r\n    \t\t<td width=\"70\" align=\"left\" valign=\"middle\"><div id=\"lbportfolioAccount\" atLangID=\"javascriptPortfolioAccNo\" style=\"padding-left: 10px;\">Account No</div></td>\r\n    \t\t<td width=\"5\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n     \t\t<td width=\"250\" align=\"left\" valign=\"middle\">\r\n     \t\t\t<select id=\"portfolioClientAccount\" name=\"portfolioClientAccount\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" style=\"width:230px; \"></select>\r\n     \t\t</td>     \t\t\r\n    \t\t<td width=\"70\" align=\"left\" valign=\"middle\"><div id=\"lbportfolioAddress\" atLangID=\"javascriptPortfolioAddress\">Address</div></td>\r\n    \t\t<td width=\"10\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n    \t\t<td width=\"375\" align=\"left\" valign=\"middle\"><div id=\"lbPortfolioAddressContent\"></div></td>\r\n            <!--  <td width=\"10\" ></td> -->           \r\n            <td align=\"right\" width=\"140px\">             \r\n              <span id=\"portfolioDebtRefreshCursor\" ></span>\r\n              <button id=\"portfolioRefreshbtnLb\" name =\"refresh\" dojoType=\"dijit.form.Button\" type=\"button\" id=\"btnportfolioRefresh\" atLangID=\"javascriptPortfolioRefreshBtn\">Refresh</button>                   \r\n              <div dojoType=\"dijit.form.Button\" id=\"printPortfolioDebt\" title=\"Print\"></div>\r\n              <div dojoType=\"dijit.form.Button\" id=\"savePortfolioDebt\" title=\"Save\"></div>             \r\n            </td>\r\n    \t  </tr>\r\n    \t  <tr>\r\n     \t\t<td width=\"20\" align=\"left\" valign=\"middle\" ><div id=\"portfolioNameLb\" atLangID=\"javascriptPortfolioName\">Name</div></td>\r\n     \t\t<td align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n    \t    <td width=\"190\" align=\"left\" valign=\"middle\" ><div id=\"lbPortfolioNameContent\"></div></td>      \t\t \r\n      \t\t<td align=\"left\" valign=\"middle\" width=\"70\"><div atLangID=\"javascriptaccountStatementTelePhone\" style=\"padding-left: 10px;\">Tel No</div></td>\r\n      \t\t<td align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>      \t\t \r\n            <td width=\"250\" align=\"left\" valign=\"middle\" id=\"lblPortStmtTp\"><strong></strong></td>             \t    \r\n\t\t    <td width=\"70\" align=\"left\" valign=\"middle\" id=\"lblPortfolioBuyingPower\" atLangID=\"javascriptBuyOrderBuyingPower\">Buying Power</td>\r\n\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n\t\t    <td width=\"375\" align=\"left\" valign=\"middle\">\r\n     \t\t\t\t<span id=\"txtPortfolioBuyingPower\" class=\"fontBold\"></span>\r\n\t\t    </td>\t\t    \r\n             <td colspan=\"1\"></td>              \r\n      \t</tr>\r\n      \t\r\n  </table>  \r\n  \r\n <!--  <table>\r\n  <tr>\r\n  <td>\r\n  Total Cost\r\n  </td>\r\n  <td>:</td>\r\n  <td>\r\n  <span id=portfolioTotalCost></span>\r\n  </td>\r\n  <td>\r\n  Total Market Value\r\n  </td>\r\n  <td>:</td>\r\n  <td>\r\n  <span id=portfolioTotalMarketValue></span>\r\n  </td>\r\n  <td>\r\n  Total Net Gain/Loss\r\n  </td>\r\n  <td>:</td>\r\n  <td>\r\n  <span id=portfolioTotalNet></span>\r\n  </td>\r\n  \r\n  </tr>\r\n   </table>\r\n   --> \r\n</div>\r\n</div>\r\n\r\n<div class=\"popupBody\">\r\n<div class=\"gridBg\">\r\n    <div id=\"portfolioDataGrid\" style=\"width:695px;height:290px\" dojoType=\"dijit.layout.ContentPane\">      \r\n</div>\r\n</div>\r\n<div class=\"popFooter\">\r\n<table width=\"100%\">\r\n<tr>\r\n<td class=\"blueText note\" width=\"90%\">\r\n*The average cost and <span>gain/loss</span> in this statement are indicative figures as the cost of the following transaction types may have not been captured in the calculation\r\n</td>\r\n</tr>\r\n</table>\r\n<table width=\"100%\" >\r\n<tr>\r\n<td class=\"blueText note2\" width=\"90%\">\r\n*Warrants&nbsp;&nbsp;&nbsp;*Right issues&nbsp;&nbsp;&nbsp;*Splits&nbsp;&nbsp;&nbsp;*Subdivisions&nbsp;&nbsp;&nbsp;*Bonus issues&nbsp;&nbsp;&nbsp;*Intra transfer&nbsp;&nbsp;&nbsp;*Share lodgments\r\n</td>\r\n<td width=\"5%\" align=\"right\">\r\n<button dojoType=\"dijit.form.Button\" name =\"close\" id=\"btnPortfolioClose\"  atLangID=\"javascriptPortfoliocloseBtn\">\r\n\tClose</button>\r\n</td>\r\n</tr>\r\n</table>\r\n\r\n\r\n</div>\r\n</div>\r\n\r\n</div>"
          },
