            "text": "<div id=\"alerts\">\r\n\t<div dojoType=\"dijit.form.Form\" id=\"alertForm\" jsId=\"alertForm\"\tname=\"alertForm\" action=\"alert\" encType=\"multipart/form-data\"\r\n\t\t\t\tmethod=\"post\" onSubmit=\"return false\">\r\n\t\t <input type=\"hidden\" id=\"action\" name=\"action\" value=\"saveAlerts\" />\r\n\t\t <input type=\"hidden\" id=\"format\" name=\"format\" value=\"json\">\r\n\t\t  <input type=\"hidden\" id=\"alrtType\" name=\"alrtType\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtSecurity\" name=\"security\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtPrmtr\" name=\"parameter\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtCriteria\" name=\"criteria\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtValue\" name=\"value\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtOprtn\" name=\"operation\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtExprDt\" name=\"expDate\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtExprTime\" name=\"expTime\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtMessage\" name=\"message\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtPopup\" name=\"alrtPopup\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtSms\" name=\"alrtSms\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtEmail\" name=\"alrtEmail\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtNotify\" name=\"notify\" value=\"\"/>\r\n\t\t <input type=\"hidden\" id=\"alrtCriteriaValueList\" name=\"alrtCriteriaValueList\" value=\"\">\r\n\t\t \r\n\t\t<div class = \"functionBar\">\r\n\t\t\t\r\n\t\t\t\t<table>\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td width=\"55px\" height=\"22\" align=\"left\" valign=\"middle\" id=\"lblAlertName\">Alert Name</td>\r\n\t\t\t\t\t\t\t<td width=\"5px\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t<td width=\"110\"><input id=\"alertNameString\" name=\"alertName\" dojoType=\"dijit.form.ValidationTextBox\" ></td>\r\n\t\t\t\t\t\t\t<td ></td>\r\n\t\t\t\t\t\t\t<td align=\"left\" valign=\"middle\" class=\"boldText\">Security</td>\r\n\t\t\t\t\t\t\t<td width=\"5px\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t<td valign=\"middle\" colspan=\"9\"><input type=\"text\" name=\"txtsecurityListAlerts\" value=\"\"  trim=\"true\" id=\"txtsecurityListAlerts\" propercase=\"true\" style=\"width:500px\"></td>\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td width=\"55px\"  height=\"22\" align=\"left\" valign=\"middle\" id=\"alertMode\">Alert Mode</td>\r\n\t\t\t\t\t\t\t<td width=\"5px\" align=\"left\" valign=\"middle\">:</td>\t \r\n\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t<table>\r\n\t\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t\t\t\t<input id=\"alertModepopup\" name=\"alertPopup\" dojoType=\"dijit.form.CheckBox\" checked=\"checked\">\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td width=\"45\" height=\"22\" align=\"left\" valign=\"middle\" id=\"alertPopup\">Popup</td>\t \t\t\r\n\t\t\t\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t\t\t\t<input id=\"alertModSms\" name=\"alertSms\" dojoType=\"dijit.form.CheckBox\" disabled='disabled' >\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td width=\"40\" height=\"22\" align=\"left\" valign=\"middle\" id=\"alertSms\">SMS</td>\t \t\t\r\n\t\t\t\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t\t\t\t<input id=\"alertModeEmail\" name=\"alertEmail\" dojoType=\"dijit.form.CheckBox\" disabled='disabled'>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td width=\"45\" height=\"22\" align=\"left\" valign=\"middle\" id=\"alertEmail\">EMail</td>\r\n\t\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t</table>\r\n\t\t\t\t\t\t\t</td>\t\r\n\t\t\t\t\t\t\t<td ></td>\r\n\t\t\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<td  height=\"22\" align=\"left\" valign=\"middle\">Validity Period</td>\r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t<td>\t \t\t\t\r\n\t\t\t\t\t\t\t\t<select id=\"alertValidity\" name=\"alertValidity\" dojoType=\"dijit.form.Select\" style=\"width:70px\" type=\"text\">\r\n\t\t\t\t\t\t\t\t\t<option value=\"1\">1 Day</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"2\">2 Days</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"3\">3 Days</option>\r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t<tr>\t \t \r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\" class=\"boldText\">Operation</td>\r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t<td align=\"left\" valign=\"middle\">\r\n\t\t\t\t\t\t\t\t<select id=\"alertOperation\" name=\"alertOperation\" dojoType=\"dijit.form.Select\" style=\"style:70px\" type=\"text\">\r\n\t\t\t\t\t\t\t\t\t<option value=\"matchAll\">Match all Conditions</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"matchAny\">Match any Condition</option>\r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td ></td>\r\n\t\t\t\t\t\t\t<td  height=\"22\" align=\"left\" valign=\"middle\">Notify </td>\r\n\t\t\t\t\t\t\t<td>:</td>\r\n\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t<select id=\"alertNotify\" name=\"alertNotify\" dojoType=\"dijit.form.Select\" style=\"width:70px\" type=\"text\">\r\n\t\t\t\t\t\t\t\t\t<option value=\"onceOnly\">Once Only</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"onceAday\">Once a Day</option>\r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</td>\t\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<td  height=\"22\" align=\"left\" valign=\"middle\" id=\"alertMessage\">Message</td>\r\n\t\t\t\t\t\t\t<td align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t<td  colspan=\"5\"><input id=\"alertMessageString\" name=\"alertMssg\" style=\"width: 350px\" dojoType=\"dijit.form.ValidationTextBox\" ></td>\t\r\n\t\t\t\t\t\t<td  colspan=\"8\"></td>\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t</table>\r\n\t\t\t\r\n\t\t</div>\r\n\t\t<div class =\"popupBody\">\r\n\t\t\t<div dojoType=\"dijit.layout.TabContainer\" style=\"width:100%;height:280px;\" id=\"setAlertTb\">\r\n\t\t\t\t<div dojoType=\"dijit.layout.ContentPane\" title=\"PRICE\" selected=\"true\" style=\"width:100%;\" class=\"statTab\" id=\"priceTab\">\r\n\t\t\t\t\t<div style=\"padding: 0px 2px 5px 5px;\">\r\n\t\t\t\t\t<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" class=\"bluetext\" width=\"100%\">\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td colspan=\"7\" height=\"7px\">\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<tr>\t \t \r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\" id=\"alertParameter\">Parameter</td>\r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\">\r\n\t\t\t\t\t\t\t\t<select id=\"paramSelect\" dojoType=\"dijit.form.Select\" style=\"width:70px\" type=\"text\">\r\n\t\t\t\t\t\t\t\t  <option value=\"Bid\">Bid</option>\r\n\t\t\t\t\t\t\t\t  <option value=\"Ask\">Ask</option>\r\n\t\t\t\t\t\t\t\t  <option value=\"Last\">Last</option>\r\n\t\t\t\t\t\t\t\t  <option value=\"LastQty\">Last Qty</option>\r\n\t\t\t\t\t\t\t\t  <option value=\"AskQty\">Ask Qty</option>\r\n\t\t\t\t\t\t\t\t  <option value=\"BidQty\">Bid Qty</option>\r\n\t\t\t\t\t\t\t\t  <option value=\"TotVolume\">Total Volume</option>\r\n\t\t\t\t\t\t\t\t  <option value=\"Change\">% Change</option>\r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td ></td>\r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\" id=\"alertCriteria\">Criteria</td>\r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\">\r\n\t\t\t\t\t\t\t\t<select id=\"criteriaSelect\" dojoType=\"dijit.form.Select\" style=\"width:100px\" type=\"text\">\r\n\t\t\t\t\t\t\t\t  <option value=\"GT\">Greater Than</option>\r\n\t\t\t\t\t\t\t\t  <option value=\"LT\">Less Than</option>\r\n\t\t\t\t\t\t\t\t  <option value=\"E\">Equal</option>\r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td ></td>\r\n\t\t\t\t\t\t\t<td width=\"35px\" align=\"left\" valign=\"middle\" id=\"alertValue\">Value </td>\r\n\t\t\t\t\t\t\t<td>:</td>\r\n\t\t\t\t\t\t\t<td align=\"left\" valign=\"middle\">\r\n\t\t\t\t\t\t\t\t<input type=\"text\" name=\"alertValue\" id=\"alertValueId\" style=\"width: 95px\" dojoType=\"dijit.form.ValidationTextBox\"  > \r\n\t\t\t\t\t\t\t\t<button type =\"button\" dojoType=\"dijit.form.Button\" id=\"btnAddParameter\">Add</button>\r\n\t\t\t\t\t\t\t</td> \t\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t</table>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t <div >\r\n\t\t\t\t\t\t<div id = \"dataGrid\" dojoType = \"dijit.layout.ContentPane\" class = \"alertGridContainer\"></div>\r\n\t\t\t\t\t</div>\t\r\n\t\t\t\t</div>\r\n\t\t\t\t<div dojoType=\"dijit.layout.ContentPane\" title=\"NEWS\" selected=\"true\" style=\"width:100%;\" class=\"statTab\"  id=\"newsTab\">\r\n\t\t\t\t\t<div style=\"padding: 0px 2px 5px 5px;\" >\r\n\t\t\t\t\t<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" class=\"bluetext\" width=\"100%\">\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td colspan=\"7\" height=\"7px\">\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td align=\"left\" valign=\"middle\" class=\"boldText\">Key Word</td>\r\n\t\t\t\t\t\t\t<td  align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t<td align=\"left\" valign=\"middle\" colspan=\"12\">\r\n\t\t\t\t\t\t\t\t<input id=\"alertKeyword\" name=\"alertKeyword\" style=\"width: 250px\" dojoType=\"dijit.form.ValidationTextBox\" >\r\n\t\t\t\t\t\t\t\t<span id='keywordMsg' style=\"font-size: 10px;display: block;color: #c1a023;\"><strong>add keywords with a hash tag (eg: #keyword)</strong></span>\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t<td align=\"left\" valign=\"middle\">\r\n\t\t\t\t\t\t\t\t<button type =\"button\" dojoType=\"dijit.form.Button\" id=\"btnAddKeyword\">Add</button>\r\n\t\t\t\t\t\t\t</td> \t\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t</table>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t <div >\r\n\t\t\t\t\t\t<div id = \"dataGridNews\" dojoType = \"dijit.layout.ContentPane\" class = \"alertGridContainer\"></div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\t\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t<div class = \"popFooter\">\r\n\t\t\t\r\n\t\t\t\t\t\t<div class=\"setAlertPopFooter\"  style=\"float: left;text-align: left\">\r\n\t\t\t\t\t\t\t<span id=\"setAlertMessageBox\"></span>&nbsp;\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\r\n\t\t\t\t\t\t<div style=\"float:right\">\r\n\t\t\t\t\t\t\t<button type =\"submit\" dojoType=\"dijit.form.Button\" id=\"btnSetAlert\">Set Alert</button>\r\n\t\t\t\t\t\t\t<button type=\"button\" dojoType=\"dijit.form.Button\" id=\"btnSetClear\">Clear</button>\r\n\t\t\t\t\t\t\t<button type =\"button\" data-dojo-type=\"dijit.form.Button\" id=\"bCloseButAlert\" >Close</button>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\r\n\t\t\t\r\n\t\t</div>\r\n\t</div>\r\n</div>"
