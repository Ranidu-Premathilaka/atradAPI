            "text": "\r\n<div id=\"shortPositions\">\r\n\t<div class=\"functionBar\">\r\n\t   <div dojoType=\"dijit.form.Form\" id=\"shortPositionsForm\" name=\"shortPositionsForm\" action=\"client\" jsId=\"shortPositionsForm\" encType=\"multipart/form-data\" onSubmit=\"return false;\">\r\n\t  \t\t<input type=\"hidden\" id=\"_atrad_action\" name=\"action\" value =\"getShortSellReport\"/>\r\n\t    \t<input type=\"hidden\" id=\"shortPositions_exchange\" name=\"exchange\" value =\"\"/>\r\n\t    \t<input type=\"hidden\" id =\"shortPositions_broker\" name=\"broker\" value =\"\"/>\r\n\t    \t<input type=\"hidden\" id =\"shortPositions_format\" name=\"format\" value =\"\"/>  \t\r\n\t  \t\t<table width=\"98%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n\t  \t\t  <tr>\r\n\t    \t\t  <td width=\"10%\" align=\"left\" valign=\"middle\"><div id=\"lbstockHoldingAccount\" atLangID=\"javascriptStockHoldingAccNo\"></div></td>\r\n\t    \t\t  <td width=\"1%\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n\t     \t\t  <td width=\"10%\" align=\"left\" valign=\"middle\">\r\n\t\t     \t\t  <select id=\"shortPositionsClientAccount\" name=\"txtClient\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" style=\"width:200px; \" >           \t\t\r\n\t\t       \t\t  </select>\r\n\t       \t\t  </td>\r\n\t    \t\t  <td width=\"2%\" align=\"left\" valign=\"middle\">&nbsp;</td>\r\n\t    \t\t  <td width=\"10%\" align=\"left\" valign=\"middle\"><div id=\"lbstockHoldingSecurity\" atLangID=\"javascriptStockHoldingSecurity\"></div></td>\r\n\t    \t\t  <td width=\"1%\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n\t     \t\t  <td width=\"10%\" align=\"left\" valign=\"middle\">\r\n\t\t     \t\t  <select id=\"shortPositionsSecurity\" name=\"txtSecurityId\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" style=\"width:100px; \" >           \t\t\r\n\t\t       \t\t  </select>\r\n\t       \t\t  </td>\r\n\t              <td wi