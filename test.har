          "content": {
            "size": 8445,
            "mimeType": "text/html",
            "text": "<div id=\"accStmt\">\r\n<div class=\"functionBar\" style=\"padding-bottom: 5px;\">\r\n<div dojoType=\"dijit.form.Form\" id=\"accStmtForm\" name=\"accStmtForm\" action=\"client\" onSubmit=\"return false;\" class=\"blueText\">\r\n\r\n\t\t\t<input type=\"hidden\" id=\"accpos_action\" name=\"action\" value =\"\"/>\r\n\r\n    \t\t<input type=\"hidden\" id=\"accpos_exchange\" name=\"exchange\" value =\"\"/>\r\n\r\n    \t\t<input type=\"hidden\" id =\"accpos_format\" name=\"format\" value =\"\"/>\r\n\r\n    \t\t<input type=\"hidden\" id =\"accpos_broker\" name=\"broker\" value =\"\"/>\r\n\r\n<table width=\"1100px\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n\t<tr>\r\n\t\t<td width=\"35px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtNo\" atLangID=\"javascriptaccountStatementAccNo\">A/C No</td>\r\n\t\t<td width=\"5px\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\t\t\r\n\t\t<td width=\"250px\" align=\"left\" valign=\"middle\">\r\n\t\t\t<select id=\"ddlaccStmtSelect\" name=\"accStmtSelect\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" type=\"text\" style=\"width:250px; \"></select>\r\n\t\t</td>\t\t\r\n\t\t<td width=\"30px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtDate\" atLangID=\"javascriptaccountStatementDateFrom\">Display from</td>\r\n      \t<td width=\"5px\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n      \t<td width=\"80px\"><input id=\"accStmtdate\" name=\"accStmtdate\" type=\"text\" dojoType=\"dijit.form.DateTextBox\"  value=\"now\" constraints=\"{datePattern:'MM/dd/yyyy'}\" ></td> \r\n      \t<td width=\"10px\" align=\"left\" valign=\"middle\"></td>        \t\r\n      \t<td width=\"30px\" id=\"lblaccstmtTo\" atLangID=\"javascriptaccountStatementDateTo\"><strong>To</strong></td>\r\n      \t<td width=\"5px\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n      \t<td width=\"80px\"><input name=\"accStmtTodate\" id=\"accStmtTodate\" value=\"now\" dojoType=\"dijit.form.DateTextBox\" required=\"true\" constraints=\"{datePattern:'MM/dd/yyyy'}\"> </td> \r\n\t</tr>\r\n\t\r\n\t<tr>\r\n\t\t<td  width=\"35px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtNamelbl\" atLangID=\"javascriptaccountStatementName\">Name</td>\r\n      \t<td width=\"5px\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n      \t<td width=\"250px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtName\"></td>      \t\r\n      \t<td width=\"30px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtTplbl\" atLangID=\"javascriptaccountStatementTelePhone\">Telephone</td>\r\n      \t<td width=\"5px\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n\t  \t<td width=\"80px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtTp\"></td> \r\n\t  \t<td width=\"10px\" align=\"left\" valign=\"middle\"></td>  \r\n\t  \t<td align=\"left\" width=\"30px\" valign=\"middle\" id=\"lblaccStmtBuyingPower\" atLangID=\"javascriptBuyOrderBuyingPower\">Buying Power</td>\r\n\t    <td width=\"5px\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n\t    <td width=\"80px\" height=\"22\" align=\"left\" valign=\"middle\">\r\n\t      <span id=\"txtaccStmtBuyingPower\" class=\"fontBold\"></span>\t   \r\n\t    </td>\r\n\t</tr>\r\n\t\r\n\t<tr>\r\n\t\t<td  width=\"35px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtAddreslbl\" atLangID=\"javascriptaccountStatementAddress\">Address</td>\r\n      \t<td width=\"5px\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n      \t<td width=\"250px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtAddres\"></td>\r\n\t\t<td width=\"30px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtAdvisor\" atLangID=\"javascriptaccountStatementAdvisor\">Investment Advisor</td>\r\n      \t<td width=\"5px\" align=\"left\" valign=\"middle\" style=\"padding: 5px;\">:</td>\r\n      \t<td width=\"80px\" align=\"left\" valign=\"middle\" id=\"lblaccStmtInvestAdvisor\" ></td>\r\n      \t<td colspan=\"4\" align=\"left\">      \t\t\r\n       \t\t<span id=\"accStmtRefreshCursor\" style=\"float: none; width: 30px; height:40px; padding-right: 40px;\"></span>\r\n       \t\t<button data-dojo-type=\"dijit.form.Button\" id=\"butaccGo\" atLangID=\"javascriptAccountStatementGo\">Search</button> \r\n       \t\t<button dojoType=\"dijit.form.Button\" id=\"printAccountStatment\"></button>\r\n     \t\t<button dojoType=\"dijit.form.Button\" id=\"saveAccountStatment\"></button>\r\n       \t</td>\r\n      \t\t\r\n\t</tr>\r\n\t\r\n\t\r\n\r\n<!--  \r\n    <tr>\r\n\r\n      <td width=\"40\" align=\"left\" valign=\"middle\" id=\"lblaccStmtNo\" atLangID=\"javascriptaccountStatementAccNo\">A/C No</td>\r\n\r\n      <td width=\"5\" align=\"left\" valign=\"middle\">:</td>\r\n\r\n      <td width=\"300\" align=\"left\" valign=\"middle\"><select id=\"ddlaccStmtSelect\" name=\"accStmtSelect\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" type=\"text\" style=\"width:300px; \">\r\n\r\n        </select></td>\r\n\r\n      <td width=\"10\" align=\"left\" valign=\"middle\">&nbsp;</td>\r\n\r\n      <td width=\"95\" align=\"left\" valign=\"middle\" id=\"lblaccStmtAdvisor\" atLangID=\"javascriptaccountStatementAdvisor\">Investment Advisor</td>\r\n\r\n      <td width=\"5\" align=\"left\" valign=\"middle\">:</td>\r\n\r\n      <td width=\"150\" align=\"left\" valign=\"middle\" id=\"lblaccStmtInvestAdvisor\" ><strong></strong>\r\n      </td>\r\n\t<td>\r\n\t <div dojoType=\"dijit.form.Button\" id=\"printAccountStatment\"></div>\r\n     <div dojoType=\"dijit.form.Button\" id=\"saveAccountStatment\"></div>\r\n\t</td>\r\n      </tr>\r\n\r\n    <tr>\r\n\r\n      <td align=\"left\" valign=\"middle\" id=\"lblaccStmtNamelbl\" atLangID=\"javascriptaccountStatementName\">Name</td>\r\n\r\n      <td align=\"left\" valign=\"middle\">:</td>\r\n\r\n      <td align=\"left\" valign=\"middle\" id=\"lblaccStmtName\" style=\"\r\n    display: block;\r\n    height: 15px;\r\n    overflow: hidden;\r\n\"><strong ></strong></td>\r\n\r\n      <td align=\"left\" valign=\"middle\">&nbsp;</td>\r\n\r\n      <td align=\"left\" valign=\"middle\" id=\"lblaccStmtDate\" atLangID=\"javascriptaccountStatementDateFrom\">Display from</td>\r\n\r\n      <td align=\"left\" valign=\"middle\">:</td>\r\n\r\n      <td height=\"22\" align=\"left\" valign=\"middle\" colspan=\"2\"><table border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n\r\n        <tr>\r\n\r\n          <td><input id=\"accStmtdate\" name=\"accStmtdate\" type=\"text\" dojoType=\"dijit.form.DateTextBox\"  value=\"\" ></td>\r\n\r\n          <td width=\"10\">&nbsp;</td>\r\n\r\n          <td id=\"lblaccstmtTo\" atLangID=\"javascriptaccountStatementDateTo\"><strong>To</strong></td>\r\n\r\n          <td width=\"10\"></td>\r\n\t\t\t<td><input name=\"accStmtTodate\" id=\"accStmtTodate\" value=\"\" dojoType=\"dijit.form.DateTextBox\"\r\n\r\n  \t\t\trequired=\"true\"> </td>\r\n          <td width=\"70\">\r\n\t          <button data-dojo-type=\"dijit.form.Button\" id=\"butaccGo\" atLangID=\"javascriptAccountStatementGo\">Go</button>\r\n\t          <span id=\"accStmtRefreshCursor\" height=\"10px\"></span>\r\n          </td>\r\n\r\n          </tr>\r\n\r\n        </table>        </td>\r\n\r\n      </tr>\r\n\r\n    <tr>\r\n\r\n      <td align=\"left\" valign=\"middle\" id=\"lblaccStmtAddreslbl\" atLangID=\"javascriptaccountStatementAddress\">Address</td>\r\n      <td align=\"left\" valign=\"middle\">:</td>\r\n      <td align=\"left\" valign=\"middle\" id=\"lblaccStmtAddres\"></td>      \r\n      <td align=\"left\" valign=\"middle\">&nbsp;</td>             \r\n      \r\n      <td align=\"left\" valign=\"middle\" id=\"lblaccStmtTplbl\" atLangID=\"javascriptaccountStatementTelePhone\">Telephone</td>\r\n      <td align=\"left\" valign=\"middle\">:</td>\r\n\t  <td align=\"left\" valign=\"middle\" id=\"lblaccStmtTp\"><strong></strong></td>  \r\n\t  \t  \t      \r\n\t  <td>\r\n\t  <table>\r\n\t    <tr>\r\n\t      <td align=\"left\" width=\"70\" valign=\"middle\" id=\"lblaccStmtBuyingPower\" atLangID=\"javascriptBuyOrderBuyingPower\">Buying Power</td>\r\n\t      <td align=\"left\" valign=\"middle\">:</td>\r\n\t      <td height=\"22\" align=\"left\" valign=\"middle\">\r\n\t      \t<span id=\"txtaccStmtBuyingPower\" class=\"fontBold\"></span>\t   \r\n\t      </td>\r\n\t     </tr> \r\n      </table>\r\n      </td>\r\n    </tr>\r\n-->\r\n\r\n\r\n  </table>\r\n  <form id='hiddenAccntStmantForm' method='post' action='client' target='TheNewWindow'>\r\n  <input id=\"format\" type='hidden' name='format' value='csv'>\r\n  <input id=\"content\" type='hidden' name='content' value=''>\r\n   <input id=\"action\" type='hidden' name='action' value='returncsv'>\r\n  <input id=\"title\" type='hidden' name='title' value=''>\r\n</form>\r\n</div>\r\n</div>\r\n<div class=\"popupBody\">\r\n\t<div height=\"270px\" id=\"grdaccsmtDataGrid\" dojoType=\"dijit.layout.ContentPane\" class=\"grid padded-table\"></div>\r\n\t<div class=\"popFooter\">\r\n\t<table>\r\n\t\t<tr>\r\n\t\t\t<td class=\"blueText note2\" width=\"1000\">\r\n\t\t\tThe balances shown in the account statement are subject to change upon cse records. Fees and brokerage applicable on same day trades/negotiable brokerage will be updated at close of business and cheque payments on realization.\r\n\t\t\t</td>\r\n\t\t\t<td width=\"73\" align=\"right\">\r\n\t\t\t\t<button data-dojo-type=\"dijit.form.Button\" id=\"butaccClose\">Close</button></div>\r\n\t\t</td>\r\n\t\t</tr>\r\n\t</table>\r\n\t</div>\t\r\n</div>\r\n</div>\r\n"
