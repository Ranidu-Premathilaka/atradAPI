            "mimeType": "text/html",
            "text": "<div class=\"whatifCalculator\" id=_atrad_whatifCalculator\">\r\n\t\t<div  id=\"_atrad_whatifCalculatorForm\" dojoType=\"dijit.form.Form\" jsId=\"_atrad_whatifCalculatorForm\"\r\n\t\tname=\"whatifCalculatorForm\" action=\"\" encType=\"multipart/form-data\" method=\"post\">\r\n\t\t\t<table width=\"700\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td width=\"49.5%\">\r\n\t\t\t\t\t\t<div  id=\"_atrad_whatifFunctionBar1\" class=\"functionBar\">\r\n\t\t\t\t\t\t\t<table>\r\n\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t<td width=\"190\" height=\"22\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptWhatifSymbol\">Symbol</span>\r\n\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t\t\t<td height=\"15\" colspan=\"2\"><input name=\"cmbSymbol\" id=\"_atrad_cmbSymbol\"  dojoType=\"dijit.form.ComboBox\"  trim=\"true\"  \r\n\t\t\t\t\t\t       \t\t\tclass=\"BS_ISO\" uppercase=\"true\" autoComplete=\"false\"/></td>\r\n\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t<td colspan=\"4\" height=\"1px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t<td width=\"190\" height=\"22\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptWhatifBuyDate\">Buy Date</span><span\r\n\t\t\t\t\t\t\t\t\t\tclass=\"redText\">*</span>\r\n\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t\t\t<td height=\"15\" colspan=\"2\"><input\r\n\t\t\t\t\t\t\t\t\t\ttype=\"text\" name=\"txtBuyDate\" id=\"_atrad_txtBuyDate\"  dojoType=\"dijit.form.DateTextBox\" required=\"true\" \r\n\t\t\t\t\t\t\t\t\t\ttrim=\"true\" value=\"\"/>\r\n\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t<td colspan=\"4\" height=\"1px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t<td width=\"190\" height=\"22\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptWhatifSellDate\">Sell Date</span><span\r\n\t\t\t\t\t\t\t\t\t\tclass=\"redText\">*</span>\r\n\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t\t\t<td height=\"15\" colspan=\"2\"><input\r\n\t\t\t\t\t\t\t\t\t\ttype=\"text\" name=\"txtSellDate\" id=\"_atrad_txtSellDate\"  dojoType=\"dijit.form.DateTextBox\" required=\"true\" \r\n\t\t\t\t\t\t\t\t\t\ttrim=\"true\" value=\"\"/>\r\n\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t<td colspan=\"4\" height=\"1px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t<td width=\"190\" height=\"15\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptWhatifPurchasedPrice\">Purchased Price per Share</span><span\r\n\t\t\t\t\t\t\t\t\t\tclass=\"redText\">*</span>\r\n\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t\t\t<td height=\"15\" colspan=\"2\"><input name=\"spnpurchsdPrice\" id=\"_atrad_spnpurchsdPrice\"  required=\"true\" dojoType=\"dijit.form.NumberSpinner\" \r\n\t\t\t\t\t\t    \t  \tstyle=\"width:100px\" value= '0.00', constraints=\"{min:0.00}\"/></td>\r\n\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t<td colspan=\"4\" height=\"1px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t<td width=\"190\" height=\"15\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptWhatifQuantity\">Quantity</span><span\r\n\t\t\t\t\t\t\t\t\t\tclass=\"redText\">*</span>\r\n\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t\t\t\t<td height=\"15\" colspan=\"2\"><input name=\"spnQuantity\" id=\"_atrad_spnQuantity\"  required=\"