            "mimeType": "text/html",
            "text": "<div id=\"mrktIndexSummaryHistory\">\r\n\t<div class=\"functionBar mrktIndexSummaryHistoryfunctionBar\">\r\n   \t\t<table width=\"100%\">\r\n\t         <tr>\r\n\t        \t<td colspan=\"3\" height=\"5px\"></td>\r\n\t        </tr>\r\n\t        <tr>\r\n\t            <td width=\"4%\"><label for=\"name\">From</label></td>\r\n\t            <td width=\"16%\">: <input dojoType=\"dijit.form.DateTextBox\" name=\"name\" id=\"mrktIndexSummaryHistoryDate\" value=\"now\" constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\"></td>\r\n\t            <td width=\"4%\"><label for=\"name\">To</label></td>\r\n\t            <td width=\"16%\">: <input dojoType=\"dijit.form.DateTextBox\" name=\"name\" id=\"mrktIndexSummaryHistoryDateTo\" value=\"now\" constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\"></td>\r\n\t             <td width=\"4%\"><label for=\"name\">Index</label> :</td>\r\n\t            <td width=\"16%\"><input\tid=\"mrktIndexSummaryHistoryIndex\" name=\"mrktIndexSummaryHistoryIndex\" \r\n\t\t\t\t\t\t\ttype=\"text\"  style=\"width:163px; float: left;\" autoComplete=\"false\"></input></td>\r\n\t            <td width=\"20%\">\r\n\t\t\t\t\t<button\r\n\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\t\t\tid=\"mrktIndexSumaryHistoryClearBut\">Clear</button>\r\n\t\t\t\t\t<button\r\n\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\t\tid=\"mrktIndexSumaryHistorySearchBut\">Search</button>\r\n\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"printMrktIndexSumaryHistory\"></div>\r\n\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"saveMrktIndexSumaryHistory\"></div>\r\n\t\t\t\t\t\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t        <tr>\r\n\t        \t<td colspan=\"7\" id=\"indexSummaryLblCompanyHistory\">\r\n        \t\t\t<hr size=\"1px\"></hr>\r\n        \t\t\t<div id=\"indexSummaryReportHeaderHistory\" >\r\n\t\t        \t\t<table width=\"100%\" cellspacing='0'>\r\n\t\t        \t\t\t<tr>\r\n\t\t        \t\t\t\t<td width=\"25%\">\r\n\t\t        \t\t\t\t\t<div id=\"indexSummaryHistoryReportHeaderframe\"></div>\r\n\t\t        \t\t\t\t</td>\r\n\t\t        \t\t\t\t<td width=\"55%\" align=\"center\" rowspan=\"2\">\r\n\t\t        \t\t\t\t\t<strong><font size=\"4\">Market Index History Summary</font></strong>\r\n\t\t        \t\t\t\t</td>\r\n\t\t        \t\t\t\t<td align=\"right\">\r\n\t\t        \t\t\t\t\t<div id=\"indexSummaryBrokerLogo\" align=\"center\">\r\n\t\t        \t\t\t\t\t\t<img src=\"theme/html/white/atrad/images/logoForReports.png\" width=\"100\" height=\"28\" style=\"margin-top:2px\">\r\n\t\t        \t\t\t\t\t</div>\r\n\t\t        \t\t\t\t\t<div align=\"center\">\r\n\t\t        \t\t\t\t\t\t<a href=\"http://www.atrad.lk\"><font style=\"color: gray;\" size=\"2\">www.atrad.lk</font></a>\r\n\t\t        \t\t\t\t\t</div>\r\n\t\t        \t\t\t\t</td>\r\n\t\t        \t\t\t</tr>\r\n\t\t        \t\t</table>\r\n\t        \t\t</div>\r\n\t        \t</td>\r\n\t        </tr>\r\n\t        <tr>\r\n\t        \t<td colspan=\"7\">\r\n\t        \t\t<table width=\"100%\" cellspacing='0'>\r\n\t        \t\t\t<tr>\r\n\t\t        \t\t\t<td width=\"4%\">\r\n\t\t        \t\t\t\t<label for=\"name\"><font face=\"tahoma\" size='2'>Exchange  </font></label>\r\n\t\t        \t\t\t\t<input type=\"hidden\" id=\"mrktIndexHistoryBrokerId\">\r\n\t\t        \t\t\t</td>\r\n\t\t        \t\t\t<td width=\"1%\">: </td>\r\n\t\t        \t\t\t<td width=\"4%\" id=\"mrktIndexLblHistoryExchnge\" align=\"left\"><font face=\"tahoma\" size='2'></font></td>\r\n\t\t        \t\t\t<td width=\"4%\"></td>\r\n\t\t        \t\t\t<td width=\"8%\">\r\n\t\t        \t\t\t\t<label for=\"name\"><font face=\"tahoma\" size='2'>Date From </font></label>\r\n\t\t        \t\t\t</td>\r\n\t\t        \t\t\t<td width=\"1%\">:</td>\r\n\t\t        \t\t\t<td width=\"10%\" id=\"mrktIndexHistoryLblDate\" align=\"left\"><font face=\"tahoma\" size='2'></font></td>\r\n\t\t        \t\t\t<td width=\"3%\">\r\n\t\t        \t\t\t\t<label for=\"name\"><font face=\"tahoma\" size='2'>To  </font></label>\r\n\t\t        \t\t\t</td>\r\n\t\t        \t\t\t<td width=\"1%\">:</td>\r\n\t\t        \t\t\t<td id=\"mrktIndexHistoryLblDateTo\" align=\"left\"><font face=\"tahoma\" size='2'></font></td>\r\n\t        \t\t\t</tr>\r\n\t        \t\t</table>\r\n\t        \t</td>\r\n\t        </tr>\r\n\t        <tr>\r\n\t        \t<td colspan=\"7\" height=\"3px\"></td>\r\n\t        </tr>\r\n\t    </table>\r\n\t\t<div id=\"mrktIndexHistoryScrolling\" class=\"mrktIndexHistoryScrolling\">\r\n\t\t\t<div class=\"gridBg\" id=\"mrktIndexSummaryHistoryDataGrid\" style=\"width:830px;height:465px\" dojoType=\"dijit.layout.ContentPane\">      \r\n\t\t\t</div>\t\t\t\r\n\t\t</div>\r\n\t\t<div class=\"popFooter\">\r\n\t\t\t<table width=\"98%\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td align=\"right\">\r\n\t\t\t\t\t\t<button data-dojo-type=\"dijit.form.Button\" id=\"butmrktIndexHistoryClose\">Close</button>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t</tr>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n"
