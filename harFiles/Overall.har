            "mimeType": "text/html",
            "text": "<div id=\"advisorClientInquiry\" >\r\n\t<div class=\"functionBar\">\r\n\t\t<div style=\"float: left;\">\r\n\t\t\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"450px\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td id=\"advisorClientInqrylblMappedCdsAcc\" style=\"width:20%;\" atLangID=\"javascriptAdvisorClientInquirylblMappedCdsAcc\">Mapped CDS Acc No</td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td>\t\r\n\t\t\t\t\t\t<select id=\"advisorClientInqryMappedCdsAcc\" name=\"advisorClientInqryMappedCdsAcc\" dojoType=\"dijit.form.ComboBox\" style=\"width:240px\"></select>\t\t\t\t\t\t\r\n\t\t\t\t\t</td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td colspan=\"3\" height=\"5px\"></td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td id=\"advisorClientInqrylblAdvisor\" style=\"width:20%;\" atLangID=\"javascriptAdvisorClientInquiryAdvisor\">Advisor Code</td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td>\t<select id=\"advisorClientInqryAdvisorCode\" name=\"advisorClientInqryAdvisorCode\" dojoType=\"dijit.form.ComboBox\" ></select> </td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td colspan=\"3\" height=\"5px\"></td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td id=\"advisorClientInqrylblCustodial\" style=\"width:20%;\" atLangID=\"javascriptAdvisorClientInquiryCustodial\">Custodial</td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td>\t\r\n\t\t\t\t\t\t<select id=\"advisorClientInqryCustodial\" name=\"advisorClientInqryCustodial\" dojoType=\"dijit.form.Select\" style=\"width:60px\">\r\n\t\t\t\t\t\t\t<option value=\"ALL\">ALL</option>\r\n\t\t\t\t\t\t\t<option value=\"Yes\">YES</option>\r\n\t\t\t\t\t\t\t<option value=\"No\">NO</option>\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t </td>\r\n\t\t\t\t</tr>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\t\t<table>\r\n\t\t\t<tr>\r\n\t\t\t\t\t<td id=\"advisorClientInqrylblALLCdsAcc\" style=\"width:20%;\">\r\n\t\t\t\t\t\t<input id=\"advCDSManualcheck\" dojotype=\"dijit.form.CheckBox\" name=\"advCDSManualcheck\" value=\"on\"/> \r\n\t\t\t\t\t\t<span atLangID=\"javascriptAdvisorClientInquirylblAllCdsAcc\"> Other CDS Acc No</span>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td>\t\r\n\t\t\t\t\t\t<select id=\"advisorClientInqryALLCdsAcc\" name=\"advisorClientInqryALLCdsAcc\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" type=\"text\" style=\"width:240px\"></select> \r\n\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" id=\"btnAdvClientGo\"><span atLangID=\"javascriptGo\">Go</span></button> \r\n\t\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"3\" height=\"5px\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td id=\"advisorClientInqrylblName\" style=\"width:20%;\" atLangID=\"javascriptAdvisorClientInquiryName\">Name</td>\r\n\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t<td>\t\r\n\t\t\t\t\t<input id=\"advisorClientInqryClientName\" name=\"advisorClientInqryClientName\" dojoType=\"dijit.form.TextBox\" style=\"width:240px\"/>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"3\" height=\"5px\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td id=\"advisorClientInqrylblTel\" style=\"width:20%;\" atLangID=\"javascriptAdvisorClientInquiryTel\">Tel No</td>\r\n\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t<td>\t\r\n\t\t\t\t\t<input id=\"advisorClientInqryTel\" name=\"advisorClientInqryTel\" dojoType=\"dijit.form.TextBox\" />\r\n\t\t\t\t\t<span id=\"advisorClientInquiryRefreshCursor\"></span>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"3\" align=\"right\">\r\n\t\t\t\t\t<button dojoType=\"dijit.form.Button\"  class=\"advisorClientInquirySearchBtn\" type=\"submit\" id=\"btnAdvisorClientInquirySearch\"><span atLangID=\"javascriptSearchBtnText\">Search</span></button>\r\n\t\t\t\t\t<button dojoType=\"dijit.form.Button\"  class=\"advisorClientInquirySearchBtn\" type=\"button\" id=\"btnAdvisorClientInquiryClear\"><span atLangID=\"javascriptClearBtnText\">Clear</span></button>\r\n\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"printAdvisorClientInquiry\"></div>\r\n\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"saveAdvisorClientInquiry\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</div>\r\n    <div class=\"popupBody\">\r\n\t\t<div id=\"advisorClientInquiryDatagrid\" dojoType=\"dijit.layout.ContentPane\"></div> \r\n\t</div>\r\n\t<div class=\"popFooter\">\r\n\t\t<table>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"250\">\r\n\t\t\t\t</td>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div class=\"inline\">\r\n\t\t\t\t\t\t<span id=\"advisorClientInqryPreBtnContainer\">\r\n\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\" \tid=\"advisorClientInqryBtnPreviousPage\" atLangID=\"javascriptMarketTimeSalePrevButLbl\">Previous</button></span>\r\n\t\t\t\t\t\t\t<span id=\"advisorClientInqryLblNavigation\"  atLangID=\"javascriptClientInquiryNavigation\">Go to:</span><input id =\"advisorClientInqrySpnPageNoBox\" required=\"true\"  name=\"spnPageNoBox\" dojoType=\"dijit.form.NumberSpinner\" style=\"width: 100px;\" value= '1', constraints=\"{max:1,min:1}\" /><span><span id=\"advisorClientInqryLblOfText\"  atLangID=\"javascriptMarketTimeSaleOfText\">of</span><span id=\"advisorClientInqryLblPageNo\" >1</span><button\r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"advisorClientInqryBtnGo\" atLangID=\"javascriptMarketTimeSaleGoButLbl\">Go</button></span><span id=\"advisorClientInqryNextBtnContainer\"><button\r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"advisorClientInqryBtnNextPage\" atLangID=\"javascriptMarketTimeSaleNextButLbl\">Next</button>\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"195\">\r\n\t\t\t\t</td>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\t id=\"butAdvisorClientInquiryClose\">&nbsp;Close&nbsp;</button>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</