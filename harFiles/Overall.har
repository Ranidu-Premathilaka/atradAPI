            "size": 1416,
            "mimeType": "text/html",
            "text": "<div id=\"bloomBergOM\" >\r\n<div class=\"functionBar\">\r\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n<tr>\r\n<td width=\"5px\"></td>\r\n<td width=\"50px\">Exchange</td>\r\n<td>:</td>\r\n<td><input\tid=\"bbExchangeddl\" name=\"ddlExchange\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:63px; float: left;\" autoComplete=\"false\"></input></td>\r\n\r\n<td width=\"5px\"></td>\r\n<td width=\"50\"><span atLangID=\"javascriptPortfolioSecurity\">Security ID</span></td>\r\n<td>:</td>\r\n<td><input\tid=\"bbSecurityddl\" name=\"ddlSecurity\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:163px; float: left;\" autoComplete=\"false\"></input></td>\r\n<td width=\"5px\"></td>\r\n<td width=\"90px\">Client Account</span></td>\r\n<td>:</td>\r\n<td colspan=\"5\"><input\tid=\"bbClientId\" name=\"ddlClientID\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:155px; float: left;\" autoComplete=\"false\"></input></td>\r\n<td width=\"5px\"></td>\r\n<td>\r\n<button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\tid=\"bbSearchBtn\">Search</button>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td height=\"3px\"></td>\r\n</tr>\r\n\r\n<tr>\r\n<td height=\"3px\" ></td>\r\n</tr>\r\n</table>  \r\n</div>\r\n<div style=\"padding-bottom: 0px\"></div>\r\n<div class=\"popupBody\">\r\n<div id=\"grdBbData\" dojoType=\"dijit.layout.ContentPane\"\r\n\tclass=\"bbGridContainer\">\r\n\t</div>\r\n</div>\r\n<div class=\"popFooter\">\r\n\r\n<button dojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t id=\"butBbClose\">&nbsp;Close&nbsp;</button></div>\r\n</div>\r\n</div>"
          },
