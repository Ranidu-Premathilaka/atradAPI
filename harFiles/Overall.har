          "content": {
            "size": 22310,
            "mimeType": "text/html",
            "text": " \r\n<div id = \"_atrad_buyWatchPane\" class=\"buy\">\r\n  <div id = \"_atrad_functionBar\" class=\"debtFunctionBar\">\r\n  \r\n    <table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" >\r\n    <tr>\r\n      <td width=\"20%\">\r\n      <table  border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n        <tr>\r\n          <td width=\"60\" align=\"left\"><div id=\"_atrad_lblBestBid\" atLangID=\"javascriptBuyOrderBestBid\" ></div></td>\r\n          <td width=\"10\" align=\"left\">:</td>\r\n          <td width=\"80\" align=\"left\" class=\"fontBold\"  id=\"_atrad_bestBidVal\"> </td>\r\n        </tr>\r\n      </table></td>\r\n      \r\n      <td width=\"20%\">\r\n      <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n        <tr>\r\n          <td width=\"50\" align=\"left\"><div id=\"_atrad_lblBestAsk\" atLangID=\"javascriptBuyOrderBestAsk\"> </div></td>\r\n          <td width=\"10\" align=\"left\">:</td>\r\n          <td width=\"80\" align=\"left\" class=\"fontBold\" id=\"_atrad_bestAskVal\"> </td>\r\n        </tr>\r\n      </table></td>\r\n      \r\n      <td width=\"20%\">\r\n      <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n        <tr>\r\n          <td width=\"65\" align=\"left\"><div id=\"_atrad_lblLastTrade\" atLangID=\"javascriptBuyOrderLastTrade\"> </div></td>\r\n          <td width=\"10\" align=\"center\">:</td>\r\n          <td width=\"80\" align=\"left\" class=\"fontBold\" id=\"_atrad_lastTradeVal\"> </td>\r\n        </tr>\r\n      </table></td>\r\n    \r\n      <td width=\"20%\">\r\n      <table  border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n        <tr>\r\n          <td width=\"91\" align=\"left\"><div id=\"_atrad_lblHigh\" atLangID=\"javascriptBuyOrderHigh\"></div></td>\r\n          <td width=\"10\" align=\"left\">:</td>\r\n          <td width=\"80\" align=\"left\" class=\"fontBold\" id=\"_atrad_highVal\"> </td>\r\n        </tr>\r\n      </table></td>\r\n      <td width=\"20%\">\r\n      <table  border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n        <tr>\r\n          <td width=\"50\" align=\"left\"><div id=\"_atrad_lblLow\" atLangID=\"javascriptBuyOrderLow\"> </div> </td>\r\n          <td width=\"10\" align=\"left\">:</td>\r\n          <td width=\"80\" align=\"left\" class=\"fontBold\" id=\"_atrad_lowVal\"> </td>\r\n        </tr>\r\n      </table></td>\r\n      \r\n    </tr>\r\n    <tr>\r\n      <td height=\"5\" colspan=\"5\"></td>\r\n      </tr>\r\n    <tr>\r\n      <td width=\"20%\">\r\n      <table  border=\"0\" cellspacing=\"0\" cellpadding=\"0\" >\r\n        <tr>\r\n          <td width=\"60\" align=\"left\"><div id=\"_atrad_lblAvgPrice\" atLangID=\"javascriptBuyOrderAveragePrice\"></div></td>\r\n          <td width=\"10\" align=\"left\">:</td>\r\n          <td width=\"80\" align=\"left\" class=\"fontBold\" id=\"_atrad_avgPriceVal\"></td>\r\n        </tr>\r\n      </table></td>\r\n      \r\n      <td width=\"20%\">\r\n      <table  border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n        <tr>\r\n          <td width=\"48\" align=\"left\"><div id=\"_atrad_lblTotVolume\" atLangID=\"javascriptBuyOrderTotVolume\"> </div></td>\r\n          <td width=\"10\" align=\"left\">:</td>\r\n          <td width=\"80\" align=\"left\" class=\"fontBold\" id=\"_atrad_totVolumeVal\"></td>\r\n        </tr>\r\n      </table></td>\r\n      \r\n      <td width=\"20%\">\r\n      <table  border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n        <tr>\r\n          <td width=\"61\" align=\"left\"><div id=\"_atrad_lblTotTurnover\" atLangID=\"javascriptBuyOrderTotTurnover\"> </div></td>\r\n          <td width=\"10\" align=\"left\">:</td>\r\n          <td width=\"80\" align=\"left\" id=\"_atrad_totTurnoverVal\" class=\"fontBold\"> </td>\r\n        </tr>\r\n      </table></td>\r\n      <td width=\"20%\">\r\n      <table  border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n        <tr>\r\n          <td width=\"80\" align=\"left\"><div id=\"_atrad_lblNetChange\" a