          "content": {
            "size": 4320,
            "mimeType": "text/html",
            "text": "<div id=\"marketTS\" >\r\n<div class=\"functionBar blueText\">\r\n<table>\r\n<tr>\r\n<td width=\"50\"><span atLangID=\"javascriptPortfolioSecurity\">Security</span></td>\r\n<td>:</td>\r\n<td><input\tid=\"mtsSecurityddl\" name=\"ddlSecurity\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:163px; float: left;\" autoComplete=\"false\"></input></td>\r\n<td width=\"40px\"></td>\r\n<td><span atLangID=\"javascriptTime\">Time</span>-</td>\r\n<td width=\"40px\" align=\"right\"><span atLangID=\"javascriptFrom\">From</span></td>\r\n<td>:</td>\r\n<td width=\"95\"><input id=\"txtMtsFrom\"   style=\"width: 95px\" regExp=\"\\b([0-1]{1}[0-9]{1}|[2]{1}[0-3]{1})\\:[0-5]{1}[0-9]{1}\" required=\"false\" invalidMessage=\"Invalid time format. Format H24:MM\" dojoType=\"dijit.form.ValidationTextBox\" name=\"txtMtsFrom\"/></td>\r\n<td></td>\r\n<td><span atLangID=\"javascriptaccountStatementDateTo\">To</span></td>\r\n<td>:</td>\r\n<td width=\"95\"><input id=\"txtMtsto\"   style=\"width: 95px\" regExp=\"\\b([0-1]{1}[0-9]{1}|[2]{1}[0-3]{1})\\:[0-5]{1}[0-9]{1}\" required=\"false\" invalidMessage=\"Invalid time format. Format H24:MM\" dojoType=\"dijit.form.ValidationTextBox\" name=\"txtMtsto\"/></td>\r\n</tr>\r\n<tr height=\"5\">\r\n<td></td>\r\n<td></td>\r\n<td></td>\r\n<td></td>\r\n<td></td>\r\n<td></td>\r\n<td></td>\r\n<td width=\"100\">(Format H24:MM)</td>\r\n<td></td>\r\n<td></td>\r\n<td></td>\r\n<td width=\"100\">(Format H24:MM)</td>\r\n</tr>\r\n</table>\r\n\r\n<table>\r\n<tr>\r\n<td width=\"50\"><span atLangID=\"javascriptBuyOrderBoard\">Board</span> </td>\r\n<td>:</td>\r\n<td><input dojoType=\"dijit.form.RadioButton\" id=\"mtsBoardAll\" name=\"b\"  checked=\"checked\" value=\"all\" type=\"radio\" />\r\n  <label for=\"val1\"> All </label></td>\r\n<td><input dojoType=\"dijit.form.RadioButton\" id=\"mtsBoardRegular\" name=\"b\"  value=\"1\" type=\"radio\" />\r\n  <label for=\"val1\"> Regular </label></td>\r\n<td><input dojoType=\"dijit.form.RadioButton\" id=\"mtsBoardCross\" name=\"b\"  value=\"4\" type=\"radio\" />\r\n  <label for=\"val1\"> Crossing</label></td>\r\n<td><input dojoType=\"dijit.form.RadioButton\" id=\"mtsBoardAuction\" name=\"b\"  value=\"7\" type=\"radio\" />\r\n  <label for=\"val1\"> Auction</label></td>\r\n  <td width=\"50\"></td>\r\n  <td>Asset</td>\r\n  <td>:</td>\r\n  <td><select id=\"mtsAsset\" name=\"mtsAsset\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" style=\"width:100px; \" >\r\n     \t\t <option value=\"1\">Equity</option>\r\n         <option value=\"2\">Bill</option>\r\n        <option value=\"3\">Bond</option>    \t\t\r\n       \t\t  </select></td>\r\n</tr>\r\n</table>\r\n\r\n<table>\r\n<tr>\r\n<td><span id=\"lblLstRefTime\"  atLangID=\"javascriptMarketTimeSaleRefreshTime\" class=\"fontBold\">Last Refresh Time : </span></td>\r\n\t\t\t<td width=\"260\">\r\n\t\t\t<span\r\n\t\t\tid=\"lblLstRefreshTime\"></span>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<span id=\"imgmtsRefreshCursor\" class=\"mtsRefreshCursor\"></span>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\tid=\"mtsSearchBut\">Search</button>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<button dojoType=\"dijit.form.Button\"  id=\"btnMtsClear\" ><span atLangID=\"javascriptClearBtnText\">Clear</span></button>\r\n\t\t\t\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\tid=\"butRefreshBut\">Refresh</button>\r\n\t\t\t</td>\r\n\t\t\t\r\n</tr>\r\n</table>\r\n\r\n\r\n  \r\n</div>\r\n<div style=\"padding-bottom: 0px\"></div>\r\n<div class=\"popupBody TableCol\">\r\n<div id=\"grdmtsData\" dojoType=\"dijit.layout.ContentPane\"\r\n\tclass=\"mtsGridContainer\">\r\n\t</div>\r\n</div>\r\n<div class=\"popFooter\">\r\n<div class=\"inline\"><span id=\"preBtnContainer\" ><button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"btnPreviousPageBut\" atLangID=\"javascriptMarketTimeSalePrevButLbl\">Previous</button></span>\r\n\t\t\t\t<span id=\"lblNavigation\"  atLangID=\"javascriptMarketTimeSaleNavigation\">Go to:</span><input id =\"spnPageNoBox\" required=\"true\"  name=\"spnPageNoBox\" dojoType=\"dijit.form.NumberSpinner\" style=\"width: 100px;\" value= '1', constraints=\"{min:1}\" /><span><span id=\"lblOfText\"  atLangID=\"javascriptMarketTimeSaleOfText\">of</span><span id=\"lblPageNo\" >1</span><button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"btnGoBut\" atLangID=\"javascriptMarketTimeSaleGoButLbl\">Go</button></span><span id=\"nextBtnContainer\"><button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"btnNextPageBut\" atLangID=\"javascriptMarketTimeSaleNextButLbl\">Next</button></span></div>\r\n\r\n<div >\r\n<button dojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t id=\"butmtsClose\">&nbsp;Close&nbsp;</button></div>\r\n</div>\r\n</div>"
