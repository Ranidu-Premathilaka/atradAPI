            "text": "<div id=\"avgCostCalculator\">\r\n\t\t<div class=\"functionBar costCalculatorFunctionBar\">\r\n\t\t\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td width=\"40\"><span atLangID=\"javascriptCdsAccnt\">CDS Account</span></td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td width=\"90\">\r\n\t\t\t\t\t\t<select id=\"costCalcCdsAccntddl\" name=\"costCalcCdsAccntddl\" dojoType=\"dijit.form.ComboBox\" trim=\"true\" autoComplete=\"false\" style=\"width:250px;\" >\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t\t<td width=\"25\"></td>\r\n\t\t\t\t\t<td width=\"45\"><span atLangID=\"javascriptSymbol\">Security</span></td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td width=\"90\">\r\n\t\t\t\t\t\t<select id=\"costCalcSymbolddl\" name=\"costCalcSymbolddl\" dojoType=\"dijit.form.ComboBox\" trim=\"true\" autoComplete=\"false\" style=\"width:230px;\" >\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t\t<td></td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td colspan=\"7\" height=\"7\">\r\n\t\t\t\t\t</td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td colspan=\"7\">\r\n\t\t\t\t\t\t<table width=\"100%\">\r\n\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t<td colspan=\"4\">\r\n\t\t\t\t\t\t\t\t\t<table width=\"100%\">\r\n\t\t\t\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t\t\t\t<td width=\"90\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t<span atLangID=\"javascriptCurntAvgPrice\">Current Average Price</span><span class=\"redText\">*</span>\r\n\t\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<input name=\"costCalcSpnCurntAvgPrice\" id=\"costCalcSpnCurntAvgPrice\"  required=\"true\" dojoType=\"dijit.form.NumberSpinner\" \r\n\t\t\t\t\t\t\t\t    \t  \t\t\t\tstyle=\"width:90px\"  value= '0.00', constraints=\"{min:0.00}\" smallDelta=\".10\"/>\r\n\t\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t\t<td width=\"35\"></td>\r\n\t\t\t\t\t\t\t\t\t\t\t<td 