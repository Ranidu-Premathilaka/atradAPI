            "text": "<div id=\"maApproveDtl\">\r\n\t\t<div class=\"functionBar maApproveDtlFunctionBar\">\r\n\t\t\t\t \r\n\t\t\t\t \t\t<table width=\"100%\" >\r\n\t\t\t\t\t\t\t <tr>\r\n\t\t\t\t\t\t\t <td colspan=\"3\" >\r\n\t\t\t\t\t\t\t <table width=\"100%\">\r\n\t\t\t\t\t\t\t <tr>\r\n\t\t\t\t\t\t\t \t<td width=\"20%\" align=\"left\" valign=\"middle\" id=\"lblMADCDS\" >Client A/C</td>\r\n\t\t\t\t\t\t      \t<td width=\"1%\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t      \t<td width=\"40%\" align=\"left\" valign=\"middle\" id=\"txtMADCDS\"></td>\r\n\t\t\t\t\t\t      \t<td width=\"20%\" align=\"left\" valign=\"middle\" id=\"lblMADAdv\" >Advisor Code</td>\r\n\t\t\t\t\t\t      \t<td width=\"1%\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t      \t<td width=\"18%\" align=\"left\" valign=\"middle\" id=\"txtMADAdvCode\"></td>\r\n\t\t\t\t\t\t      \t</tr>\r\n\t\t\t\t\t\t      \t</table>\r\n\t\t\t\t\t\t      \t</td>\r\n\t\t\t\t\t\t\t </tr>\r\n\t\t\t\t\t\t\t  <tr>\r\n\t\t\t\t\t\t\t\t<td height=\"5\" colspan=\"7\" align=\"left\" valign=\"bottom\"><hr /></td>\r\n\t\t\t\t\t\t\t </tr>\r\n\t\t\t\t\t\t\t <tr>\r\n\t\t\t\t\t\t\t \t<td align=\"left\" width=\"50%\" valign=\"middle\" id=\"lblAccSumaryTMvaluePortfolio\" atLangID=\"javascriptTotalMvaluePortfolio\">Total Market Value of the Portfolio</td>\r\n\t\t\t\t\t\t      \t<td align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t      \t<td align=\"left\" valign=\"middle\" id=\"txtMADTMvaluePortfolio\"></td> \r\n\t\t\t\t\t\t\t </tr>\r\n\t\t\t\t\t\t\t <tr>\r\n\t\t\t\t\t\t\t\t<td height=\"5\" colspan=\"3\" ></td>\r\n\t\t\t\t\t\t\t </tr>\r\n\t\t\t\t\t\t\t <tr>\r\n\t\t\t\t\t\t\t \t<td align=\"left\" valign=\"middle\" id=\"lblAccSumaryCashBalance\" atLangID=\"javascriptCashBalance\">Account Balance</td>\r\n\t\t\t\t\t\t      \t<td align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t\t\t      \t<td align=\"left\" valign=\"middle\" id=\"txtMADCashBalance\"></td> \r\n\t\t\t\t\t\t\t </tr>\r\n\t\t\t\t\t\t\t <tr>\r\n\t\