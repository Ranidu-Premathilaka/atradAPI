          "content": {
            "size": 7277,
            "mimeType": "text/html",
            "text": "<div id=\"analysisFlotPane\">\r\n\r\n<div class=\"blueText inline\">\r\n\r\n<div data-dojo-type=\"dijit.Dialog\" id=\"analysisTimeDialog\">\r\n    <table class=\"analysisDialog\">\r\n        <tr>\r\n            <td><label for=\"name\">Time Period:</label></td>\r\n            <td><input data-dojo-type=\"dijit.form.NumberSpinner\" name=\"name\" id=\"analysisTimePeriod\" data-dojo-props=\"smallDelta:1, constraints:{min:1,max:100,places:0}\" ></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <div class=\"analysisDialogPaneActionBar\">\r\n        <button data-dojo-type=\"dijit.form.Button\" type=\"submit\" id=\"analysisTmOk\">OK</button>\r\n        <button data-dojo-type=\"dijit.form.Button\" type=\"button\" id=\"analysisTmCancel\">Cancel</button>\r\n    </div>\r\n</div>\r\n\r\n<div data-dojo-type=\"dijit.Dialog\" id=\"bbTimeDialog\">\r\n    <table class=\"bbDialog\">\r\n        <tr>\r\n        <td><label for=\"name\">Method:</label></td>        \r\n        \t<td>\r\n        \t\t<select dojoType=\"dijit.form.ComboBox\" id=\"bbMethod\" name=\"bbCombo\">\r\n    \t\t\t\t<option selected>Simple</option>\r\n    \t\t\t\t<option>Exponential</option>\r\n  \t\t\t\t\t<option>Triangular </option>\r\n  \t\t\t\t\t<option>Variable </option>\r\n  \t\t\t\t\t<option>Weighted </option>\r\n\t\t\t\t</select>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n        <tr>\r\n        </tr>\r\n        <tr>        \t\r\n        \t<td><label for=\"name\">Time Period:</label></td>\r\n            <td><input data-dojo-type=\"dijit.form.NumberSpinner\" name=\"name\" id=\"bbTimePeriod\" data-dojo-props=\"smallDelta:1, constraints:{min:1,max:100,places:0}\" ></td>\r\n        </tr><tr></tr><tr>\r\n        \t<td><label for=\"name\">Deviation:</label></td>\r\n            <td><input data-dojo-type=\"dijit.form.NumberSpinner\" name=\"name\" id=\"bbDevaition\" data-dojo-props=\"smallDelta:0.1, constraints:{min:1,max:10, places:1}\" ></td>\r\n        </tr>\r\n     </table>\r\n\r\n    <div class=\"analysisDialogPaneActionBar\">\r\n        <button data-dojo-type=\"dijit.form.Button\" type=\"submit\" id=\"bbTmOk\">OK</button>\r\n        <button data-dojo-type=\"dijit.form.Button\" type=\"button\" id=\"bbTmCancel\">Cancel</button>\r\n    </div>\r\n</div>\r\n\r\n<div data-dojo-type=\"dijit.Dialog\" id=\"macdTimeDialog\">\r\n\t<table class=\"macdDialog\">\r\n\t\t<tr>\r\n\t\t\t<td><label for=\"name\">Time Period:</td>\r\n\t\t\t<td><input data-dojo-type=\"dijit.form.NumberSpinner\" name=\"name\" id=\"macdLineTimePeriod1\" data-dojo-props=\"smallDelta:1, constraints:{min:1,max:100,places:0}\" style=\"width:100px\"></td>\r\n\t\t\t<td><label for=\"name\">To</td>\r\n\t\t\t<td><input data-dojo-type=\"dijit.form.NumberSpinner\" name=\"name\" id=\"macdLineTimePeriod2\" data-dojo-props=\"smallDelta:1, constraints:{min:1,max:100,places:0}\"></td>\r\n\t\t\t<td><label for=\"name\">Time Period:</td>\r\n\t\t\t<td><input data-dojo-type=\"dijit.form.NumberSpinner\" name=\"name\" id=\"macdMATimePeriods\" data-dojo-props=\"smallDelta:1, constraints:{min:1,max:100,places:0}\"></td>\t\t\t\r\n\t\t</tr>\r\n\t</table>\t\r\n\t<div class=\"analysisDialogPaneActionBar\">\r\n        <button data-dojo-type=\"dijit.form.Button\" type=\"submit\" id=\"macdTmOk\">OK</button>\r\n        <button data-dojo-type=\"dijit.form.Button\" type=\"button\" id=\"macdTmCancel\">Cancel</button>\r\n    </div>\r\n</div>\r\n\r\n<table>\r\n<tr>        \r\n\t\t\t<td width=\"55\" height=\"22\" align=\"left\" valign=\"middle\" class=\"boldText\">Security</td>\r\n      \t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n      \t\t<td align=\"left\" valign=\"middle\"><input type=\"text\" name=\"state\" value=\"\"  trim=\"true\" id=\"txtsecurityListAnalysis\" propercase=\"true\" style=\"width:134px\"></td>\r\n      \t\t<td width=\"20\"></td>             \r\n\r\n\t\t\t<td width=\"20\"></td>\r\n\t\t\t<td align=\"left\" valign=\"middle\" class=\"blueText boldText\">Line Type</td>\r\n            <td align=\"left\" valign=\"middle\" class=\"blueText\">:</td>\r\n            <td align=\"left\" valign=\"middle\" class=\"blueText\">\r\n             <select name=\"indicatorAnalysis\" id=\"indicatorAnalysis\" dojoType=\"dijit.form.Select\" type=\"text\" style=\"width:80px\">\r\n                  \t\t<option value=\"Line\" id=\"menuLine\"> Line </option>\r\n                        <option value=\"Candlestick\" id=\"menucandleStick\"> Candlestick </option>\r\n                        <option value=\"OHLC\" id=\"menuOhlc\"> OHLC </option>\r\n                        <option value=\"Spline\" id=\"menuSpline\"> Spline </option>\r\n                        <option value=\"Area\" id=\"menuArea\"> Area </option>\r\n                        <option value=\"Step\" id=\"menuStepLine\"> Step Line </option>\r\n                        <option value=\"Point\" id=\"menuPointsOnly\"> Point Markers </option>\r\n             </select>\r\n             </td>\r\n             <td width=\"20\"></td>\r\n             <td> \r\n             <div dojoType=\"dijit.MenuBar\" id=\"indctrMenu\">\r\n             \t<div dojoType=\"dijit.PopupMenuBarItem\" id=\"indctrPopupMenu\" disabled=\"false\">\r\n             \t\t<span>Indicator</span>\r\n             \t\t<div dojoType=\"dijit.Menu\">\r\n             \t\t\t<div dojoType=\"dijit.MenuItem\" id=\"bllngrBnds\"> Bollinger Bands</div>\r\n             \t\t\t<div dojoType=\"dijit.MenuItem\" id=\"menuMacd\"> MACD</div>\r\n             \t\t\t<div dojoType=\"dijit.PopupMenuItem\"><span> Moving Average</span>\r\n             \t\t\t <div id=\"maMenu\" data-dojo-type=\"dijit.Menu\" >\r\n             \t\t\t\t<div dojoType=\"dijit.MenuItem\" id=\"simple\"> Simple</div>\r\n             \t\t\t\t<div dojoType=\"dijit.MenuItem\" id=\"expntl\"> Exponential</div>\r\n             \t\t\t\t<div dojoType=\"dijit.MenuItem\" id=\"trnglr\"> Triangular</div>\r\n             \t\t\t\t<div dojoType=\"dijit.MenuItem\" id=\"vrbl\"> Variable</div>\r\n             \t\t\t\t<div dojoType=\"dijit.MenuItem\" id=\"wghtd\"> Weighted</div>             \t\t\t\r\n             \t\t\t </div>\r\n             \t\t\t</div>\r\n             \t\t\t<div dojoType=\"dijit.MenuItem\" id=\"rsi\">RSI</div>\r\n<!--             \t\t\t<div dojoType=\"dijit.MenuItem\" id=\"aroon\"> AROON</div>-->\r\n             \t\t</div>\r\n             \t</div>\r\n             </div>             \r\n   \t\t\t</td>\r\n   \t\t\t<td width=\"20\"></td>\r\n   \t\t\t<td>\r\n   \t\t\t    <div dojoType=\"dijit.form.Button\" id=\"volumeButton\" label=\"Volume\"></div>\t\r\n   \t\t\t</td>\r\n   \t\t\t<td align=\"left\" valign=\"middle\">&nbsp;&nbsp;</td>\r\n   \t\t\t<td align=\"left\" valign=\"middle\" id=\"anlssTmprdLbl\">Select Time Period :</td>\r\n   \t\t\t<td align=\"left\" valign=\"middle\">&nbsp;</td>\r\n   \t\t\t<td align=\"left\" valign=\"middle\" id=\"lblFromDate\" atLangID=\"javascriptAnalysisFromDate\">From Date</td>\r\n   \t\t\t<td align=\"left\" valign=\"middle\">&nbsp;</td>\r\n   \t\t\t<td>\r\n   \t\t\t\t<input id=\"anlssFrmDate\" name=\"fromDate\" type=\"text\" dojoType=\"dijit.form.DateTextBox\"  constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\" >\r\n   \t\t\t</td>\r\n   \t\t\t<td align=\"left\" valign=\"middle\">&nbsp;</td>\r\n   \t\t\t<td align=\"left\" valign=\"middle\" id=\"lblToDate\" atLangID=\"javascriptAnalysisToDate\">To Date</td>\r\n   \t\t\t<td align=\"left\" valign=\"middle\">&nbsp;</td>\r\n   \t\t\t<td>\r\n   \t\t\t\t<input id=\"anlssToDate\" name=\"toDate\" type=\"text\" dojoType=\"dijit.form.DateTextBox\"  constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\" >\r\n   \t\t\t</td>\r\n   \t\t\t<td></td>\r\n</tr>\r\n</table>\r\n<div id=\"statRefreshCursorAnalysis\" style=\"height:30px; text-align:right; width:30px; padding:8px \" class=\"inline\"></div>\r\n</div>\r\n\r\n<div id=\"containersAnalysis\"  style=\"min-width: 500px\"></div>\r\n<div class=\"popFooter2\"><button id=\"btnAnlsClose\" data-dojo-type=\"dijit.form.Button\" >Close</button></div>\r\n\r\n<!--<button data-dojo-type=\"dijit.form.Button\" id=\"btnShowDlg\" type=\"button\" >-->\r\n<!--    Show me!-->\r\n<!--</button>-->\r\n\r\n<div class=\"clear\"></div>\r\n</div>\t\r\n\r\n\r\n"
