            "text": "<!-- <div style=\"width:16.5%\" class=\"inline ASI\"> -->\r\n\r\n<table>\r\n\t<th style=\"width: 15%; text-align: center;\">\r\n\t\t<div class=\"inline2\">\r\n\t\t\t<button class=\"limeBlueButtonText\" dojoType=\"dijit.form.Button\"\r\n\t\t\t\ttype=\"button\" id=\"btnASI\">\r\n\t\t\t\t<span class=\"limeBlueText inline\" align=\"center\"><strong>ASI</strong></span>\r\n\t\t\t</button>\r\n\t\t</div>\r\n\t</th>\r\n\r\n\t<th>\r\n\t\t<div style=\"width: 1%; float: left; text-align: center\"\r\n\t\t\tclass=\"line-line\">\r\n\t\t\t<div class=\"watchStatSep\"></div>\r\n\t\t</div>\r\n\t</th>\r\n\r\n\t<th style=\"width: 15%; text-align: center;\">\r\n\t\t<div class=\"inline2\">\r\n\t\t\t<button class=\"limeBlueButtonText\" dojoType=\"dijit.form.Button\"\r\n\t\t\t\ttype=\"button\" id=\"btnMPI\">\r\n\t\t\t\t<span class=\"limeBlueText inline\"><strong>S&P SL20</strong></span>\r\n\t\t\t</button>\r\n\t\t</div>\r\n\t</th>\r\n\r\n\t<th>\r\n\t\t<div style=\"width: 1%; float: left; text-align: center\"\r\n\t\t\tclass=\"line-line\">\r\n\t\t\t<div class=\"watchStatSep\"></div>\r\n\t\t</div>\r\n\t</th>\r\n\r\n\t<th style=\"width: 9%; text-align: center;\">\r\n\t\t<div style=\"width: auto;\">\r\n\t\t\t<span class=\"limeBlueText inline2\" id=\"totTurnVal1\"><strong>Turnover</strong></span>\r\n\t\t</div>\r\n\t</th>\r\n\r\n\t<th>\r\n\t\t<div style=\"width: 1%; float: left; text-align: center\"\r\n\t\t\tclass=\"line-line\">\r\n\t\t\t<div class=\"watchStatSep\"></div>\r\n\t\t</div>\r\n\t</th>\r\n\r\n\t<th style=\"width: 9%; text-align: center;\">\r\n\t\t<div style=\"width: auto;\">\r\n\t\t\t<span class=\"limeBlueText inline2\" id=\"totVal1\"><strong>Volume</strong></span>\r\n\t\t</div>\r\n\t</th>\r\n\r\n\t<th>\r\n\t\t<div style=\"width: 1%; float: left; text-align: center\"\r\n\t\t\tclass=\"line-line\">\r\n\t\t\t<div class=\"watchStatSep\"></div>\r\n\t\t</div>\r\n\t</th>\r\n\r\n\t<th style=\"width: 8%; text-align: center;\">\r\n\t\t<div style=\"width: auto;\">\r\n\t\t\t<spa