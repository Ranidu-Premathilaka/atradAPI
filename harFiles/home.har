          "content": {
            "size": 4301,
            "mimeType": "text/html",
            "text": "\r\n<div id=\"chartFlotPane\">\r\n\r\n  <div class=\"left\" style=\"float:left\" >\r\n  <div class=\"functionBar1\">\r\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\" >\r\n    <tr>\r\n      <td width=\"55\" height=\"22\" align=\"left\" valign=\"middle\" class=\"boldText\">Security</td>\r\n      <td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n      <td align=\"left\" valign=\"middle\"><input type=\"text\" name=\"state\" value=\"\"  trim=\"true\" id=\"txtsecurityList\" propercase=\"true\" style=\"width:134px\"></td>\r\n      \r\n      </tr>\r\n    <tr>\r\n      <td height=\"5\" colspan=\"3\" align=\"left\" valign=\"middle\" ></td>\r\n      </tr>\r\n    <tr>\r\n      <td height=\"22\" align=\"left\" valign=\"middle\">&nbsp;</td>\r\n      <td align=\"left\" valign=\"middle\">&nbsp;</td>\r\n      <td align=\"right\" valign=\"middle\"><button data-dojo-type=\"dijit.form.Button\" id=\"btnSecDraw\" >Draw</button>&nbsp;<button data-dojo-type=\"dijit.form.Button\" id=\"btnSecAddToList\">Add to List</button></td>\r\n    </tr>\r\n    <tr>\r\n      <td height=\"5\" colspan=\"3\" align=\"left\" valign=\"middle\"></td>\r\n    </tr>\r\n    <tr>\r\n      <td height=\"2\" colspan=\"3\" align=\"left\" valign=\"middle\" style=\"background:url(images/tableHeadSepH.gif) repeat-x\"></td>\r\n    </tr>\r\n    <tr>\r\n      <td height=\"5\" colspan=\"3\" align=\"left\" valign=\"middle\"></td>\r\n    </tr>\r\n    <tr>\r\n      <td height=\"22\" align=\"left\" valign=\"middle\" class=\"boldText\">Indices</td>\r\n      <td align=\"left\" valign=\"middle\">:</td>\r\n      <td align=\"left\" valign=\"middle\"><input type=\"text\" name=\"state\" value=\"\" trim=\"true\" id=\"txtindiceslist\" propercase=\"true\" style=\"width:134px\"></td>\r\n    </tr>\r\n    <tr>\r\n      <td height=\"5\" colspan=\"3\" align=\"left\" valign=\"middle\"></td>\r\n    </tr>\r\n    <tr>\r\n      <td height=\"22\" align=\"left\" valign=\"middle\">&nbsp;</td>\r\n      <td align=\"left\" valign=\"middle\">&nbsp;</td>\r\n      <td align=\"right\" valign=\"middle\"><button data-dojo-type=\"dijit.form.Button\" id=\"btnIndeicesDraw\" >Draw</button>&nbsp;<button data-dojo-type=\"dijit.form.Button\" id=\"btnIndeicesAddToList\">Add to List</button></td>\r\n    </tr>\r\n     </table>\r\n</div>\r\n<div class=\"popupBody1\" >\r\n  <div class=\"gridBg1\">\r\n  <div id=\"listfGrid\" style=\"height: 200px\"></div>\r\n  <div id=\"indicesfGrid\" style=\"height: 170px\"></div>\r\n  </div>\r\n<div class=\"popFooter1\"><button data-dojo-type=\"dijit.form.Button\" id=\"btnCompare\">Compare</button></div>\r\n</div>\r\n</div>\r\n\r\n <div class=\"right\" style=\"float:left\">\r\n\r\n  <div class=\"functionBar2\">\r\n \r\n \r\n<div class=\"blueText inline\">\r\n<table>\r\n<tr>\r\n<td width=\"100\"></td>\r\n\t\t\t<td><label for=\"val1\" class=\"boldText\">Chart Type:</label></td>\r\n            <td><input dojoType=\"dijit.form.RadioButton\" id=\"intraday\" name=\"a\" checked=\"checked\" value=\"intraday\" type=\"radio\" /></td>\r\n            <td><label for=\"val1\"> Intra Day </label></td>  \r\n            <td><input dojoType=\"dijit.form.RadioButton\" id=\"interday\" name=\"a\" value=\"interday\" type=\"radio\" /></td>\r\n            <td><label for=\"val1\"> Inter Day </label></td>\r\n\r\n\r\n\r\n <td width=\"20\"></td>\r\n<td align=\"left\" valign=\"middle\" class=\"blueText boldText\">Line Type</td>\r\n                  <td align=\"left\" valign=\"middle\" class=\"blueText\">:</td>\r\n                  <td align=\"left\" valign=\"middle\" class=\"blueText\">\r\n                     <select name=\"ddChartTypes\" id=\"ddChartTypes\" dojoType=\"dijit.form.Select\" type=\"text\" style=\"width:80px\">\r\n                        <option value=\"Line\"> Line </option>\r\n                        <option value=\"Candlestick\"> Candlestick </option>\r\n                        <option value=\"OHLC\"> OHLC </option>\r\n                        <option value=\"Spline\"> Spline </option>\r\n                        <option value=\"Area\"> Area </option>\r\n                        <option value=\"Step\"> Step Line </option>\r\n                        <option value=\"Point\"> Point Makers </option>\r\n                     </select>\r\n                  </td>\r\n</tr>\r\n</table>\r\n<div id=\"statRefreshCursor\" style=\"height:30px; text-align:right; width:30px; padding:8px \" class=\"inline\"></div>\r\n\r\n</div>\r\n\r\n<div class=\"popupBody2\">\r\n  <div class=\"gridBg2\">\r\n  <div id=\"containers\"  style=\"height: 500px; min-width: 500px\"></div>\r\n  </div>\r\n<div class=\"popFooter2\"><button id=\"btnChartClose\" data-dojo-type=\"dijit.form.Button\" >Close</button></div>\r\n</div>\r\n</div>\r\n<div class=\"clear\"></div>\r\n\r\n</div>\t\r\n</div>\r\n"
          },
