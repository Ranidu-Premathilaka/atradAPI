            "text": "<div id=\"managerApprovalOM\" >\r\n<div class=\"functionBar\">\r\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n<tr>\r\n<td width=\"5px\"></td>\r\n<td width=\"50px\">Action</td>\r\n<td>:</td>\r\n<td>\r\n\t<select\tid=\"maSideddl\" name=\"ddlSide\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.Select\"  style=\"width:63px; float: left;\" autoComplete=\"false\">\r\n\t\t\t<option value=\"\">ALL</option>\r\n\t\t\t<option value=\"BUY\">BUY</option>\r\n\t\t\t<option value=\"SELL\">SELL</option>\r\n    </select>\r\n</td>\r\n\r\n<td width=\"5px\"></td>\r\n<td width=\"50\"><span atLangID=\"javascriptPortfolioSecurity\">Security ID</span></td>\r\n<td>:</td>\r\n<td><input\tid=\"maSecurityddl\" name=\"ddlSecurity\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:163px; float: left;\" autoComplete=\"false\"></input></td>\r\n<td width=\"5px\"></td>\r\n<td width=\"90px\">Client Account</span></td>\r\n<td>:</td>\r\n<td colspan=\"5\"><input\tid=\"maClientId\" name=\"ddlClientID\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:155px; float: left;\" autoComplete=\"false\"></input></td>\r\n<td width=\"5px\">\r\n<button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\tid=\"maCdsGoBtn\">Go</button></td>\r\n<td width=\"5px\"></td>\r\n<td width=\"50px\">Advisor</span></td>\r\n<td>:</td>\r\n<td colspan=\"5\"><input\tid=\"maAdvisor\" name=\"ddlAdvisor\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:155px; float: left;\" autoComplete=\"false\"></input>\r\n\t\t\t\t\t\t\t</td>\r\n<td width=\"5px\"></td>\r\n\r\n<td width=\"5px\"></td>\r\n<td>\r\n<button dojoType=\"dijit.form.Button\" type=\"button\" id=\"maSearchBtn\">Search</button>\r\n<button dojoType=\"dijit.form.Button\" type=\"button\" id=\"maClearBtn\">Clear</button>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td height=\"3px\"></td>\r\n</tr>\r\n\r\n<tr>\r\n<td height=\"3px\" ></td>\r\n</tr>\r\n</table>  \r\n</div>\r\n<div style=\"padding-bottom: 0