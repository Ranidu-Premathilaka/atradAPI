            "text": "<!--<div style=\"width: 350px; height: 290px\">-->\r\n<div>\r\n <div id=\"_atrad_searchOrdeBook\" class=\"\">\r\n </div>\r\n <div class=\"tabBody TableCol\">\r\n<div style=\"float:left; height:auto; margin-right:5px;\" class=\"greenWindow\">\r\n<div style=\"float:left; height:15px; padding-top:5px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n  <tr>\r\n   <td width=\"50\" align=\"left\" id= _atrad_lblTotBid>Total Bids</td>\r\n    <td width=\"10\" align=\"left\">:</td>\r\n    <td width=\"90\" align=\"left\" id=_atrad_lblTotBidval></td>\r\n  </tr>\r\n</table>\r\n</div>\r\n<div class=\"clear\"></div>\r\n<div class=\"gridBg\" id=\"_atrad_bid\">\r\n</div>\r\n</div>\r\n<div style=\"float:left; height:auto\" class=\"redWindow\">\r\n<div style=\"float:left;  height:15px; padding-top:5px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n  <tr class=\"pinkText\">\r\n    <td width=\"55\" align=\"left\" id= _atrad_lblTotAsk >Total Asks</td>\r\n    <td width=\"10\" align=\"left\">:</td>\r\n    <td width=\"90\" align=\"left\" id=_atrad_lblTotAskval ></td>\r\n    <td id=\"_atrad_orderbookRefreshCursor\" class=\"orderbookRefreshCursor\"></td>\r\n  </tr>\r\n</table>\r\n</div>\r\n<div class=\"clear\"></div>\r\n<div class=\"gridBg2\" id=\"_atrad_ask\">\r\n</div>\r\n</div>\r\n\r\n</div>  \r\n<div class=\"popFooter\">\r\n\t<button data-dojo-type=\"dijit.form.Button\" id=\"_atrad_butOdrBkAddTab\">Add Tab</button>\r\n\t<button data-dojo-type=\"dijit.form.Button\" id=\"_atrad_butOdrBkClose\">Close</button></div>\r\n</div>\r\n"
