            "text": "<div id=\"announce\">\r\n  <div class=\"functionBar blueText\">\r\n  <table>\r\n  <tr>\r\n  <td width=\"30px\">\r\n\t<span id=\"_atrad_lblFromDateId\" atLangID=\"javascriptFrom\" >From Date</span>\r\n</td>\r\n <td width=\"20px\" align=\"left\">:</td>\r\n<td width=\"100px\"  >\t\r\n\t<span><input id=\"announcementDdlFromDate\" dojoType=\"dijit.form.DateTextBox\" value=\"now\" constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\"/>\r\n\t</span>\r\n</td>\r\n\r\n<td width=\"10px\">\r\n\t<span id=\"_atrad_lblToDateId\" atLangID=\"javascriptaccountStatementDateTo\" >To Date</span>\r\n</td>\r\n <td width=\"20px\" align=\"left\"><span>:</span></td>\r\n<td width=\"100px\">\t\r\n\t <span><input id=\"announcementDdlToDate\" dojoType=\"dijit.form.DateTextBox\" value=\"now\" constraints=\"{datePattern:'MM/dd/yyyy'}\"/>\r\n\t</span>\r\n\r\n<td width=\"50px\">\r\n\t<span atLangID=\"javascriptPortfolioSecurity\">Security</span>\r\n</td>\r\n <td width=\"20px\"><span>:</span></td>\r\n<td width=\"170px\">\t\r\n\t <span><input\tid=\"announcementSecurityddl\" name=\"ddlSecurity\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:163px; float: left;\" autoComplete=\"false\"></input>\r\n\t</span>\r\n\t\r\n</td>\r\n<td>\r\n<span id=\"imgAnnouncementRefreshCursor\" class=\"mtsRefreshCursor\"></span>\r\n</td>\r\n<td>\r\n\t\t\t<button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\tid=\"announcementClearBut\">Clear</button>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\tid=\"announcementSearchBut\">Search</button>\r\n\t\t\t</td>\r\n  </tr>\r\n  </table>\r\n  \r\n  </div>\r\n<div class=\"popupBody TableCol\">\r\n<div class=\"gridBg\" id=\"grdAnnaunce\">\r\n\r\n</div>\r\n<div class=\"popFooter\">\r\n\r\n<table>\r\n<tr>\r\n<td width=\"200\"></td>\r\n<td>\r\n<div class=\"inline\">\r\n<span id=\"annnounementPreBtnContainer\" ><button\r\n\t\t\t\tdojoType=\"dijit.for