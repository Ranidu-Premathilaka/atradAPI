            "text": "<!--<div dojoType=\"dijit.form.Form\" id=\"editCustomWatchForm\" jsId=\"editCustomWatchForm\"-->\r\n<!--\t\t\t\tname=\"editCustomWatchForm\" action=\"client\" encType=\"multipart/form-data\"-->\r\n<!--\t\t\t\tmethod=\"post\">-->\r\n<!--\t\t<input type=\"hidden\" id=\"action\" name=\"action\" value=\"editCustomWatch\" />-->\r\n<!--\t\t<input type=\"hidden\" id=\"format\" name=\"format\" value=\"json\" />-->\r\n<!---->\r\n\r\n\t<div class=\"functionBar\">\r\n\t\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"blueText\">\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"90\" height=\"30\" align=\"left\" valign=\"middle\"><b></b> <span\r\n\t\t\t\tclass=\"redText\"></span>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\t\t\t\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"90\" height=\"22\" align=\"left\" valign=\"middle\"><b>Add Watch</b> <span\r\n\t\t\t\tclass=\"redText\"></span>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"100\" height=\"22\" align=\"left\" valign=\"middle\">Add a Watch<span\r\n\t\t\t\t\tclass=\"redText\"></span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"22\" colspan=\"2\"><input\r\n\t\t\t\t\ttype=\"text\" name=\"addWatchName\" id=\"addWatchName\"  dojoType=\"dijit.form.TextBox\"\r\n\t\t\t\t\ttrim=\"true\" value=\"\"  data-dojo-type=\"dijit.form.ValidationTextBox\" data-dojo-props=\"regExp:'[a-zA-Z0-9 _]+',invalidMessage:'Invalid Text.'\" />\t\t\t\t\t\t\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">  </td>\r\n\t\t\t\t<td button id=\"btnAddNewWatch\" name=\"btnAddNewWatch\"\r\n\t\t\t\t\tdata-dojo-type=\"dijit.form.Button\">Add</td>\r\n\t\t\t</tr>\r\n\t\t\t\r\n\t\t\t<tr>\r\n\t\t\t<td height=\"10\" align=\"left\" valign=\"left\"> </td>\r\n\t\t\t</tr>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t<tr class=\"dots\">\r\n\t\t\t\t<td colspan=\"6\">\r\n\t\t\t\t</td>\r\n\t\t\t\t\r\n\t\t\t</tr>\r\n\t\t\t\r\n\r\n\t\t\t<tr>\r\n\t\t\t<td height=\"10\"