          "content": {
            "size": 4039,
            "mimeType": "text/html",
            "text": "<div id=\"clientInquiry\" >\r\n\t<div class=\"functionBar\">\r\n\t\t<div style=\"float: left;\">\r\n\t\t\t<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"450px\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td id=\"clientInqrylblCdsAcc\" style=\"width:20%;\" atLangID=\"javascriptclientInquirylblCdsAcc\">CDS Acc No</td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td>\t<select id=\"clientInqryCdsAcc\" name=\"clientInqryCdsAcc\" dojoType=\"dijit.form.ComboBox\" style=\"width:240px\"></select> </td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td colspan=\"3\" height=\"5px\"></td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td id=\"clientInqrylblAdvisor\" style=\"width:20%;\" atLangID=\"javascriptClientInquiryAdvisor\">Advisor Code</td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td>\t<select id=\"clientInqryAdvisorCode\" name=\"clientInqryAdvisorCode\" dojoType=\"dijit.form.ComboBox\" ></select> </td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td colspan=\"3\" height=\"5px\"></td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td id=\"clientInqrylblCustodial\" style=\"width:20%;\" atLangID=\"javascriptClientInquiryCustodial\">Custodial</td>\r\n\t\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t\t<td>\t\r\n\t\t\t\t\t\t<select id=\"clientInqryCustodial\" name=\"clientInqryCustodial\" dojoType=\"dijit.form.Select\" style=\"width:60px\">\r\n\t\t\t\t\t\t\t<option value=\"ALL\">ALL</option>\r\n\t\t\t\t\t\t\t<option value=\"Yes\">YES</option>\r\n\t\t\t\t\t\t\t<option value=\"No\">NO</option>\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t </td>\r\n\t\t\t\t</tr>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\t\t<table>\r\n\t\t\t<tr>\r\n\t\t\t\t<td id=\"clientInqrylblName\" style=\"width:20%;\" atLangID=\"javascriptClientInquiryName\">Name</td>\r\n\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t<td>\t\r\n\t\t\t\t\t<input id=\"clientInqryClientName\" name=\"clientInqryClientName\" dojoType=\"dijit.form.TextBox\" style=\"width:240px\"/>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"3\" height=\"5px\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td id=\"clientInqrylblTel\" style=\"width:20%;\" atLangID=\"javascriptClientInquiryTel\">Tel No</td>\r\n\t\t\t\t<td width=\"5\">:</td>\r\n\t\t\t\t<td>\t\r\n\t\t\t\t\t<input id=\"clientInqryTel\" name=\"clientInqryTel\" dojoType=\"dijit.form.TextBox\" />\r\n\t\t\t\t\t<span id=\"clientInquiryRefreshCursor\"></span>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"3\" align=\"right\">\r\n\t\t\t\t\t<button dojoType=\"dijit.form.Button\"  class=\"clientInquirySearchBtn\" type=\"submit\" id=\"btnClientInquirySearch\"><span atLangID=\"javascriptSearchBtnText\">Search</span></button>\r\n\t\t\t\t\t<button dojoType=\"dijit.form.Button\"  class=\"clientInquirySearchBtn\" type=\"button\" id=\"btnClientInquiryClear\"><span atLangID=\"javascriptClearBtnText\">Clear</span></button>\r\n\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"printClientInquiry\"></div>\r\n\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"saveClientInquiry\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</div>\r\n    <div class=\"popupBody\">\r\n\t\t<div id=\"clientInquiryDatagrid\" dojoType=\"dijit.layout.ContentPane\"></div> \r\n\t</div>\r\n\t<div class=\"popFooter\">\r\n\t\t<table>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"250\">\r\n\t\t\t\t</td>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div class=\"inline\">\r\n\t\t\t\t\t\t<span id=\"clientInqryPreBtnContainer\">\r\n\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\" \tid=\"clientInqryBtnPreviousPage\" atLangID=\"javascriptMarketTimeSalePrevButLbl\">Previous</button></span>\r\n\t\t\t\t\t\t\t<span id=\"clientInqryLblNavigation\"  atLangID=\"javascriptClientInquiryNavigation\">Go to:</span><input id =\"clientInqrySpnPageNoBox\" required=\"true\"  name=\"spnPageNoBox\" dojoType=\"dijit.form.NumberSpinner\" style=\"width: 100px;\" value= '1', constraints=\"{min:1}\" /><span><span id=\"clientInqryLblOfText\"  atLangID=\"javascriptMarketTimeSaleOfText\">of</span><span id=\"clientInqryLblPageNo\" >1</span><button\r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"clientInqryBtnGo\" atLangID=\"javascriptMarketTimeSaleGoButLbl\">Go</button></span><span id=\"clientInqryNextBtnContainer\"><button\r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"clientInqryBtnNextPage\" atLangID=\"javascriptMarketTimeSaleNextButLbl\">Next</button>\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"195\">\r\n\t\t\t\t</td>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t\t\t\t\t\t id=\"butclientInquiryClose\">&nbsp;Close&nbsp;</button>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</div>\r\n</div> "
