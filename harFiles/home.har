          "content": {
            "size": 3455,
            "mimeType": "text/html",
            "text": "<div id=\"symbltradeSummary\">\r\n\t<div class=\"functionBar tradesumaryfunctionBar\">\r\n\t   \t\t<table width=\"100%\">\r\n\t\t         <tr>\r\n\t\t        \t<td colspan=\"5\" height=\"3px\"></td>\r\n\t\t        </tr>\r\n\t\t        <tr>\r\n\t\t            <td width=\"4%\"><label for=\"name\">Date</label></td>\r\n\t\t            <td width=\"12%\">: <input dojoType=\"dijit.form.DateTextBox\" name=\"name\" id=\"tradeSummaryDate\" value=\"now\" constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\"></td>\r\n\t\t            <td width=\"5%\" align=\"right\"><label for=\"name\">Board &nbsp; :</label></td>\r\n\t\t            <td width=\"19%\"><input dojoType=\"dijit.form.Select\" name=\"board\" id=\"board\" style=\"width: 80px\" autoComplete=\"false\"></td>\r\n\t\t            <td width=\"65%\">\r\n\t\t\t\t\t\t<button\r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\t\t\t\tid=\"tradeSumaryClearBut\">Clear</button>\r\n\t\t\t\t\t\t<button\r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\t\t\t\tid=\"tradeSumarySearchBut\">Search</button>\r\n\t\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"printTradeSumary\"></div>\r\n\t\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"saveTradeSumary\"></div>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</td>\r\n\t\t\t\t</tr>\r\n\t\t        <tr>\r\n\t\t        \t<td colspan=\"5\" id=\"lblCompany\">\r\n\t        \t\t\t<hr size=\"1px\"></hr>\r\n\t        \t\t\t<div id=\"reportHeader\" >\r\n\t\t\t        \t\t<table width=\"100%\">\r\n\t\t\t        \t\t\t<tr>\r\n\t\t\t        \t\t\t\t<td width=\"25%\">\r\n\t\t\t        \t\t\t\t\t<div id=\"reportHeaderframe\"></div>\r\n\t\t\t        \t\t\t\t</td>\r\n\t\t\t        \t\t\t\t<td width=\"55%\" align=\"center\" rowspan=\"2\">\r\n\t\t\t        \t\t\t\t\t<strong><font size=\"4\">Daily Symbol Trading Summary</font></strong>\r\n\t\t\t        \t\t\t\t</td>\r\n\t\t\t        \t\t\t\t<td align=\"left\" rowspan=\"2\">\r\n\t\t\t        \t\t\t\t\t<div id=\"brokerLogo\" align=\"center\">\r\n\t\t\t        \t\t\t\t\t\t<img src=\"theme/html/white/atrad/images/logoForReports.png\" width=\"100\" height=\"28\" style=\"margin-top:2px\">\r\n\t\t\t        \t\t\t\t\t</div>\r\n\t\t\t        \t\t\t\t\t<div align=\"center\">\r\n\t\t\t        \t\t\t\t\t\t<a href=\"http://www.atrad.lk\"><font style=\"color: gray;\" size=\"2\">www.atrad.lk</font></a>\r\n\t\t\t        \t\t\t\t\t</div>\r\n\t\t\t        \t\t\t\t</td>\r\n\t\t\t        \t\t\t</tr>\r\n\t\t\t        \t\t</table>\r\n\t\t        \t\t</div>\r\n\t\t        \t</td>\r\n\t\t        </tr>\r\n\t\t        <tr>\r\n\t\t        \t<td colspan=\"5\">\r\n\t\t        \t\t<table width=\"100%\" cellspacing='0'>\r\n\t\t        \t\t\t<tr>\r\n\t\t\t        \t\t\t<td width=\"4%\">\r\n\t\t\t        \t\t\t\t<label for=\"name\"><font face=\"tahoma\" size='2'>Exchange  </font></label>\r\n\t\t\t        \t\t\t\t<input type=\"hidden\" id=\"brokerId\">\r\n\t\t\t        \t\t\t</td>\r\n\t\t\t        \t\t\t<td width=\"1%\">: </td>\r\n\t\t\t        \t\t\t<td width=\"4%\" id=\"lblExchnge\" align=\"left\"><font face=\"tahoma\" size='2'></font></td>\r\n\t\t\t        \t\t\t<td width=\"4%\"></td>\r\n\t\t\t        \t\t\t<td width=\"3%\">\r\n\t\t\t        \t\t\t\t<label for=\"name\"><font face=\"tahoma\" size='2'>Date  </font></label>\r\n\t\t\t        \t\t\t</td>\r\n\t\t\t        \t\t\t<td width=\"1%\">:</td>\r\n\t\t\t        \t\t\t<td id=\"lblDate\" align=\"left\"><font face=\"tahoma\" size='2'></font></td>\r\n\t\t        \t\t\t</tr>\r\n\t\t        \t\t</table>\r\n\t\t        \t</td>\r\n\t\t        </tr>\r\n\t\t        <tr>\r\n\t\t        \t<td colspan=\"5\" height=\"3px\"></td>\r\n\t\t        </tr>\r\n\t\t    </table>\r\n\t\t<div class=\"popupBody\">\r\n\t\t\t<div class=\"gridBg\" id=\"tradeSummaryDataGrid\" style=\"width:920px;height:350px\" dojoType=\"dijit.layout.ContentPane\">      \r\n\t\t\t</div>\r\n\t\t\t<div class=\"popFooter\">\r\n\t\t\t\t<table width=\"98%\">\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<td align=\"right\">\r\n\t\t\t\t\t\t\t<button data-dojo-type=\"dijit.form.Button\" id=\"butTradesClose\">Close</button>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</table>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n"
