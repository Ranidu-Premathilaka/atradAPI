          "content": {
            "size": 4188,
            "mimeType": "text/html",
            "text": "<div id=\"marketTSHistory\" >\r\n<div class=\"functionBar blueText\">\r\n<table>\r\n<tr>\r\n<td width=\"50\"><span atLangID=\"javascriptPortfolioSecurity\">Security</span></td>\r\n<td>:</td>\r\n<td><input\tid=\"mtsHistorySecurityddl\" name=\"ddlSecurity\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:163px; float: left;\" autoComplete=\"false\"></input></td>\r\n<td width=\"40px\"></td>\r\n<td><span atLangID=\"javascriptTime\">Time</span>-</td>\r\n<td width=\"40px\" align=\"right\"><span atLangID=\"javascriptFrom\">From</span></td>\r\n<td>:</td>\r\n<td width=\"95\"><input name=\"mtsHistoryFrom\" id=\"mtsHistoryFrom\" value=\"\" dojoType=\"dijit.form.DateTextBox\"\trequired=\"true\" constraints=\"{datePattern : 'dd/MM/yyyy'}\"></td>\r\n<td></td>\r\n<td><span atLangID=\"javascriptaccountStatementDateTo\">To</span></td>\r\n<td>:</td>\r\n<td width=\"95\"><input name=\"mtsHistoryTo\" id=\"mtsHistoryTo\" value=\"\" dojoType=\"dijit.form.DateTextBox\"\trequired=\"true\" constraints=\"{datePattern : 'dd/MM/yyyy'}\"></td>\r\n</tr>\r\n</table>\r\n\r\n<table>\r\n<tr>\r\n<td width=\"50\"><span atLangID=\"javascriptBuyOrderBoard\">Board</span> </td>\r\n<td>:</td>\r\n<td><input dojoType=\"dijit.form.RadioButton\" id=\"mtsHistoryBoardAll\" name=\"a\"  checked=\"checked\" value=\"all\" type=\"radio\" />\r\n  <label for=\"val1\"> All </label></td>\r\n<td><input dojoType=\"dijit.form.RadioButton\" id=\"mtsHistoryBoardRegular\" name=\"a\"  value=\"1\" type=\"radio\" />\r\n  <label for=\"val1\"> Regular </label></td>\r\n<td><input dojoType=\"dijit.form.RadioButton\" id=\"mtsHistoryBoardCross\" name=\"a\"  value=\"4\" type=\"radio\" />\r\n  <label for=\"val1\"> Crossing</label></td>\r\n<td><input dojoType=\"dijit.form.RadioButton\" id=\"mtsHistoryBoardAuction\" name=\"a\"  value=\"7\" type=\"radio\" />\r\n  <label for=\"val1\"> Auction</label></td>\r\n <td width=\"90\"></td>\r\n  <td ><span >Asset</span> </td>\r\n<td>:</td>\r\n  <td><select id=\"mtsHistorycmbAssert\" name=\"mtsHistorycmbAssert\" dojoType=\"dijit.form.Select\" autoComplete=\"false\" type=\"text\" style=\"width:60px; \">\r\n          \t\t<option value=\"EQUITY\">EQUITY</option>\r\n          \t\t<option value=\"DEBT\">DEBT</option>\r\n          \t</select></td>\r\n</tr>\r\n</table>\r\n\r\n<table>\r\n<tr>\r\n<td><span id=\"lblLstRefTime\"  atLangID=\"javascriptMarketTimeSaleRefreshTime\" class=\"fontBold\">Last Refresh Time : </span></td>\r\n\t\t\t<td width=\"41%\">\r\n\t\t\t<span\r\n\t\t\tid=\"lblLstRefreshTime\"></span>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<span id=\"imgmtsHistoryRefreshCursor\" class=\"mtsHistoryRefreshCursor\"></span>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\tid=\"mtsHistorySearchBut\">Search</button>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<button dojoType=\"dijit.form.Button\"  id=\"btnmtsHistoryClear\" ><span atLangID=\"javascriptClearBtnText\">Clear</span></button>\r\n\t\t\t\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\tid=\"mtsHistorybutRefreshBut\">Refresh</button>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<div dojoType=\"dijit.form.Button\" id=\"saveMTSH\"></div>\r\n\t\t\t</td>\r\n</tr>\r\n</table>\r\n\r\n\r\n  \r\n</div>\r\n<div style=\"padding-bottom: 0px\"></div>\r\n<div class=\"popupBody TableCol\">\r\n<div id=\"grdmtsHistoryData\" dojoType=\"dijit.layout.ContentPane\"\r\n\tclass=\"mtsHistoryGridContainer\">\r\n\t</div>\r\n</div>\r\n<div class=\"popFooter\">\r\n<div class=\"inline\" style=\"padding-left: 25%;\"><span id=\"preBtnContainerMTSH\" ><button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"btnPreviousPageButMTSH\" atLangID=\"javascriptMarketTimeSalePrevButLbl\">Previous</button></span>\r\n\t\t\t\t<span id=\"lblNavigationMTSH\"  atLangID=\"javascriptMarketTimeSaleNavigation\">Go to:</span><input id =\"spnPageNoBoxMTSH\" required=\"true\"  name=\"spnPageNoBox\" dojoType=\"dijit.form.NumberSpinner\" style=\"width: 100px;\" value= '1', constraints=\"{min:1}\" /><span><span id=\"lblOfTextMTSH\"  atLangID=\"javascriptMarketTimeSaleOfText\">of</span><span id=\"lblPageNoMTSH\" >1</span><button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"btnGoButMTSH\" atLangID=\"javascriptMarketTimeSaleGoButLbl\">Go</button></span><span id=\"nextBtnContainerMTSH\"><button\r\n\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \tid=\"btnNextPageButMTSH\" atLangID=\"javascriptMarketTimeSaleNextButLbl\">Next</button></span></div>\r\n\r\n<div >\r\n<button dojoType=\"dijit.form.Button\" type=\"button\"\r\n\t\t id=\"butmtsHistoryClose\">&nbsp;Close&nbsp;</button></div>\r\n</div>\r\n</div>"
