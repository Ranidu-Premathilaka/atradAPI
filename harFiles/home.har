            "mimeType": "text/html",
            "text": "<div class=\"taxSettings\" id=\"_atrad_taxSettings\">\r\n\t<div id=\"_atrad_taxSetFunctionBar\" class=\"functionBar\">\r\n\t\t<table width=\"320\">\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"160\" height=\"22\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptTaxSetBrokerageFee\">Brokerage Fees</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"15\" colspan=\"2\"><input name=\"spnBrokerFee\" id=\"_atrad_spnBrokerFee\"  dojoType=\"dijit.form.NumberSpinner\" \r\n\t\t\t\t\tclass=\"BS_ISO\" value= '0', constraints=\"{min:0.00}\"/><span>%</span></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"4\" height=\"1px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"160\" height=\"15\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptTaxSetCseFee\">CSE Fees</span></td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"15\" colspan=\"2\"><input name=\"spncseFee\" id=\"_atrad_spncseFee\"  dojoType=\"dijit.form.NumberSpinner\" \r\n\t    \t  \tclass=\"BS_ISO\"  value= '0', constraints=\"{min:0.00}\"/><span>%</span></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"4\" height=\"1px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"160\" height=\"22\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptTaxSetCdsFee\">CDS Fees</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"15\" colspan=\"2\"><input name=\"spnCdsFees\" id=\"_atrad_spnCdsFees\"  dojoType=\"dijit.form.NumberSpinner\" \r\n\t\t\t\t\tclass=\"BS_ISO\" value= '0', constraints=\"{min:0.00}\"/><span>%</span></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"4\" height=\"1px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"160\" height=\"15\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptTaxSetSecFee\">SEC Fees</span></td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"15\" colspan=\"2\"><input name=\"spnSecFee\" id=\"_atrad_spnSecFee\"  dojoType=\"dijit.form.NumberSpinner\" \r\n\t    \t  \tclass=\"BS_ISO\"  value= '0', constraints=\"{min:0.00}\"/><span>%</span></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"4\" height=\"1px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"160\" height=\"22\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptTaxSetShareTrnLevy\">Share Transaction Levy</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"15\" colspan=\"2\"><input name=\"spnShareTrnLevy\" id=\"_atrad_spnShareTrnLevy\"  dojoType=\"dijit.form.NumberSpinner\" \r\n\t\t\t\t\trequired='true' class=\"BS_ISO\" value= '0', constraints=\"{min:0.00}\"/><span>%</span></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"4\" height=\"1px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"160\" height=\"15\" align=\"left\" valign=\"middle\"><span atLangID=\"javascriptTaxSetTotal\">Total</span></td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\">:</td>\r\n\t\t\t\t<td height=\"15\" colspan=\"2\"><input type=\"text\" readonly=\"readonly\" name=\"txtTotal\" id=\"_atrad_txtTotal\"  dojoType=\"dijit.form.TextBox\" \r\n\t    \t  \tclass=\"BS_ISO\" /><span>%</span></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"4\" height=\"2px\" align=\"left\" valign=\"middle\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"4\">\r\n\t\t\t\t\t<div id=\"_atrad_taxSetPopFooter\" class=\"popFooter\">\r\n\t\t\t\t\t\t<button id=\"_atrad_btnTaxSetOk\" name=\"btnTaxSetOk\" data-dojo-type=\"dijit.form.Button\" atLangID=\"javascriptTaxSetOk\" >Ok</button>\r\n\t\t\t\t\t\t<button id=\"_atrad_btnTaxSetCancel\" data-dojo-type=\"dijit.form.Button\" atLangID=\"javascriptTaxSetCancel\" >Cancel</button>\r\n\t\t\t\t\t\t<button id=\"_atrad_btnTaxSetReset\" data-dojo-type=\"dijit.form.Button\" atLangID=\"javascriptTaxSetReset\" >Reset</button>\r\n\t\t\t\t\t</div>\t\t\r\n\t\t\t\t</td>\r\n\t        </tr>\r\n\t\t\t\r\n\t\t</table>\r\n\t</div>\r\n</div>"
