            "mimeType": "text/html",
            "text": "<div id=\"ohlc\">\r\n\t<div class=\"functionBar blueText\">\r\n  \t<table>\r\n  \t<tr>\r\n  \t\t<td width=\"25px\">\r\n\t\t\t<span id=\"_atrad_lblFromDateId\" atLangID=\"javascriptFrom\" >From Date</span>\r\n\t\t</td>\r\n \t\t<td width=\"5px\" align=\"left\">:</td>\r\n\t\t<td width=\"85px\"  >\t\r\n\t\t\t<span>\r\n\t\t\t<input id=\"ohlcDdlFromDate\" dojoType=\"dijit.form.DateTextBox\" style=\"width:75px;\" value=\"now\" constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\"/>\r\n\t\t\t</span>\r\n\t\t</td>\r\n\t\t<td width=\"10px\">\r\n\t\t\t<span id=\"_atrad_lblToDateId\" atLangID=\"javascriptaccountStatementDateTo\" >To Date</span>\r\n\t\t</td>\r\n \t\t<td width=\"5px\" align=\"left\"><span>:</span></td>\r\n\t\t<td width=\"85px\">\t\r\n\t \t\t<span>\r\n\t \t\t<input id=\"ohlcDdlToDate\" dojoType=\"dijit.form.DateTextBox\" style=\"width:75px;\" value=\"now\" constraints=\"{datePattern:'MM/dd/yyyy'}\"/>\r\n\t\t\t</span>\r\n\t\t<td width=\"40px\">\r\n\t\t\t<span atLangID=\"javascriptPortfolioSecurity\">Security</span>\r\n\t\t</td>\r\n \t\t<td width=\"5px\">\r\n \t\t\t<span>:</span>\r\n \t\t</td>\r\n\t\t<td width=\"100px\">\t\r\n\t \t\t<span>\r\n\t \t\t<input\tid=\"ohlcSecurityddl\" name=\"ddlSecurity\" \r\n\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  style=\"width:103px; float: left;\" autoComplete=\"false\"></input>\r\n\t\t\t</span>\t\r\n\t\t</td>\r\n\t\t<td width=\"20px\">\r\n\t\t\t<span >Asset</span>\r\n\t\t</td>\r\n \t\t<td width=\"5px\">\r\n \t\t\t<span>:</span>\r\n \t\t</td>\r\n\t\t<td width=\"60px\">\t\r\n\t\t \t<select id=\"ohlcAsset\" name=\"ohlcAsset\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" style=\"width:55px; \" >\r\n\t     \t\t<option value=\"1\">Equity</option>\r\n\t         \t<option value=\"2\">Bill</option>\r\n\t        \t<option value=\"3\">Bond</option>    \t\t\r\n\t       \t</select>\t\r\n\t\t</td>\r\n\t\t<td>\r\n\t\t\t<span id=\"imgAnnouncementRefreshCursor\" class=\"mtsRefreshCursor\"></span>\r\n\t\t</td>\r\n\t\t<td>\r\n\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\" id=\"ohlcClearBut\">Clear</button>\r\n\t\t</td>\r\n\t\t<td>\r\n\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\" id=\"ohlcSearchBut\">Search</button>\r\n\t\t</td>\r\n\t\t<!--  \r\n\t\t<td align=\"right\" width=\"60\">\r\n\t\t\t<div dojoType=\"dijit.form.Button\" id=\"printOHLC\"></div>\r\n\t\t\t<div dojoType=\"dijit.form.Button\" id=\"saveOHLC\"></div>\t\t\t\r\n\t\t</td>\r\n\t\t-->\r\n\t\t<td align=\"right\">\r\n\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\" id=\"printOHLC\"></button>\r\n\t\t</td>\r\n\t\t<td align=\"right\">\r\n\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\" id=\"saveOHLC\"></button>\r\n\t\t</td>\r\n  \t</tr>  \r\n  \t<tr height=\"5px\">\r\n  \t\t<td width=\"25px\">\r\n\t\t\t<span >Board</span>\r\n\t\t</td>\r\n \t\t<td width=\"5px\">\r\n \t\t\t<span>:</span>\r\n \t\t</td>\r\n\t\t<td width=\"85px\">\t\r\n\t\t \t<select id=\"ohlcBoard\" name=\"ohlcBoard\" dojoType=\"dijit.form.ComboBox\" autoComplete=\"false\" style=\"width:75px; \" >\r\n\t     \t\t<option value=\"ALL\">All</option>\r\n\t         \t<option value=\"REGULAR\">Regular</option>\r\n\t        \t<option value=\"CROSSING\">Crossing</option>    \t\t\r\n\t       \t</select>\t\r\n\t\t</td>\r\n\t\t<td colspan=\"14\"></td>\r\n\t</tr>\r\n\t</table>\r\n\t</div>\r\n\t<div class=\"popupBody\">\r\n\t\t<div class=\"gridBg\" id=\"grdOHLC\">\r\n\t\t</div>\r\n\t\t<div class=\"popFooter\">\r\n\r\n\t\t<table>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"120\"></td>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div class=\"inline\">\r\n\t\t\t\t\t\t<span id=\"ohlcPreBtnContainer\" >\r\n\t\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\" \tid=\"ohlcBtnPreviousPageBut\" atLangID=\"javascriptMarketTimeSalePrevButLbl\">Previous</button>\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t\t<span id=\"lblNavigation\"  atLangID=\"javascriptMarketTimeSaleNavigation\">Go to:</span>\r\n\t\t\t\t\t\t<input id =\"ohlcSpnPageNoBox\" required=\"true\"  name=\"spnPageNoBox\" dojoType=\"dijit.form.NumberSpinner\" style=\"width: 100px;\" value= '1', constraints=\"{min:1}\" /><span><span id=\"lblOfText\"  atLangID=\"javascriptMarketTimeSaleOfText\">of</span><span id=\"ohlcLblPageNo\" >1</span>\r\n\t\t\t\t\t\t<button dojoType=\"dijit.form.Button\" type=\"button\" \tid=\"ohlcBtnGoBut\" atLangID=\"javascriptMarketTimeSaleGoButLbl\">Go</button></span>\r\n\t\t\t\t\t\t<span id=\"ohlcNextBtnContainer\"><button dojoType=\"dijit.form.Button\" type=\"button\" \tid=\"ohlcBtnNextPageBut\" atLangID=\"javascriptMarketTimeSaleNextButLbl\">Next</button></span>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"50\"></td>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<button data-dojo-type=\"dijit.form.Button\" id=\"butOHLCClose\">Close</button>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</div>\r\n</div>\t\r\n\r\n"
