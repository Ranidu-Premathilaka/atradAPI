            "text": "<div id=\"myTradeFilled\">\r\n  <div class=\"functionBar\">\r\n    <table width='930px' border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n\t    <tr>\r\n\t    \t<td width=\"50px\" align=\"left\" id=\"myTradeFilledLblAsset\" atLangID=\"javascriptBuyOrderAssert\"></td>\r\n\t    \t<td width=\"5px\">:</td>\r\n\t    \t<td width=\"75px\" align=\"left\">\r\n\t    \t\t<select id =\"myTradeFilledCmbAssetSelect\" name=\"assetSelect\"  dojoType=\"dijit.form.Select\"  style=\"width:70px !important;\" class=\"BS_ISO\">\r\n\t\t        \t<option value=\"CS\">Equity</option>\r\n\t\t         \t<option value=\"BILL\">Bill</option>\r\n\t\t        \t<option value=\"BOND\">Bond</option> \r\n\t\t      \t</select>\r\n\t\t    </td>\r\n\t\t    <td width=\"15px\"></td>\r\n\t\t    <td width=\"75px\" align=\"left\" id=\"myTradeFilledLblClient\" atLangID=\"javascriptClient\"></td>\r\n      \t\t<td width=\"5px\">:</td>\r\n\t    \t<td width=\"90px\"  align=\"left\"> \r\n\t\t      <select\tid=\"myTradeFilledTxtClient\" name=\"txtClient\" \r\n\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  trim=\"true\" class=\"BS_ISO\" uppercase=\"true\" autoComplete=\"false\" style=\"width:140px !important;\"></select>\r\n\t\t    \r\n\t\t\t</td>\r\n\t\t    <td width=\"15px\"></td>\r\n\t\t    <td width=\"60px\" align=\"left\" id=\"myTradeFilledLblSecurity\" atLangID=\"javascriptSecurity\"></td>\r\n      \t\t<td width=\"5px\">:</td>\r\n\t    \t<td width=\"80px\"  align=\"left\"> \r\n\t\t      <input\tid=\"myTradeFilledTxtSecurity\" name=\"txtSecurity\" \r\n\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  trim=\"true\"  class=\"BS_ISO\" uppercase=\"true\" autoComplete=\"false\" style=\"width:140px !important;\"></input>\r\n\t\t    \r\n\t\t\t</td>\r\n\t\t    <td width=\"15px\"></td>\r\n\t\t\t<td width=\"75px\" align=\"left\" id=\"myTradeFilledLblAction\" atLangID=\"javascriptOrdTrackrSide\"></td>\r\n\t    \t<td width=\"5px\">:</td>\r\n\t    \t<td align=\"left\">\r\n\t\t\t\t<select id =\"myTradeFilledCmbActionSelect\" name=\"actionSelect\"  dojoType=\"dijit.form.Select\" type=\"text\" style=\"width:70px !important;\" class=\"BS_ISO\">\r\n\t        \t\t<option value=\"BUY\">BUY</option>\r\n\t        \t\t<option value=\"SELL\">SELL</option>\r\n\t        \t\t<option value=\"SELLSHORT\">SELL SHORT</option>\r\n\t        \t\t<option value=\"ALL\">ALL</option>        \r\n\t      \t\t</select>\r\n\t      \t</td>\r\n\t    </tr>\r\n\t    <tr>\r\n\t    \t<td colspan=\"15\"></td>\r\n\t    </tr>\r\n\t    <tr>\r\n\t      \t<td width=\"50px\" align=\"left\" id=\"myTradeFilledLblTif\" atLangID=\"javascriptTIF\"></td>\r\n\t    \t<td width=\"5px\">:</td>\r\n\t    \t<td align=\"left\">\r\n\t\t\t\t<select id =\"myTradeFilledCmbTif\" name=\"cmbTif\"  dojoType=\"dijit.form.Select\" type=\"text\" style=\"width:70px !important;\" class=\"BS_ISO\">\r\n\t        \t\t<option value=\"ALL\">ALL</option>\r\n\t        \t\t<option value=\"DAY\">DAY</option>\r\n\t        \t\t<option value=\"GTD\">GTD</option> \r\n\t        \t\t<option value=\"GTC\">GTC</option>        \r\n\t      \t\t</select>\r\n\t      \t</td>\r\n\t    \t<td width=\"15px\"></td>\r\n\t\t    <td width=\"75px\" align=\"left\" id=\"myTradeFilledLblClientOrdId\" atLangID=\"javascriptClientOrderId\"></td>\r\n\t    \t<td width=\"5px\">:</td>\r\n\t    \t<td width=\"90px\" align=\"left\">\r\n\t    \t\t<input id=\"myTradeFilledTxtClientOrdId\" name=\"myTradeFilledTxtClientOrdId\" dojoType=\"dijit.form.TextBox\" />\r\n\t\t    </td>\r\n\t\t    <td width=\"15px\"></td>\r\n\t\t    <td width=\"60px\" align=\"left\" id=\"myTradeFilledLblPlacedby\" atLangID=\"javascriptOrderPlacedBy\"></td>\r\n      \t\t<td width=\"5px\">:</td>\r\n\t    \t<td width=\"80px\"  align=\"left\"> \r\n\t\t      <select id =\"myTradeFilledPlacdby\" name=\"cmbPlacedby\"  dojoType=\"dijit.form.Select\" type=\"text\" style=\"width:70px !important;\" class=\"BS_ISO\">\r\n\t        \t\t<option value=\"ALL\">ALL</option>\r\n\t        \t\t<option value=\"ADVISOR\">ADVISOR</option> \r\n\t        \t\t<option value=\"CLIENT\">CLIENT</option>        \r\n\t      \t\t</select>\r\n\t\t\t</td>\r\n\t\t    <td width=\"15px\"></td>\r\n\t\t\t<td width=\"75px\" align=\"left\" id=\"myTradeFilledLblContraBroker\" atLangID=\"javascriptContraBroker\"></td>\r\n\t    \t<td width=\"5px\">:</td>\r\n\t    \t<td width=\"60px\" align=\"left\">\r\n\t\t\t\t<input id=\"myTradeFilledTxtContraBroker\" name=\"myTradeFilledTxtContraBroker\" dojoType=\"dijit.form.TextBox\" />\r\n\t      \t</td>\r\n\t    </tr>\r\n\t    <tr>\r\n\t    \t<td colspan=\"12\"></td>\r\n\t    \t<td colspan=\"3\">\r\n\t    \t\t<button dojoType=\"dijit.form.Button\"  class=\"myTradeFilledSearchBtn\" type=\"submit\" id=\"btnMyTradeFilledSearch\"><span atLangID=\"javascriptOrdTrackerSearch\">Search</span></button>\r\n\t\t\t\t<button dojoType=\"dijit.form.Button\"  class=\"myTradeFilledSearchBtn\" type=\"button\"  id=\"btnMyTradeFilledClear\"><span atLangID=\"javascriptClearBtnText\">Clear</span></button>\r\n\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"printMyTradeFilled\"></div>\r\n\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"saveMyTradeFilled\"></div>\r\n\t\t\t\t<span id=\"wait_cursor\" class=\"refreshCursor\"></span>\r\n\t\t\t</td>\r\n\t    </tr>\r\n\t</table>\r\n </div>\r\n <div class=\"popupBody\">\r\n\t<div id=\"myTradeFilledDataGrid\" dojoType=\"dijit.layout.ContentPane\"\t/>\r\n </div>\r\n <div class=\"popFooter\">\r\n \t<table width=\"99%\"  border='1'>\r\n \t\t<tr>\r\n \t\t\t<td>\r\n \t\t\t\t<table width=\"100%\" border='0'>\r\n\t\t\t\t\t<tr  height=\"10px\" >\r\n\t\t\t\t\t\t<td colspan=\"17\"></td>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<td width=\"70px\"align=\"center\">\r\n\t\t\t\t\t\t\t<span>Trade</span>  \r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"80px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span> Total</span> \r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"120px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Total</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"80px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Total</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"120px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Total</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"80px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Total</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"100px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Total</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td  align=\"center\">\r\n\t\t\t\t\t\t\t<span>Total</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"70px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Avg Price</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<td width=\"70px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Count</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"80px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Buy Qty</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"120px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Buy Turnover</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"80px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Sell Qty</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"120px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Sell Turnover</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"80px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Remaining Qty</span>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td width=\"5px\"></td>\r\n\t\t\t\t\t\t<td width=\"100px\" align=\"center\">\r\n\t\t\t\t\t\t\t<span>Gross Qty</span>