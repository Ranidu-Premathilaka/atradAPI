 align=\"left\">\t\r\n\t\t\t\t\t <span><select id=\"ordTrackrDdlSide\" dojoType=\"dijit.form.Select\" name=\"ordTrackrDdlSide\" style=\"width:100px;\">\r\n\t\t\t\t\t<option value=\"all\">ALL</option>\r\n\t\t\t\t\t<option value=\"BUY\">BUY</option>\r\n\t\t\t\t\t<option value=\"SELL\">SELL</option>\r\n\t\t\t\t\t<option value=\"SELLSHORT\">SELL SHORT</option>\r\n\t\t\t\t\t</select>\r\n\t\t\t\t\t</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td  align=\"left\">\r\n\t\t\t\t\t<span id=\"ordTrackrLblFromDateId\" atLangID=\"javascriptFromDate\">From Date</span><span class=\"textColon\">:</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td >:</td>\r\n\t\t\t\t<td  align=\"left\"> \t\r\n\t\t\t\t\t<span>\r\n\t\t\t\t\t<input id=\"ordTrackrTxtFromDate\" dojoType=\"dijit.form.DateTextBox\" value=\"now\" constraints=\"{datePattern:'MM/dd/yyyy'}\"/>\r\n\t\t\t\t\t</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td align=\"left\">\r\n\t\t\t\t\t<span id=\"ordTrackrLblToDateId\" atLangID=\"javascriptToDate\">To Date</span><span class=\"textColon\">:</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td >:</td>\r\n\t\t\t\t<td align=\"left\">\t\r\n\t\t\t\t\t<span><input id=\"ordTrackrTxtToDate\" dojoType=\"dijit.form.DateTextBox\" value=\"now\" constraints=\"{datePattern:'MM/dd/yyyy'}\"/></span>\r\n\t\t\t\t</td>\r\n\t\t\t\t\r\n\t\t\t\t</tr>\t\t\t\t\r\n\t\t\t<tr height=\"5px\">\r\n\t\t\t\t<td colspan=\"7\"></td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td  align=\"left\">\r\n\t\t\t\t\t<span id=\"ordTrackrLblExchangeOrdId\" atLangID=\"javascriptOrdTrackrExchangeOrdID\" >ExchangeOrdID</span><span class=\"textColon\">:</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td >:</td>\r\n\t\t\t\t<td  align=\"left\">\t\r\n\t\t\t\t\t<span><input id=\"ordTrackrTxtExchangeOrdID\" name=\"ordTrackrTxtExchangeOrdID\" dojoType=\"dijit.form.TextBox\" />\r\n\t\t\t\t\t</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td align=\"left\">\r\n\t\t\t\t\t<span id=\"ordTrackrLblStatus\" atLangID=\"javascriptOrdTrackerStatus\" >Status</span><span class=\"textColon\">:</span>\r\n\t\t\t\t\t<spa