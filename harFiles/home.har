          "content": {
            "size": 2525,
            "mimeType": "text/html",
            "text": "<div id=\"managerStatus\">\r\n\t<div class=\"functionBar\">\r\n    \t<table width='600px' border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n    \t\t<tr>\r\n   \t\t\t\t<td width=\"70px\" align=\"left\" id=\"managerStatusLblSide\" atLangID=\"javascriptSide\"></td>\r\n\t\t    \t<td width=\"5px\">:</td>\r\n\t\t    \t<td width=\"85px\" align=\"left\">\r\n\t\t    \t\t<select id =\"managerStatusCmbSide\" name=\"cmbSide\"  dojoType=\"dijit.form.Select\"  style=\"width:70px !important;\" class=\"BS_ISO\">\r\n\t\t\t        \t<option value=\"ALL\">ALL</option>\r\n\t\t\t        \t<option value=\"BUY\">BUY</option>\r\n\t\t\t        \t<option value=\"SELL\">SELL</option> \r\n\t\t\t      \t</select>\r\n\t\t\t    </td>\r\n\t\t\t    <td width=\"15px\"></td>\r\n\t\t    \t<td width=\"30px\">\r\n\t\t\t\t\t<span id=\"managerStatuslblFromDate\" atLangID=\"javascriptFrom\" >From Date</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t <td width=\"5px\" align=\"left\">:</td>\r\n\t\t\t\t<td width=\"85px\">\t\r\n\t\t\t\t\t<span><input id=\"managerStatusDdlFromDate\" dojoType=\"dijit.form.DateTextBox\" style=\"width:75px;\" value=\"now\" constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\"/>\r\n\t\t\t\t\t</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td width=\"10\" align=\"left\" valign=\"middle\"><span id=\"manStatusRefreshCursor\"></span></td>\r\n    \t\t</tr>\r\n    \t\t<tr>\r\n   \t\t\t\t<td width=\"70px\" align=\"left\" id=\"managerStatusLblClientAcc\" atLangID=\"javascriptClient\"></td>\r\n\t\t    \t<td width=\"5px\">:</td>\r\n\t\t    \t<td width=\"85px\" align=\"left\">\r\n\t\t    \t\t<select\tid=\"managerStatusCmbClientAcc\" name=\"cmbClientAcc\" \r\n\t\t\t\t\t\t\t\t\tdojoType=\"dijit.form.ComboBox\"  trim=\"true\" class=\"BS_ISO\" uppercase=\"true\" autoComplete=\"false\" style=\"width:140px !important;\"></select>\r\n\t\t\t    </td>\r\n\t\t\t    <td width=\"15px\"></td>\r\n\t\t    \t<td width=\"30px\">\r\n\t\t\t\t\t<span id=\"managerStatuslblToDate\" atLangID=\"javascriptDateTo\" >To Date</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t <td width=\"5px\" align=\"left\">:</td>\r\n\t\t\t\t<td width=\"85px\"  >\t\r\n\t\t\t\t\t<span><input id=\"managerStatusDdlToDate\" dojoType=\"dijit.form.DateTextBox\" style=\"width:75px;\" value=\"now\" constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\"/>\r\n\t\t\t\t\t</span>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td >\r\n\t\t\t\t\t<button type =\"button\" data-dojo-type=\"dijit.form.Button\" id=\"managerStatusSearch\" >Search</button>\r\n\t\t\t\t</td>\r\n    \t\t</tr>\r\n\t\t</table>\r\n\t\t\r\n\t</div>\r\n\t<div class=\"popupBody\">\r\n\t\t<div id = \"managerStatusDataGrid\" dojoType = \"dijit.layout.ContentPane\"></div>\r\n\t</div>\r\n\t<div class=\"popFooter\">\r\n\t\t<table>\r\n\t\t\t<tr>\r\n\t\t\t\t<td width=\"540\"></td>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<button type =\"button\" data-dojo-type=\"dijit.form.Button\" id=\"butCloseManStatus\" >Close</button>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</div>\r\n</div>"
