            "text": "<div id=\"mrktIndexSummary\">\r\n\t<div class=\"functionBar mrktIndexSummaryfunctionBar\">\r\n   \t\t<table width=\"100%\">\r\n\t        <tr>\r\n\t            <td width=\"4%\"><label for=\"name\">Date</label></td>\r\n\t            <td width=\"16%\">: <input dojoType=\"dijit.form.DateTextBox\" name=\"name\" id=\"mrktIndexSummaryDate\" value=\"now\" constraints=\"{selector : 'date',datePattern:'MM/dd/yyyy'}\"></td>\r\n\t            <td width=\"80%\">\r\n\t\t\t\t\t<button\r\n\t\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\t\t\tid=\"mrktIndexSumaryClearBut\">Clear</button>\r\n\t\t\t\t\t<button\r\n\t\t\t\t\tdojoType=\"dijit.form.Button\" type=\"button\" \r\n\t\t\t\t\tid=\"mrktIndexSumarySearchBut\">Search</button>\r\n\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"printMrktIndexSumary\"></div>\r\n\t\t\t\t\t<div dojoType=\"dijit.form.Button\" id=\"saveMrktIndexSumary\"></div>\r\n\t\t\t\t\t\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t        <tr>\r\n\t        \t<td colspan=\"3\" id=\"indexSummaryLblCompany\">\r\n        \t\t\t<hr size=\"1px\"></hr>\r\n        \t\t\t<div id=\"indexSummaryReportHeader\" >\r\n\t\t        \t\t<table width=\"100%\" cellspacing='0'>\r\n\t\t        \t\t\t<tr>\r\n\t\t        \t\t\t\t<td width=\"25%\">\r\n\t\t        \t\t\t\t\t<div id=\"indexSummaryReportHeaderframe\"></div>\r\n\t\t        \t\t\t\t</td>\r\n\t\t        \t\t\t\t<td width=\"55%\" align=\"center\" rowspan=\"2\">\r\n\t\t        \t\t\t\t\t<strong><font size=\"4\">Market Index Summary</font></strong>\r\n\t\t        \t\t\t\t</td>\r\n\t\t        \t\t\t\t<td align=\"right\">\r\n\t\t        \t\t\t\t\t<div id=\"indexSummaryBrokerLogo\" align=\"center\">\r\n\t\t        \t\t\t\t\t\t<img src=\"theme/html/white/atrad/images/logoForReports.png\" width=\"100\" height=\"28\" style=\"margin-top:2px\">\r\n\t\t        \t\t\t\t\t</div>\r\n\t\t        \t\t\t\t\t<div align=\"center\">\r\n\t\t        \t\t\t\t\t\t<a href=\"http://www.atrad.lk\"><font style=\"color: gray